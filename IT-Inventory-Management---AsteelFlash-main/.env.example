# SQL Server (required)
# Must be at least 8 chars, include upper/lower, digit, and symbol for SQL Server policy.
SA_PASSWORD=Your_strong_Passw0rd!

# SMTP (optional; app still runs, email sending may fail if invalid)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_ADMIN_EMAIL=admin@yourcompany.com

# Database seeding (recommended for first container run)
SEED_ENABLED=true
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@asteelflash.com
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_FULLNAME=Admin User
SEED_ADMIN_PHONE=+0000000000
SEED_ADMIN_SERVICE=IT
