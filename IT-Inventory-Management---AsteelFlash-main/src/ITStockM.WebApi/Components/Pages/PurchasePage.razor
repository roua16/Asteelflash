@page "/purchase-page"
@using ITStockM.Domain.Entities
@using ITStockM.Services.Employees
@using ITStockM.Services.Requests
@using ITStockM.Services.Projects
@using ITStockM.Services.Offers
@using ITStockM.Services.Suppliers
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Purchasing")]
@inject IRequestService RequestService
@inject IEmployeeService EmployeeService
@inject IProjectService ProjectService
@inject IOfferService OfferService
@inject ISupplierService SupplierService
@inject NotificationService NotificationService
@inject IJSRuntime JS

<PageTitle>Purchase Requests - IT Stock Management</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div class="flex-between page-header-wrap">
            <div>
                <h1>Purchase Requests</h1>
                <p class="page-subtitle">Create, review, and progress procurement requests across teams.</p>
            </div>
        </div>
    </div>

    <div class="purchase-tabs">
        <button type="button"
                class="purchase-tab @(purchaseTab == "new" ? "purchase-tab-active" : "")"
                @onclick="@(() => purchaseTab = "new")">
            <RadzenIcon Icon="add_circle" /> New Request
        </button>
        <button type="button"
                class="purchase-tab @(purchaseTab == "list" ? "purchase-tab-active" : "")"
                @onclick="@(() => purchaseTab = "list")">
            <RadzenIcon Icon="list_alt" /> View &amp; Accept Requests
        </button>
    </div>

    @if (purchaseTab == "new")
    {
        <div class="content-section">
            <h2 class="section-title">New Purchase Request</h2>

            @if (!string.IsNullOrWhiteSpace(editorError))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger"
                             Variant="Variant.Flat"
                             Shade="Shade.Lighter"
                             Text="@editorError" />
            }

            @if (newRequestSuccess)
            {
                <RadzenAlert AlertStyle="AlertStyle.Success"
                             Variant="Variant.Flat"
                             Shade="Shade.Lighter"
                             Text="Request submitted successfully!" />
            }

            <EditForm Model="@editorModel" OnValidSubmit="@SaveRequestAsync" class="modal-form">
                <DataAnnotationsValidator />

                <div class="form-grid-2">
                    <div class="form-group">
                        <label for="req-title">Title</label>
                        <InputText id="req-title" @bind-Value="editorModel.Title" />
                    </div>

                    <div class="form-group">
                        <label for="req-project">Project</label>
                        <select id="req-project" class="filter-select" @bind="editorModel.ProjectName">
                            <option value="">— Select project —</option>
                            @foreach (var p in projects)
                            {
                                <option value="@p.ProjectName">@p.ProjectName</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="req-type">Material Type</label>
                        <select id="req-type" class="filter-select" @bind="editorModel.MaterialType">
                            <option value="">— Select type —</option>
                            <option value="Laptop">Laptop</option>
                            <option value="Desktop">Desktop</option>
                            <option value="Server">Server</option>
                            <option value="Switch">Switch</option>
                            <option value="Router">Router</option>
                            <option value="Firewall">Firewall</option>
                            <option value="Printer">Printer</option>
                            <option value="Monitor">Monitor</option>
                            <option value="Phone">Phone</option>
                            <option value="Tablet">Tablet</option>
                            <option value="Projector">Projector</option>
                            <option value="UPS">UPS</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="req-employee">Employee</label>
                        <select id="req-employee" class="filter-select" @bind="editorModel.EmployeeId">
                            @foreach (var employee in employees)
                            {
                                <option value="@employee.Id">@employee.FullName (@employee.Service)</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="req-date">Request Date</label>
                        <InputDate id="req-date" @bind-Value="editorModel.Date" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="req-description">Description</label>
                    <InputTextArea id="req-description" @bind-Value="editorModel.Description" />
                </div>

                <div class="form-actions">
                    <RadzenButton Icon="send"
                                  Text="Submit Request"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Shade="Shade.Lighter"
                                  ButtonType="ButtonType.Submit" />
                </div>
            </EditForm>
        </div>
    }

    @if (purchaseTab == "list")
    {
        <div class="grid-3">
            <div class="content-section metric-card">
                <span class="metric-label">Visible Requests</span>
                <span class="metric-value">@filteredRequests.Count</span>
            </div>
            <div class="content-section metric-card">
                <span class="metric-label">Pending</span>
                <span class="metric-value text-warning">@filteredRequests.Count(r => IsStatus(r.Status, "Pending"))</span>
            </div>
            <div class="content-section metric-card">
                <span class="metric-label">Approved</span>
                <span class="metric-value text-primary">@filteredRequests.Count(r => IsStatus(r.Status, "Approved"))</span>
            </div>
        </div>

        <div class="content-section">
            <div class="page-toolbar">
                <div class="toolbar-group">
                    <span class="toolbar-label">Search</span>
                    <div class="search-box">
                        <input type="text"
                               placeholder="Title, project, employee, status..."
                               value="@searchText"
                               @oninput="OnSearchChanged" />
                    </div>
                </div>

                <div class="toolbar-group">
                    <span class="toolbar-label">Scope</span>
                    <select class="filter-select" value="@scopeFilter" @onchange="OnScopeChanged">
                        <option value="active">Active</option>
                        <option value="all">All</option>
                        <option value="archived">Archived</option>
                    </select>
                </div>

                <div class="toolbar-group">
                    <span class="toolbar-label">Status</span>
                    <select class="filter-select" value="@statusFilter" @onchange="OnStatusChanged">
                        <option value="all">All statuses</option>
                        @foreach (var status in AvailableStatuses)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>

                <div class="toolbar-group toolbar-group-end">
                    <RadzenButton Icon="file_download"
                                  Text="Export Excel"
                                  ButtonStyle="ButtonStyle.Success"
                                  Shade="Shade.Lighter"
                                  Click="@ExportExcelAsync" />
                    <RadzenButton Icon="refresh"
                                  Text="Refresh"
                                  ButtonStyle="ButtonStyle.Light"
                                  Shade="Shade.Lighter"
                                  Click="@ReloadAsync" />
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(loadError))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger"
                             Variant="Variant.Flat"
                             Shade="Shade.Lighter"
                             Text="@loadError" />
            }

            @if (isLoading)
            {
                <div class="content-placeholder loading">
                    <RadzenIcon Icon="shopping_cart" Style="font-size: 42px;" />
                    <h2>Loading requests...</h2>
                </div>
            }
            else if (filteredRequests.Count == 0)
            {
                <div class="content-placeholder">
                    <RadzenIcon Icon="description" Style="font-size: 42px;" />
                    <h2>No matching requests</h2>
                    <p>Adjust filters or submit a new request.</p>
                </div>
            }
            else
            {
                <div class="req-card-list">
                    @foreach (var r in filteredRequests)
                    {
                        var isExpanded = expandedRequestIds.Contains(r.Id);
                        <div class="req-card-item @(isExpanded ? "req-card-item-open" : "")">
                            <div class="req-card-item-header">
                                <div class="req-card-item-left">
                                    <span class="req-card-item-id">#@r.Id</span>
                                    <div class="req-card-item-title-wrap">
                                        <span class="req-card-item-title">@r.Title</span>
                                        <div class="req-card-item-badges">
                                            <span class="badge @StatusBadge(r.Status)">@NormalizeStatus(r.Status)</span>
                                            @if (r.Offers?.Count > 0)
                                            {
                                                var accepted = r.Offers.Count(o => o.Selected == true);
                                                <span class="badge @(accepted > 0 ? "badge-success" : "badge-primary")">
                                                    @r.Offers.Count offer@(r.Offers.Count != 1 ? "s" : "")@(accepted > 0 ? " ✓" : "")
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="req-card-item-actions">
                                    @if (IsStatus(r.Status, "Pending"))
                                    {
                                        <RadzenButton Icon="check_circle"
                                                      Text="Approve"
                                                      Size="ButtonSize.Small"
                                                      ButtonStyle="ButtonStyle.Success"
                                                      Shade="Shade.Lighter"
                                                      Click="@(() => SetStatusAsync(r, "Approved"))" />
                                        <RadzenButton Icon="cancel"
                                                      Text="Reject"
                                                      Size="ButtonSize.Small"
                                                      ButtonStyle="ButtonStyle.Danger"
                                                      Shade="Shade.Lighter"
                                                      Click="@(() => SetStatusAsync(r, "Rejected"))" />
                                    }
                                    @if (ShowAdminStatusTools && IsStatus(r.Status, "Approved"))
                                    {
                                        <RadzenButton Icon="done_all"
                                                      Text="Done"
                                                      Size="ButtonSize.Small"
                                                      ButtonStyle="ButtonStyle.Light"
                                                      Shade="Shade.Lighter"
                                                      Click="@(() => SetStatusAsync(r, "Done"))" />
                                    }
                                    <RadzenButton Icon="edit"
                                                  Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  Shade="Shade.Lighter"
                                                  Click="@(() => OpenEditModal(r))" />
                                    <RadzenButton Icon="delete"
                                                  Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Danger"
                                                  Shade="Shade.Lighter"
                                                  Click="@(() => DeleteRequestAsync(r))" />
                                    <button type="button"
                                            class="req-toggle-btn @(isExpanded ? "req-toggle-open" : "")"
                                            @onclick="() => ToggleRequestExpand(r.Id)">
                                        <RadzenIcon Icon="@(isExpanded ? "expand_less" : "local_offer")" />
                                        @(isExpanded ? "Hide Offers" : $"Offers ({r.Offers?.Count ?? 0})")
                                    </button>
                                </div>
                            </div>
                            <div class="req-card-item-meta">
                                <span><RadzenIcon Icon="person" /> @(r.Employee?.FullName ?? "—")</span>
                                <span><RadzenIcon Icon="folder" /> @(string.IsNullOrWhiteSpace(r.ProjectName) ? "—" : r.ProjectName)</span>
                                <span><RadzenIcon Icon="category" /> @(string.IsNullOrWhiteSpace(r.MaterialType) ? "—" : r.MaterialType)</span>
                                <span><RadzenIcon Icon="event" /> @r.Date.ToString("dd/MM/yyyy")</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(r.Description))
                            {
                                <div class="req-card-item-desc">@r.Description</div>
                            }
                            @if (isExpanded)
                            {
                                <div class="req-offers-panel">
                                    <div class="req-offers-panel-header">
                                        <span class="req-offers-panel-title">
                                            <RadzenIcon Icon="local_offer" /> Supplier Offers
                                        </span>
                                        @if (addOfferTargetId != r.Id)
                                        {
                                            <button type="button" class="btn-add-offer"
                                                    @onclick="@(() => OpenInlineAddOfferForm(r))">
                                                <RadzenIcon Icon="add_circle" /> Add Offer
                                            </button>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(offerError) && addOfferTargetId == r.Id)
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat"
                                                     Shade="Shade.Lighter" Text="@offerError" />
                                    }

                                    @if (addOfferTargetId == r.Id)
                                    {
                                        <div class="add-offer-form form-grid-3">
                                            <div class="form-group">
                                                <label>Supplier</label>
                                                <select class="filter-select" @bind="newOfferModel.SupplierName">
                                                    <option value="">— Select supplier —</option>
                                                    @foreach (var s in suppliers)
                                                    {
                                                        <option value="@s.SupplierName">@s.SupplierName</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <label>Unit Price (€)</label>
                                                <input type="number" step="0.01" min="0" class="form-control"
                                                       value="@newOfferModel.Price"
                                                       @onchange="e => newOfferModel.Price = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0" />
                                            </div>
                                            <div class="form-group">
                                                <label>Expected Delivery</label>
                                                <input type="date" class="form-control"
                                                       value="@newOfferModel.DeliveryDate.ToString("yyyy-MM-dd")"
                                                       @onchange="e => newOfferModel.DeliveryDate = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : DateTime.UtcNow.AddDays(7)" />
                                            </div>
                                            <div class="form-group form-group-actions">
                                                <RadzenButton Icon="save" Text="Save Offer"
                                                              ButtonStyle="ButtonStyle.Primary" Shade="Shade.Lighter"
                                                              Click="@(() => SaveInlineOfferAsync(r))" />
                                                <RadzenButton Icon="cancel" Text="Cancel"
                                                              ButtonStyle="ButtonStyle.Light" Shade="Shade.Lighter"
                                                              Click="@(() => { addOfferTargetId = null; offerError = null; })" />
                                            </div>
                                        </div>
                                    }

                                    @if (r.Offers == null || r.Offers.Count == 0)
                                    {
                                        <div class="offers-empty">
                                            <RadzenIcon Icon="local_offer" Style="font-size: 28px; opacity: 0.3;" />
                                            <p>No supplier offers received yet.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="offers-list">
                                            @foreach (var offer in r.Offers.OrderBy(o => o.CreatedAt))
                                            {
                                                <div class="offer-card @OfferCardClass(offer.Selected)">
                                                    <div class="offer-card-body">
                                                        <div class="offer-card-field">
                                                            <span class="offer-label">Supplier</span>
                                                            <span class="offer-value">@offer.SupplierName</span>
                                                        </div>
                                                        <div class="offer-card-field">
                                                            <span class="offer-label">Price</span>
                                                            <span class="offer-value offer-price">€@offer.Price.ToString("N2")</span>
                                                        </div>
                                                        <div class="offer-card-field">
                                                            <span class="offer-label">Delivery</span>
                                                            <span class="offer-value">@offer.DeliveryDate.ToString("dd/MM/yyyy")</span>
                                                        </div>
                                                        <div class="offer-card-field">
                                                            <span class="offer-label">Status</span>
                                                            <span class="badge @OfferBadge(offer.Selected)">@OfferStatus(offer.Selected)</span>
                                                        </div>
                                                    </div>
                                                    <div class="offer-card-actions">
                                                        @if (offer.Selected != true)
                                                        {
                                                            <RadzenButton Icon="check_circle" Text="Accept"
                                                                          Size="ButtonSize.Small"
                                                                          ButtonStyle="ButtonStyle.Success"
                                                                          Shade="Shade.Lighter"
                                                                          Click="@(() => SetOfferSelectedInlineAsync(r, offer, true))" />
                                                        }
                                                        @if (offer.Selected != false)
                                                        {
                                                            <RadzenButton Icon="cancel" Text="Reject"
                                                                          Size="ButtonSize.Small"
                                                                          ButtonStyle="ButtonStyle.Danger"
                                                                          Shade="Shade.Lighter"
                                                                          Click="@(() => SetOfferSelectedInlineAsync(r, offer, false))" />
                                                        }
                                                        @if (offer.Selected != null)
                                                        {
                                                            <RadzenButton Icon="undo" Text="Reset"
                                                                          Size="ButtonSize.Small"
                                                                          ButtonStyle="ButtonStyle.Light"
                                                                          Shade="Shade.Lighter"
                                                                          Click="@(() => SetOfferSelectedInlineAsync(r, offer, null))" />
                                                        }
                                                        <RadzenButton Icon="delete"
                                                                      Size="ButtonSize.Small"
                                                                      ButtonStyle="ButtonStyle.Danger"
                                                                      Shade="Shade.Lighter"
                                                                      Click="@(() => DeleteOfferInlineAsync(r, offer))" />
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@if (showEditorModal)
{
    <div class="modal-overlay" @onclick="CloseEditorModal">
        <div class="modal-content modal-content-wide" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Edit Request</h2>
                <button type="button" class="modal-close" @onclick="CloseEditorModal">×</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(editorError))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger"
                             Variant="Variant.Flat"
                             Shade="Shade.Lighter"
                             Text="@editorError" />
            }

            <EditForm Model="@editorModel" OnValidSubmit="@SaveRequestAsync" class="modal-form">
                <DataAnnotationsValidator />

                <div class="form-grid-2">
                    <div class="form-group">
                        <label for="edit-req-title">Title</label>
                        <InputText id="edit-req-title" @bind-Value="editorModel.Title" />
                    </div>

                    <div class="form-group">
                        <label for="edit-req-project">Project</label>
                        <select id="edit-req-project" class="filter-select" @bind="editorModel.ProjectName">
                            <option value="">— Select project —</option>
                            @foreach (var p in projects)
                            {
                                <option value="@p.ProjectName">@p.ProjectName</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="edit-req-type">Material Type</label>
                        <select id="edit-req-type" class="filter-select" @bind="editorModel.MaterialType">
                            <option value="">— Select type —</option>
                            <option value="Laptop">Laptop</option>
                            <option value="Desktop">Desktop</option>
                            <option value="Server">Server</option>
                            <option value="Switch">Switch</option>
                            <option value="Router">Router</option>
                            <option value="Firewall">Firewall</option>
                            <option value="Printer">Printer</option>
                            <option value="Monitor">Monitor</option>
                            <option value="Phone">Phone</option>
                            <option value="Tablet">Tablet</option>
                            <option value="Projector">Projector</option>
                            <option value="UPS">UPS</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="edit-req-employee">Employee</label>
                        <select id="edit-req-employee" class="filter-select" @bind="editorModel.EmployeeId">
                            @foreach (var employee in employees)
                            {
                                <option value="@employee.Id">@employee.FullName (@employee.Service)</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="edit-req-date">Request Date</label>
                        <InputDate id="edit-req-date" @bind-Value="editorModel.Date" />
                    </div>

                    @if (ShowAdminStatusTools)
                    {
                        <div class="form-group">
                            <label for="edit-req-status">Status</label>
                            <select id="edit-req-status" class="filter-select" @bind="editorModel.Status">
                                @foreach (var status in AvailableStatuses)
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                    }
                </div>

                <div class="form-group">
                    <label for="edit-req-description">Description</label>
                    <InputTextArea id="edit-req-description" @bind-Value="editorModel.Description" />
                </div>

                <div class="form-actions">
                    <RadzenButton Icon="save"
                                  Text="Save"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Shade="Shade.Lighter"
                                  ButtonType="ButtonType.Submit" />
                    <RadzenButton Icon="cancel"
                                  Text="Cancel"
                                  ButtonStyle="ButtonStyle.Light"
                                  Shade="Shade.Lighter"
                                  Click="@(_ => CloseEditorModal())" />
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public string InitialScope { get; set; } = "active";
    [Parameter] public bool ShowAdminStatusTools { get; set; }

    private static readonly string[] AvailableStatuses = ["Pending", "Approved", "Done", "Rejected"];

    private readonly List<Request> requests = [];
    private readonly List<Employee> employees = [];
    private readonly List<Project> projects = [];
    private readonly List<Supplier> suppliers = [];
    private List<Request> filteredRequests = [];

    private bool isLoading = true;
    private bool showEditorModal;
    private bool isEditMode;
    private bool initializedScope;
    private bool newRequestSuccess;

    private readonly HashSet<int> expandedRequestIds = new();
    private int? addOfferTargetId;
    private OfferEditorModel newOfferModel = new();
    private string? offerError;

    private string purchaseTab = "new";
    private string searchText = string.Empty;
    private string statusFilter = "all";
    private string scopeFilter = "active";
    private string? loadError;
    private string? editorError;

    private RequestEditorModel editorModel = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    protected override void OnParametersSet()
    {
        if (!initializedScope)
        {
            scopeFilter = NormalizeScope(InitialScope);
            initializedScope = true;
        }
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            var employeeList = await EmployeeService.GetEmployeesList();
            employees.Clear();
            employees.AddRange(employeeList.OrderBy(e => e.FullName));

            if (editorModel.EmployeeId <= 0 && employees.Count > 0)
            {
                editorModel.EmployeeId = employees[0].Id;
            }

            var projectList = await ProjectService.GetProjectsList();
            projects.Clear();
            projects.AddRange(projectList.OrderBy(p => p.ProjectName));

            var supplierList = await SupplierService.GetSuppliersList();
            suppliers.Clear();
            suppliers.AddRange(supplierList.OrderBy(s => s.SupplierName));

            var requestList = await RequestService.GetRequestsList();
            requests.Clear();
            requests.AddRange(requestList);

            ApplyFilters();
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load requests: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<Request> query = requests;

        query = scopeFilter switch
        {
            "archived" => query.Where(r => IsArchivedStatus(r.Status)),
            "active" => query.Where(r => !IsArchivedStatus(r.Status)),
            _ => query
        };

        if (!string.Equals(statusFilter, "all", StringComparison.OrdinalIgnoreCase))
        {
            query = query.Where(r => IsStatus(r.Status, statusFilter));
        }

        var term = searchText.Trim();
        if (!string.IsNullOrWhiteSpace(term))
        {
            query = query.Where(r =>
                Contains(r.Title, term) ||
                Contains(r.ProjectName, term) ||
                Contains(r.Description, term) ||
                Contains(r.MaterialType, term) ||
                Contains(r.Employee?.FullName, term) ||
                Contains(r.Status, term));
        }

        filteredRequests = query
            .OrderByDescending(r => r.Date)
            .ThenByDescending(r => r.Id)
            .ToList();
    }

    private void OnSearchChanged(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? string.Empty;
        ApplyFilters();
    }

    private void OnStatusChanged(ChangeEventArgs args)
    {
        statusFilter = args.Value?.ToString() ?? "all";
        ApplyFilters();
    }

    private void OnScopeChanged(ChangeEventArgs args)
    {
        scopeFilter = NormalizeScope(args.Value?.ToString());
        ApplyFilters();
    }

    private void OpenCreateModal()
    {
        editorError = null;
        newRequestSuccess = false;
        isEditMode = false;
        editorModel = new RequestEditorModel
        {
            EmployeeId = employees.FirstOrDefault()?.Id ?? 0,
            Date = DateTime.UtcNow.Date,
            Status = "Pending"
        };
    }

    private void OpenEditModal(Request request)
    {
        editorError = null;
        isEditMode = true;
        editorModel = new RequestEditorModel
        {
            Id = request.Id,
            EmployeeId = request.EmployeeId,
            Title = request.Title ?? string.Empty,
            ProjectName = request.ProjectName ?? string.Empty,
            Description = request.Description ?? string.Empty,
            MaterialType = request.MaterialType ?? string.Empty,
            Date = request.Date,
            Status = NormalizeStatus(request.Status)
        };
        showEditorModal = true;
    }

    private async Task SaveRequestAsync()
    {
        editorError = ValidateEditor();
        if (!string.IsNullOrWhiteSpace(editorError))
        {
            return;
        }

        var payload = new Request
        {
            Id = editorModel.Id,
            EmployeeId = editorModel.EmployeeId,
            Title = editorModel.Title.Trim(),
            ProjectName = editorModel.ProjectName.Trim(),
            Description = editorModel.Description.Trim(),
            MaterialType = editorModel.MaterialType.Trim(),
            Date = editorModel.Date,
            Status = ShowAdminStatusTools ? editorModel.Status : "Pending",
            File = null
        };

        try
        {
            if (isEditMode)
            {
                await RequestService.UpdateRequest(editorModel.Id, payload);
                NotifySuccess("Request updated", $"Request #{editorModel.Id} updated.");
                CloseEditorModal();
            }
            else
            {
                await RequestService.CreateRequest(payload);

                NotifySuccess("Request submitted", $"{payload.Title} submitted successfully.");
                newRequestSuccess = true;
                editorModel = new RequestEditorModel
                {
                    EmployeeId = employees.FirstOrDefault()?.Id ?? 0,
                    Date = DateTime.UtcNow.Date,
                    Status = "Pending"
                };
            }

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            editorError = ex.Message;
        }
    }

    private async Task SetStatusAsync(Request request, string status)
    {
        var payload = CloneRequest(request);
        payload.Status = status;
        payload.ApprovedAt = IsStatus(status, "Approved") ? DateTime.UtcNow : payload.ApprovedAt;

        try
        {
            await RequestService.UpdateRequest(request.Id, payload);
            NotifySuccess("Status updated", $"Request #{request.Id} marked {status}.");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Status update failed",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }

    private async Task DeleteRequestAsync(Request request)
    {
        try
        {
            await RequestService.DeleteRequest(request.Id);
            NotifySuccess("Request deleted", $"Request #{request.Id} removed.");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Delete failed",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }

    private void CloseEditorModal()
    {
        showEditorModal = false;
        editorError = null;
    }

    private void ToggleRequestExpand(int requestId)
    {
        if (expandedRequestIds.Contains(requestId))
        {
            expandedRequestIds.Remove(requestId);
            if (addOfferTargetId == requestId)
            {
                addOfferTargetId = null;
                offerError = null;
            }
        }
        else
        {
            expandedRequestIds.Add(requestId);
        }
    }

    private void OpenInlineAddOfferForm(Request r)
    {
        addOfferTargetId = r.Id;
        newOfferModel = new OfferEditorModel();
        offerError = null;
    }

    private async Task SaveInlineOfferAsync(Request r)
    {
        offerError = null;

        if (string.IsNullOrWhiteSpace(newOfferModel.SupplierName))
        {
            offerError = "Please select a supplier.";
            return;
        }
        if (newOfferModel.Price <= 0)
        {
            offerError = "Price must be greater than zero.";
            return;
        }

        try
        {
            await OfferService.CreateOffer(new Offer
            {
                RequestId = r.Id,
                SupplierName = newOfferModel.SupplierName.Trim(),
                Price = newOfferModel.Price,
                DeliveryDate = newOfferModel.DeliveryDate,
                Selected = null
            });

            NotifySuccess("Offer added", $"Offer from {newOfferModel.SupplierName} added.");
            addOfferTargetId = null;
            newOfferModel = new OfferEditorModel();
            await ReloadAsync();
            expandedRequestIds.Add(r.Id);
        }
        catch (Exception ex)
        {
            offerError = ex.Message;
        }
    }

    private async Task SetOfferSelectedInlineAsync(Request r, Offer offer, bool? selected)
    {
        offerError = null;

        try
        {
            var updated = new Offer
            {
                Id = offer.Id,
                RequestId = offer.RequestId,
                SupplierName = offer.SupplierName,
                Price = offer.Price,
                DeliveryDate = offer.DeliveryDate,
                Selected = selected
            };
            await OfferService.UpdateOffer(offer.Id, updated);
            NotifySuccess("Offer updated", selected switch { true => "Offer accepted.", false => "Offer rejected.", _ => "Offer reset." });
            await ReloadAsync();
            expandedRequestIds.Add(r.Id);
        }
        catch (Exception ex)
        {
            offerError = ex.Message;
        }
    }

    private async Task DeleteOfferInlineAsync(Request r, Offer offer)
    {
        offerError = null;

        try
        {
            await OfferService.DeleteOffer(offer.Id);
            NotifySuccess("Offer deleted", "Offer removed.");
            await ReloadAsync();
            expandedRequestIds.Add(r.Id);
        }
        catch (Exception ex)
        {
            offerError = ex.Message;
        }
    }

    private static string OfferCardClass(bool? selected) => selected switch
    {
        true => "offer-card-accepted",
        false => "offer-card-rejected",
        _ => "offer-card-pending"
    };

    private static string OfferBadge(bool? selected) => selected switch
    {
        true => "badge-success",
        false => "badge-danger",
        _ => "badge-warning"
    };

    private static string OfferStatus(bool? selected) => selected switch
    {
        true => "Accepted",
        false => "Rejected",
        _ => "Pending"
    };

    private string? ValidateEditor()
    {
        if (editorModel.EmployeeId <= 0)
        {
            return "Please select an employee.";
        }

        if (string.IsNullOrWhiteSpace(editorModel.Title))
        {
            return "Title is required.";
        }

        if (string.IsNullOrWhiteSpace(editorModel.ProjectName))
        {
            return "Project name is required.";
        }

        if (string.IsNullOrWhiteSpace(editorModel.Description))
        {
            return "Description is required.";
        }

        if (string.IsNullOrWhiteSpace(editorModel.MaterialType))
        {
            return "Material type is required.";
        }

        if (ShowAdminStatusTools && string.IsNullOrWhiteSpace(editorModel.Status))
        {
            return "Status is required.";
        }

        return null;
    }

    private void NotifySuccess(string summary, string detail)
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = summary,
            Detail = detail,
            Duration = 2500
        });
    }

    private static string NormalizeScope(string? scope) =>
        scope?.Trim().ToLowerInvariant() switch
        {
            "all" => "all",
            "archived" => "archived",
            _ => "active"
        };

    private static string NormalizeStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return "Pending";
        }

        foreach (var candidate in AvailableStatuses)
        {
            if (string.Equals(candidate, status, StringComparison.OrdinalIgnoreCase))
            {
                return candidate;
            }
        }

        return status;
    }

    private static bool IsArchivedStatus(string? status) =>
        IsStatus(status, "Done") || IsStatus(status, "Rejected") || IsStatus(status, "Archived") || IsStatus(status, "Closed");

    private static bool IsStatus(string? status, string expected) =>
        string.Equals(status?.Trim(), expected, StringComparison.OrdinalIgnoreCase);

    private static string StatusBadge(string? status)
    {
        if (IsStatus(status, "Done"))
        {
            return "badge-success";
        }

        if (IsStatus(status, "Approved"))
        {
            return "badge-primary";
        }

        if (IsStatus(status, "Rejected"))
        {
            return "badge-danger";
        }

        return "badge-warning";
    }

    private static bool Contains(string? source, string term) =>
        !string.IsNullOrWhiteSpace(source) &&
        source.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static Request CloneRequest(Request source) =>
        new()
        {
            Id = source.Id,
            EmployeeId = source.EmployeeId,
            Title = source.Title,
            ProjectName = source.ProjectName,
            Description = source.Description,
            MaterialType = source.MaterialType,
            Date = source.Date,
            Status = source.Status,
            File = source.File,
            FileExtension = source.FileExtension,
            FileName = source.FileName,
            ApprovedAt = source.ApprovedAt
        };

    private sealed class RequestEditorModel
    {
        public int Id { get; set; }
        public int EmployeeId { get; set; }
        public string Title { get; set; } = string.Empty;
        public string ProjectName { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string MaterialType { get; set; } = string.Empty;
        public DateTime Date { get; set; } = DateTime.UtcNow.Date;
        public string Status { get; set; } = "Pending";
    }

    private sealed class OfferEditorModel
    {
        public string SupplierName { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public DateTime DeliveryDate { get; set; } = DateTime.UtcNow.AddDays(14).Date;
    }

    private async Task ExportExcelAsync()
    {
        try
        {
            var bytes = ITStockM.Services.ExcelExportService.ExportRequests(filteredRequests);
            var b64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFileFromBase64",
                $"PurchaseRequests_{DateTime.Now:yyyyMMdd_HHmm}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                b64);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Export failed",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }
