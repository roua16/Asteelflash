        public string Description { get; set; } = string.Empty;
        public string MaterialType { get; set; } = string.Empty;
        public DateTime Date { get; set; } = DateTime.UtcNow.Date;
        public string Status { get; set; } = "Pending";

        // Optional offer to attach when creating
        public bool IncludeOffer { get; set; }
        public string OfferSupplierName { get; set; } = string.Empty;
        public decimal OfferPrice { get; set; }
        public DateTime OfferDeliveryDate { get; set; } = DateTime.UtcNow.AddDays(14).Date;
    }

    private sealed class OfferEditorModel
    {
        public string SupplierName { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public DateTime DeliveryDate { get; set; } = DateTime.UtcNow.AddDays(14).Date;
    }
