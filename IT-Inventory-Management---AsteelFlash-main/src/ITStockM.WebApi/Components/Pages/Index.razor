@page "/"
@page "/dashboard"

@using System.Net.Http.Json
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService

<style>
    .dashboard-container {
        max-width: 1400px;
        margin: auto;
        padding: 1.5rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-card {
        padding: 1rem;
        border-radius: 12px;
        background: #fff;
        border: 1px solid #eee;
    }

    .stat-value {
        font-size: 1.8rem;
        font-weight: bold;
    }

    .stat-change {
        font-size: 0.8rem;
    }

    .positive {
        color: green;
    }

    .warning {
        color: orange;
    }

    .danger {
        color: red;
    }

    .dashboard-section {
        background: white;
        padding: 1rem;
        border-radius: 12px;
        margin-bottom: 1rem;
        border: 1px solid #eee;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 10px;
        border-bottom: 1px solid #eee;
        text-align: left;
    }

    th {
        background: #f8f9fa;
    }

    .badge {
        padding: 4px 8px;
        border-radius: 6px;
        color: white;
        font-size: 12px;
    }

    .ok {
        background: green;
    }

    .low {
        background: orange;
    }

    .critical {
        background: red;
    }

    .rank {
        background: #2563eb;
        color: white;
        padding: 4px 8px;
        border-radius: 50%;
    }

    .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }
</style>

<div class="dashboard-container">

    <!-- KPI -->
    <div class="stats-grid">

        <div class="stat-card">
            <div>Total Matériel</div>
            <div class="stat-value">@totalMaterial</div>
            <div class="stat-change positive">+8% ce mois</div>
        </div>

        <div class="stat-card">
            <div>Assignments</div>
            <div class="stat-value">@totalAssignments</div>
            <div class="stat-change warning">stable</div>
        </div>

        <div class="stat-card">
            <div>Pending Requests</div>
            <div class="stat-value">@pendingRequests</div>
            <div class="stat-change danger">attention</div>
        </div>

    </div>

    <!-- TOP 3 -->
    <div class="dashboard-section">
        <h3>🏆 Top 3 Matériels</h3>

        <table>
            <thead>
                <tr>
                    <th>Rank</th>
                    <th>Nom</th>
                    <th>Type</th>
                    <th>Total</th>
                    <th>Variation</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Materiels
                                .OrderByDescending(m => m.QuantityITStock + m.QuantityPDRStock)
                                .Take(3)
                                .Select((m, i) => new { m, i }))
                {
                    <tr>
                        <td><span class="rank">@(@item.i + 1)</span></td>
                        <td>@item.m.MaterielName</td>
                        <td>@item.m.Type</td>
                        <td>@(item.m.QuantityITStock + item.m.QuantityPDRStock)</td>
                        <td class="positive">+12%</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- INVENTAIRE -->
    <div class="dashboard-section">
        <h3>📦 Inventaire complet</h3>

        <table>
            <thead>
                <tr>
                    <th>Matériel</th>
                    <th>Type</th>
                    <th>IT</th>
                    <th>PDR</th>
                    <th>Total</th>
                    <th>État</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Materiels)
                {
                    var total = m.QuantityITStock + m.QuantityPDRStock;

                    <tr>
                        <td>@m.MaterielName</td>
                        <td>@m.Type</td>
                        <td>@m.QuantityITStock</td>
                        <td>@m.QuantityPDRStock</td>
                        <td><b>@total</b></td>
                        <td>
                            @if (total > 20)
                            {
                                <span class="badge ok">OK</span>
                            }
                            else if (total > 5)
                            {
                                <span class="badge low">LOW</span>
                            }
                            else
                            {
                                <span class="badge critical">CRITICAL</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- CHART SIMPLE -->
    <div class="dashboard-section">
        <h3>📊 Assignments mensuels</h3>

        <div class="grid-2">

            <div>
                @foreach (var m in monthlyData)
                {
                    <div style="margin-bottom:8px;">
                        <b>@m.Month</b>
                        <div style="background:#eee;height:10px;border-radius:5px;">
                            <div style="width:@m.Value% ;background:#2563eb;height:10px;border-radius:5px;"></div>
                        </div>
                    </div>
                }
            </div>

            <div>
                <h4>Total: @monthlyData.Sum(x => x.Value)</h4>
                <p>📈 Analyse simple des tendances</p>
            </div>

        </div>
    </div>

</div>

@code {

    // ===== DATA SIMPLE =====
    private int totalMaterial = 1200;
    private int totalAssignments = 320;
    private int pendingRequests = 8;

    private List<Materiel> Materiels = new();
    private List<MonthItem> monthlyData = new();

    protected override async Task OnInitializedAsync()
    {
        // MOCK DATA (remplace API si besoin)
        Materiels = new List<Materiel>
        {
            new() { MaterielName="Laptop HP", Type="Laptop", QuantityITStock=10, QuantityPDRStock=5 },
            new() { MaterielName="Dell Monitor", Type="Monitor", QuantityITStock=3, QuantityPDRStock=2 },
            new() { MaterielName="Router Cisco", Type="Network", QuantityITStock=12, QuantityPDRStock=8 },
            new() { MaterielName="Keyboard", Type="Hardware", QuantityITStock=20, QuantityPDRStock=10 }
        };

        monthlyData = new List<MonthItem>
        {
            new() { Month="Jan", Value=40 },
            new() { Month="Feb", Value=55 },
            new() { Month="Mar", Value=70 },
            new() { Month="Apr", Value=30 },
            new() { Month="May", Value=90 }
        };
    }

    public class Materiel
    {
        public string MaterielName { get; set; }
        public string Type { get; set; }
        public int QuantityITStock { get; set; }
        public int QuantityPDRStock { get; set; }
    }

    public class MonthItem
    {
        public string Month { get; set; }
        public int Value { get; set; }
    }
}