@page "/"
@page "/dashboard"

@using System.Globalization
@using System.Security.Claims
@using ITStockM.Application.Features.Dashboard.DTOs
@using ITStockM.Services.Assignments
@using ITStockM.Services.Materiels
@attribute [Authorize(Roles = "Admin,PDR,Purchasing,IT,Infrastructure,Employee")]
@inject IMaterielService MaterielService
@inject IAssignmentService AssignmentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotificationService NotificationService

<div class="dashboard-container">
    <section class="dashboard-header">
        <div class="header-content">
            <div class="header-copy">
                <h1>IT Inventory Dashboard</h1>
                <p class="header-subtitle">
                    Unified operations view for assignment flow, inventory trends, and purchasing status.
                </p>
            </div>
            <div class="header-meta">
                <span class="meta-pill">
                    <RadzenIcon Icon="calendar_today" />
                    @DateTime.Now.ToString("ddd, MMM d")
                </span>
                <span class="meta-pill">
                    <RadzenIcon Icon="person" />
                    @CurrentUserRole
                </span>
                <div class="header-status @(string.IsNullOrWhiteSpace(ErrorMessage) ? "is-healthy" : string.Empty)">
                    <span class="header-status-dot"></span>
                    <span>@(string.IsNullOrWhiteSpace(ErrorMessage) ? "System healthy" : "Attention required")</span>
                </div>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="error-message">
            <RadzenIcon Icon="error_outline" />
            <span>@ErrorMessage</span>
        </div>
    }

    @if (IsLoading)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <span>Loading dashboard data...</span>
        </div>
    }
    else
    {
        <div class="dashboard-content">
            <div class="stats-grid">
                <StatCard
                    Title="Total Materials"
                    Value="@(DashboardStats?.TotalMaterials.ToString() ?? "0")"
                    Icon="inventory_2"
                    TrendText="@MaterialsTrendText"
                    TrendClass="@MaterialsTrendClass"
                    ToneClass="tone-indigo"
                    Compact="true" />

                <StatCard
                    Title="Active Assignments"
                    Value="@(DashboardStats?.TotalAssignments.ToString() ?? "0")"
                    Icon="assignment_turned_in"
                    TrendText="@AssignmentsTrendText"
                    TrendClass="@AssignmentsTrendClass"
                    ToneClass="tone-cyan"
                    Compact="true" />

                <StatCard
                    Title="Pending Requests"
                    Value="@(DashboardStats?.PendingRequests.ToString() ?? "0")"
                    Icon="pending_actions"
                    TrendText="Based on open assignments"
                    TrendClass="warning"
                    ToneClass="tone-amber"
                    Compact="true" />

                <StatCard
                    Title="Critical Stock Items"
                    Value="@CriticalStockCount.ToString()"
                    Icon="warning"
                    TrendText="@CriticalStockTrendText"
                    TrendClass="@CriticalStockTrendClass"
                    ToneClass="tone-rose"
                    Compact="true" />
            </div>

            <ChartCard
                Title="Monthly Assignments"
                Subtitle="Rolling 12-month assignment volume"
                Icon="insert_chart"
                IconClass="is-success"
                ToneClass="tone-emerald"
                SectionClass="card-elevated card-chart card-chart-full">
                <HeaderActions>
                    <span class="card-kpi">Current month: @CurrentMonthAssignments</span>
                </HeaderActions>
                <ChildContent>
                    @if (MonthlyTrendPoints.Count == 0)
                    {
                        <div class="chart-empty">No assignment history available.</div>
                    }
                    else
                    {
                        <div class="chart-shell assignments-chart-shell assignments-chart-full">
                            <RadzenChart Style="height:320px">
                                <RadzenColumnSeries Data="@MonthlyTrendPoints" CategoryProperty="Month" ValueProperty="Assignments" Title="Assignments">
                                    <RadzenSeriesDataLabels Visible="false" />
                                </RadzenColumnSeries>
                                <RadzenLineSeries Data="@MonthlyTrendPoints" CategoryProperty="Month" ValueProperty="Trend" Title="Trend" />
                                <RadzenColumnOptions Radius="8" />
                                <RadzenValueAxis>
                                    <RadzenGridLines Visible="true" />
                                </RadzenValueAxis>
                                <RadzenCategoryAxis>
                                    <RadzenGridLines Visible="false" />
                                </RadzenCategoryAxis>
                            </RadzenChart>
                        </div>
                    }
                </ChildContent>
                <FooterContent>
                    <div class="chart-metrics">
                        <div class="metric-pill">
                            <span class="metric-label">Peak</span>
                            <strong>@PeakMonthAssignments (@PeakMonthLabel)</strong>
                        </div>
                        <div class="metric-pill">
                            <span class="metric-label">Average</span>
                            <strong>@AverageMonthlyAssignments.ToString("0.0", CultureInfo.InvariantCulture)/mo</strong>
                        </div>
                    </div>
                </FooterContent>
            </ChartCard>

            <ChartCard
                Title="Top Materials"
                Subtitle="Top 4 highest stocked items by total units"
                Icon="trending_up"
                IconClass="is-warning"
                ToneClass="tone-amber"
                SectionClass="card-elevated">
                @if (TopInventory.Count == 0)
                {
                    <div class="chart-empty">No materials found.</div>
                }
                else
                {
                    <div class="table-shell">
                        <table class="dashboard-table">
                            <thead>
                                <tr>
                                    <th>Material</th>
                                    <th>Type</th>
                                    <th>Total</th>
                                    <th>Share</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var material in TopInventory)
                                {
                                    <tr>
                                        <td>@material.MaterielName</td>
                                        <td>@material.Type</td>
                                        <td>@material.Total</td>
                                        <td>
                                            <div class="table-share">
                                                <span>@GetMaterialShare(material).ToString("0.#")%</span>
                                                <div class="share-bar">
                                                    <span style="@GetMaterialShareStyle(material)"></span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="stock-badge @GetStatusClass(material.StatusBadge)">@material.StatusBadge</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </ChartCard>

            <ChartCard
                Title="Quick Actions"
                Subtitle="Common workflows by role"
                Icon="bolt"
                IconClass="is-accent"
                ToneClass="tone-cyan"
                SectionClass="card-elevated">
                <div class="actions-grid">
                    <a href="/materials-view-interface" class="action-card">
                        <span class="action-icon"><RadzenIcon Icon="inventory" /></span>
                        <h3>Materials View</h3>
                        <p>Browse inventory availability and status.</p>
                    </a>

                    <a href="/assignments-interface" class="action-card">
                        <span class="action-icon"><RadzenIcon Icon="assignment" /></span>
                        <h3>Assignments</h3>
                        <p>Manage assignment and restore workflow.</p>
                    </a>

                    @if (IsRole("Admin", "Purchasing", "PDR"))
                    {
                        <a href="/delivery-order-history" class="action-card">
                            <span class="action-icon"><RadzenIcon Icon="history" /></span>
                            <h3>Delivery History</h3>
                            <p>Review completed and pending deliveries.</p>
                        </a>
                    }

                    @if (IsRole("Admin", "Infrastructure", "IT"))
                    {
                        <a href="/infra-interface" class="action-card">
                            <span class="action-icon"><RadzenIcon Icon="memory" /></span>
                            <h3>Infrastructure</h3>
                            <p>Track infrastructure requests and offers.</p>
                        </a>
                    }

                    @if (IsRole("Admin", "Purchasing"))
                    {
                        <a href="/purchase-page" class="action-card">
                            <span class="action-icon"><RadzenIcon Icon="shopping_cart" /></span>
                            <h3>Purchase Requests</h3>
                            <p>Create and monitor procurement requests.</p>
                        </a>
                    }
                </div>
            </ChartCard>
        </div>
    }
</div>

@code {
    private DashboardStatsDto? DashboardStats;
    private List<DashboardMaterialItemDto>? Inventory;
    private List<MonthlyAssignmentDto>? MonthlyData;

    private List<DashboardMaterialItemDto> TopInventory = [];
    private List<MonthlyTrendPoint> MonthlyTrendPoints = [];

    private bool IsLoading = true;
    private string? ErrorMessage;
    private string CurrentUserRole = "Employee";

    private int CriticalStockCount;
    private int TotalInventoryUnits;
    private int CurrentMonthAssignments;
    private int PeakMonthAssignments;
    private string PeakMonthLabel = "N/A";
    private double AverageMonthlyAssignments;

    private string MaterialsTrendText = "Live inventory status";
    private string MaterialsTrendClass = "positive";
    private string AssignmentsTrendText = "Trend unavailable";
    private string AssignmentsTrendClass = "warning";
    private string CriticalStockTrendText = "No critical stock";
    private string CriticalStockTrendClass = "positive";    protected override async Task OnInitializedAsync()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            CurrentUserRole = authState.User.FindFirst(ClaimTypes.Role)?.Value ?? "Employee";

            var materialsQuery = await MaterielService.GetMateriels();
            var assignmentsQuery = await AssignmentService.GetAssignments();

            var inventory = materialsQuery
                .Where(m => !m.IsDeleted)
                .Select(m => new DashboardMaterialItemDto
                {
                    Id = m.Id,
                    MaterielName = m.MaterielName ?? "N/A",
                    Type = m.Type ?? "N/A",
                    QuantityITStock = m.QuantityITStock,
                    QuantityPDRStock = m.QuantityPDRStock
                })
                .ToList();

            var assignments = assignmentsQuery
                .Where(a => !a.IsDeleted)
                .OrderBy(a => a.CreatedAt)
                .ToList();

            DashboardStats = new DashboardStatsDto(
                TotalMaterials: inventory.Count,
                TotalAssignments: assignments.Count,
                PendingRequests: assignments.Count(a => a.RestoreDate == null));

            Inventory = inventory;
            TopInventory = inventory
                .OrderByDescending(m => m.Total)
                .Take(4)
                .ToList();

            var now = DateTime.UtcNow;
            var startOfCurrentMonth = new DateTime(now.Year, now.Month, 1);
            var last12Months = Enumerable.Range(0, 12)
                .Select(i => startOfCurrentMonth.AddMonths(-i))
                .OrderBy(d => d)
                .ToList();

            MonthlyData = last12Months
                .Select(month => new MonthlyAssignmentDto
                {
                    Month = month.ToString("MMM"),
                    Value = assignments.Count(a =>
                        a.CreatedAt.Year == month.Year &&
                        a.CreatedAt.Month == month.Month)
                })
                .ToList();

            BuildDashboardShapes();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to load dashboard data: {ex.Message}";
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Dashboard Error",
                Detail = ErrorMessage,
                Duration = 5000
            });
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void BuildDashboardShapes()
    {
        var inventory = Inventory ?? [];
        TotalInventoryUnits = inventory.Sum(i => i.Total);

        CriticalStockCount = inventory.Count(i => string.Equals(i.StatusBadge, "CRITICAL", StringComparison.OrdinalIgnoreCase));

        CriticalStockTrendText = CriticalStockCount == 0
            ? "No critical stock"
            : $"{CriticalStockCount} item(s) require replenishment";
        CriticalStockTrendClass = CriticalStockCount == 0 ? "positive" : "danger";

        if (MonthlyData is not { Count: >= 2 })
        {
            AssignmentsTrendText = "Trend unavailable";
            AssignmentsTrendClass = "warning";
            CurrentMonthAssignments = 0;
            PeakMonthAssignments = 0;
            PeakMonthLabel = "N/A";
            AverageMonthlyAssignments = 0;
            MonthlyTrendPoints = [];
            return;
        }

        var latestValue = MonthlyData[^1].Value;
        var previousValue = MonthlyData[^2].Value;
        MonthlyTrendPoints = MonthlyData
            .Select((point, index) => new MonthlyTrendPoint
            {
                Month = point.Month,
                Assignments = point.Value,
                Trend = Math.Round(MonthDataWindowAverage(index), 1)
            })
            .ToList();

        CurrentMonthAssignments = latestValue;
        var peakMonth = MonthlyData.OrderByDescending(item => item.Value).First();
        PeakMonthAssignments = peakMonth.Value;
        PeakMonthLabel = peakMonth.Month;
        AverageMonthlyAssignments = MonthlyData.Average(item => item.Value);

        if (previousValue == 0)
        {
            AssignmentsTrendText = latestValue == 0 ? "No movement this month" : "New monthly activity";
            AssignmentsTrendClass = latestValue == 0 ? "warning" : "positive";
            return;
        }

        var deltaPercent = ((double)(latestValue - previousValue) / previousValue) * 100;
        AssignmentsTrendText = $"{deltaPercent:+0.##;-0.##;0}% vs previous month";
        AssignmentsTrendClass = deltaPercent >= 0 ? "positive" : "danger";
    }

    private double MonthDataWindowAverage(int index)
    {
        if (MonthlyData is null || MonthlyData.Count == 0)
        {
            return 0;
        }

        var start = Math.Max(0, index - 2);
        var window = MonthlyData.Skip(start).Take(index - start + 1);
        return window.Average(point => point.Value);
    }

    private static string GetStatusClass(string statusBadge)
    {
        return statusBadge.ToUpperInvariant() switch
        {
            "OK" => "status-ok",
            "LOW" => "status-low",
            "CRITICAL" => "status-critical",
            _ => "status-neutral"
        };
    }

    private bool IsRole(params string[] roles)
    {
        return roles.Any(role => string.Equals(role, CurrentUserRole, StringComparison.OrdinalIgnoreCase));
    }

    private double GetMaterialShare(DashboardMaterialItemDto material)
    {
        return TotalInventoryUnits == 0 ? 0 : (material.Total * 100d) / TotalInventoryUnits;
    }

    private string GetMaterialShareStyle(DashboardMaterialItemDto material)
    {
        var width = GetMaterialShare(material).ToString("0.#", CultureInfo.InvariantCulture);
        return $"width:{width}%";
    }

    private sealed class MonthlyTrendPoint
    {
        public string Month { get; set; } = string.Empty;
        public int Assignments { get; set; }
        public double Trend { get; set; }
    }
}
