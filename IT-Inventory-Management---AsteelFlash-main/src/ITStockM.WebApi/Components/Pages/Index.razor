@page "/"
@page "/dashboard"

@using System.Net.Http.Json
@using ITStockM.Application.Features.Dashboard.DTOs
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService

<style>
    .dashboard-container {
        max-width: 1400px;
        margin: auto;
        padding: 1.5rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-card {
        padding: 1rem;
        border-radius: 12px;
        background: #fff;
        border: 1px solid #eee;
    }

    .stat-value {
        font-size: 1.8rem;
        font-weight: bold;
    }

    .stat-change {
        font-size: 0.8rem;
    }

    .positive {
        color: green;
    }

    .warning {
        color: orange;
    }

    .danger {
        color: red;
    }

    .dashboard-section {
        background: white;
        padding: 1rem;
        border-radius: 12px;
        margin-bottom: 1rem;
        border: 1px solid #eee;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 10px;
        border-bottom: 1px solid #eee;
        text-align: left;
    }

    th {
        background: #f8f9fa;
    }

    .badge {
        padding: 4px 8px;
        border-radius: 6px;
        color: white;
        font-size: 12px;
    }

    .ok {
        background: green;
    }

    .low {
        background: orange;
    }

    .critical {
        background: red;
    }

    .rank {
        background: #2563eb;
        color: white;
        padding: 4px 8px;
        border-radius: 50%;
    }

    .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .loading-spinner {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 200px;
        gap: 10px;
    }

    .spinner {
        border: 3px solid #f3f3f3;
        border-top: 3px solid #2563eb;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        animation: spin 1s linear infinite;
    }

    .error-message {
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
        color: #721c24;
        padding: 12px;
        border-radius: 6px;
        margin-bottom: 1rem;
    }
</style>

<div class="dashboard-container">

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="error-message">
            ⚠️ @ErrorMessage
        </div>
    }

    <!-- KPI -->
    @if (IsLoading)
    {
        <div class="loading-spinner">
            <div class="spinner"></div>
            <span>Loading dashboard...</span>
        </div>
    }
    else
    {
        <div class="stats-grid">
            <div class="stat-card">
                <div>Total Matériel</div>
                <div class="stat-value">@DashboardStats?.TotalMaterials</div>
                <div class="stat-change positive">Live Data</div>
            </div>

            <div class="stat-card">
                <div>Assignments</div>
                <div class="stat-value">@DashboardStats?.TotalAssignments</div>
                <div class="stat-change warning">Active</div>
            </div>

            <div class="stat-card">
                <div>Pending Requests</div>
                <div class="stat-value">@DashboardStats?.PendingRequests</div>
                <div class="stat-change @(DashboardStats?.PendingRequests > 5 ? "danger" : "positive")">@(DashboardStats?.PendingRequests > 5 ? "Attention" : "OK")</div>
            </div>
        </div>

        <!-- TOP 3 -->
        <div class="dashboard-section">
            <h3>🏆 Top 3 Matériels</h3>

            @if (TopMaterials?.Count == 0)
            {
                <p>No materials found.</p>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Nom</th>
                            <th>Type</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in TopMaterials?.Select((m, i) => new { Material = m, Index = i }) ?? Enumerable.Empty<dynamic>())
                        {
                            <tr>
                                <td><span class="rank">@(item.Index + 1)</span></td>
                                <td>@item.Material.MaterielName</td>
                                <td>@item.Material.Type</td>
                                <td>@item.Material.Total</td>
                                <td>
                                    <span class="badge @item.Material.StatusBadge.ToLower()">@item.Material.StatusBadge</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- INVENTAIRE -->
        <div class="dashboard-section">
            <h3>📦 Inventaire complet</h3>

            @if (Inventory?.Count == 0)
            {
                <p>No inventory found.</p>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Matériel</th>
                            <th>Type</th>
                            <th>IT</th>
                            <th>PDR</th>
                            <th>Total</th>
                            <th>État</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Inventory ?? new List<DashboardMaterialItemDto>())
                        {
                            <tr>
                                <td>@m.MaterielName</td>
                                <td>@m.Type</td>
                                <td>@m.QuantityITStock</td>
                                <td>@m.QuantityPDRStock</td>
                                <td><b>@m.Total</b></td>
                                <td>
                                    <span class="badge @m.StatusBadge.ToLower()">@m.StatusBadge</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- CHART SIMPLE -->
        <div class="dashboard-section">
            <h3>📊 Assignments mensuels</h3>

            <div class="grid-2">
                <div>
                    @foreach (var m in MonthlyData ?? new List<MonthlyAssignmentDto>())
                    {
                        <div style="margin-bottom:8px;">
                            <b>@m.Month</b>
                            <div style="background:#eee;height:10px;border-radius:5px;">
                                <div style="width:@(m.Value * 5)px ;background:#2563eb;height:10px;border-radius:5px;"></div>
                            </div>
                        </div>
                    }
                </div>

                <div>
                    <h4>Total: @(MonthlyData?.Sum(x => x.Value) ?? 0)</h4>
                    <p>📈 Analyse des tendances en direct</p>
                </div>
            </div>
        </div>
    }

</div>

@code {

    private DashboardStatsDto? DashboardStats;
    private List<DashboardMaterialItemDto>? TopMaterials;
    private List<DashboardMaterialItemDto>? Inventory;
    private List<MonthlyAssignmentDto>? MonthlyData;

    private bool IsLoading = true;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;

            // Fetch all dashboard data in parallel
            var statsTask = Http.GetFromJsonAsync<DashboardStatsDto>("/api/v1/dashboard/stats");
            var topMaterialsTask = Http.GetFromJsonAsync<List<DashboardMaterialItemDto>>("/api/v1/dashboard/top-materials");
            var inventoryTask = Http.GetFromJsonAsync<List<DashboardMaterialItemDto>>("/api/v1/dashboard/inventory");
            var monthlyTask = Http.GetFromJsonAsync<List<MonthlyAssignmentDto>>("/api/v1/dashboard/assignments-monthly");

            await Task.WhenAll(statsTask, topMaterialsTask, inventoryTask, monthlyTask);

            DashboardStats = await statsTask;
            TopMaterials = await topMaterialsTask;
            Inventory = await inventoryTask;
            MonthlyData = await monthlyTask;
        }
        catch (HttpRequestException ex)
        {
            ErrorMessage = $"Network error: {ex.Message}. Please check your connection.";
            NotificationService.Notify(new NotificationMessage()
            {
                Severity = NotificationSeverity.Error,
                Summary = "Dashboard Error",
                Detail = ErrorMessage,
                Duration = 5000
            });
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to load dashboard data: {ex.Message}";
            NotificationService.Notify(new NotificationMessage()
            {
                Severity = NotificationSeverity.Error,
                Summary = "Dashboard Error",
                Detail = ErrorMessage,
                Duration = 5000
            });
        }
        finally
        {
            IsLoading = false;
        }
    }
}