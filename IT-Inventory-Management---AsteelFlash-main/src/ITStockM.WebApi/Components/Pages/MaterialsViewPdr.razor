@page "/materials-view-interface-pdr"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,PDR,Purchasing")]

<PageTitle>Materials View (PDR) - IT Stock Management</PageTitle>

<div class="page-container">
    <div class="page-header">
        <h1>Materials View - PDR</h1>
        <p class="page-subtitle">PDR-specific materials inventory</p>
    </div>
    
    <div class="page-content">
        <div class="content-placeholder">
            <RadzenIcon Icon="inventory" Style="font-size: 48px; opacity: 0.5;" />
            <h2>PDR Materials Inventory</h2>
            <p>View materials from the PDR (Préparation des Retours) perspective.</p>
            <p style="color: var(--text-secondary); font-size: 0.9rem;">Coming soon: PDR-specific inventory and distribution.</p>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        // Placeholder for future PDR component logic
    }
