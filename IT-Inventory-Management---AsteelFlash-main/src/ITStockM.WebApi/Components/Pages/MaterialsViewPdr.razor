@page "/materials-view-interface-pdr"
@using ITStockM.Domain.Entities
@using ITStockM.Services.Assignments
@using ITStockM.Services.Materiels
@using ITStockM.Services.Employees
@using ITStockM.Services.Projects
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,IT,Infrastructure,Employee")]
@inject IAssignmentService AssignmentService
@inject IMaterielService MaterielService
@inject IEmployeeService EmployeeService
@inject IProjectService ProjectService
@inject NotificationService NotificationService

<PageTitle>Assignment Standby - IT Stock Management</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div class="flex-between page-header-wrap">
            <div>
                <h1>Assignment Standby</h1>
                <p class="page-subtitle">Materials assigned and waiting — not yet deployed on mission.</p>
            </div>
        </div>
    </div>

    <div class="grid-3">
        <div class="content-section metric-card">
            <span class="metric-label">Standby Assignments</span>
            <span class="metric-value">@standbyRows.Count</span>
        </div>
        <div class="content-section metric-card">
            <span class="metric-label">Total Items Waiting</span>
            <span class="metric-value">@standbyRows.Sum(r => r.TotalQty)</span>
        </div>
        <div class="content-section metric-card">
            <span class="metric-label">With Return Deadline</span>
            <span class="metric-value text-warning">@standbyRows.Count(r => r.RestoreDateLimit.HasValue)</span>
        </div>
    </div>

    @if (loadError is not null)
    {
        <div class="alert alert-danger">@loadError</div>
    }

    <div class="content-section">
        <div class="filters-bar">
            <input class="search-input" placeholder="Search by person, project or material…"
                   @bind="searchText" @bind:event="oninput" />
        </div>

        @if (isLoading)
        {
            <div class="loading-spinner"><span class="material-icons rotating">autorenew</span> Loading…</div>
        }
        else if (filteredRows.Count == 0)
        {
            <div class="empty-state">
                <span class="material-icons">hourglass_empty</span>
                <p>No standby assignments found.</p>
            </div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Assigned To</th>
                        <th>Project</th>
                        <th>Materials</th>
                        <th>Return Deadline</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in filteredRows)
                    {
                        <tr>
                            <td>@row.Date.ToString("dd/MM/yyyy")</td>
                            <td>@(row.AssignedToName ?? "—")</td>
                            <td>@(row.ProjectName ?? "—")</td>
                            <td>
                                @foreach (var item in row.MaterialLines)
                                {
                                    <span class="badge-chip">@item.MaterialName × @item.Qty</span>
                                }
                            </td>
                            <td>
                                @if (row.RestoreDateLimit.HasValue)
                                {
                                    <span class="@(row.RestoreDateLimit < DateTime.Today ? "text-danger" : "text-warning")">
                                        @row.RestoreDateLimit.Value.ToString("dd/MM/yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(row.Description) ? "—" : row.Description)</td>
                            <td>
                                <RadzenButton Icon="rocket_launch"
                                              Text="Deploy"
                                              ButtonStyle="ButtonStyle.Success"
                                              Shade="Shade.Lighter"
                                              Size="ButtonSize.Small"
                                              Click="@(() => OpenDeployModal(row))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (showDeployModal && deployTarget is not null)
{
    <div class="modal-overlay" @onclick="CloseDeployModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Deploy Assignment</h2>
                <button type="button" class="modal-close" @onclick="CloseDeployModal">×</button>
            </div>
            <p>
                Mark assignment for <strong>@(deployTarget.AssignedToName ?? deployTarget.ProjectName ?? "this assignment")</strong> as <em>On Mission</em>?
            </p>
            <p class="text-muted">This will set <strong>OnMission = true</strong> and remove it from Standby.</p>
            @if (deployError is not null)
            {
                <div class="alert alert-danger">@deployError</div>
            }
            <div class="form-actions">
                <RadzenButton Icon="rocket_launch"
                              Text="Confirm Deploy"
                              ButtonStyle="ButtonStyle.Success"
                              Shade="Shade.Lighter"
                              Click="@DeployAssignmentAsync" />
                <RadzenButton Icon="cancel"
                              Text="Cancel"
                              ButtonStyle="ButtonStyle.Light"
                              Shade="Shade.Lighter"
                              Click="@CloseDeployModal" />
            </div>
        </div>
    </div>
}

@code {
    private List<StandbyRow> standbyRows = [];
    private List<StandbyRow> filteredRows = [];

    private bool isLoading = true;
    private bool showDeployModal;

    private string searchText = string.Empty;
    private string? loadError;
    private string? deployError;

    private StandbyRow? deployTarget;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            var assignments = (await AssignmentService.GetAssignments()).ToList();
            var materiels = (await MaterielService.GetMateriels()).ToList();
            var employees = (await EmployeeService.GetEmployees()).ToList();
            var projects = (await ProjectService.GetProjects()).ToList();

            standbyRows = assignments
                .Where(a => !a.OnMission && a.RestoreDate == null)
                .Select(a =>
                {
                    var empName = a.AssignedTo.HasValue
                        ? employees.FirstOrDefault(e => e.Id == a.AssignedTo)?.FullName
                        : null;
                    var projName = a.ProjectId.HasValue
                        ? projects.FirstOrDefault(p => p.Id == a.ProjectId)?.ProjectName
                        : null;
                    var lines = (a.AssignmentMateriels ?? [])
                        .Select(am =>
                        {
                            var mat = materiels.FirstOrDefault(m => m.Id == am.MaterielId);
                            return new MaterialLine(mat?.MaterielName ?? $"ID {am.MaterielId}", am.Qte);
                        })
                        .ToList();
                    return new StandbyRow(
                        a.Id,
                        a.Date,
                        empName,
                        projName,
                        lines,
                        a.RestoreDateLimit,
                        a.Descipriton);
                })
                .OrderBy(r => r.RestoreDateLimit ?? DateTime.MaxValue)
                .ThenBy(r => r.Date)
                .ToList();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load standby assignments: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredRows = [.. standbyRows];
            return;
        }

        var term = searchText.Trim();
        filteredRows = standbyRows
            .Where(r =>
                Contains(r.AssignedToName, term) ||
                Contains(r.ProjectName, term) ||
                r.MaterialLines.Any(m => Contains(m.MaterialName, term)) ||
                Contains(r.Description, term))
            .ToList();
    }

    private void OpenDeployModal(StandbyRow row)
    {
        deployTarget = row;
        deployError = null;
        showDeployModal = true;
    }

    private void CloseDeployModal()
    {
        showDeployModal = false;
        deployTarget = null;
        deployError = null;
    }

    private async Task DeployAssignmentAsync()
    {
        if (deployTarget is null) return;

        try
        {
            var assignment = await AssignmentService.GetAssignmentById(deployTarget.Id);
            if (assignment is null)
            {
                deployError = "Assignment not found.";
                return;
            }

            assignment.OnMission = true;
            await AssignmentService.UpdateAssignment(assignment.Id, assignment);

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Deployed",
                Detail = "Assignment is now marked as On Mission.",
                Duration = 3000
            });

            CloseDeployModal();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            deployError = $"Failed to deploy: {ex.Message}";
        }
    }

    private static bool Contains(string? source, string term) =>
        !string.IsNullOrWhiteSpace(source) &&
        source.Contains(term, StringComparison.OrdinalIgnoreCase);

    private sealed record MaterialLine(string MaterialName, int Qty);

    private sealed record StandbyRow(
        int Id,
        DateTime Date,
        string? AssignedToName,
        string? ProjectName,
        List<MaterialLine> MaterialLines,
        DateTime? RestoreDateLimit,
        string Description)
    {
        public int TotalQty => MaterialLines.Sum(m => m.Qty);
    }
}
