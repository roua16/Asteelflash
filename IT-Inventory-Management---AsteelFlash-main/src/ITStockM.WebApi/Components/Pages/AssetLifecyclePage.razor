@page "/asset-lifecycle"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,IT,Infrastructure")]

<PageTitle>Asset Lifecycle - IT Stock Management</PageTitle>

<div class="page-container">
    <div class="page-header">
        <h1>Asset Lifecycle Tracker</h1>
        <p class="page-subtitle">Track asset stages from purchase to retirement</p>
    </div>
    
    <div class="page-content">
        <div class="content-placeholder">
            <RadzenIcon Icon="autorenew" Style="font-size: 48px; opacity: 0.5;" />
            <h2>Lifecycle Management</h2>
            <p>Monitor asset status through all lifecycle stages.</p>
            <p style="color: var(--text-secondary); font-size: 0.9rem;">Coming soon: Lifecycle transitions, history, and stage analytics.</p>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        // Placeholder for future lifecycle component logic
    }
}
