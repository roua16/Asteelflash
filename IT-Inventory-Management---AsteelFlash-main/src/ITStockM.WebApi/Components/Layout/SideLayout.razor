<RadzenHeader class="app-header">
    <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="0" class="header-row">
        <RadzenColumn Size="8" SizeMD="6" class="header-left">
            <button type="button" class="sidebar-toggle-shell" @onclick="SidebarToggleClick" aria-label="Toggle navigation">
                <RadzenIcon Icon="@(sidebarExpanded ? "menu_open" : "menu")" />
            </button>
            <div class="header-brand">
                <span class="header-brand-kicker">AsteelFlash Inventory</span>
                <span class="header-brand-title">Operations Console</span>
            </div>
        </RadzenColumn>

        <RadzenColumn Size="4" SizeMD="6" class="header-right">
            <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.75rem" class="header-controls">
                <span class="user-greeting user-chip">@user</span>

                <ThemeToggle Class="header-theme-toggle" />

                <a href="/logout" class="logout-link" aria-label="Logout">
                    <RadzenButton
                        ButtonStyle="ButtonStyle.Light"
                        Icon="logout"
                        Size="ButtonSize.Medium"
                        Shade="Shade.Lighter"
                        Variant="Variant.Flat"
                        class="header-action-btn" />
                </a>
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
</RadzenHeader>

<RadzenSidebar @bind-Expanded="@sidebarExpanded" class="@($"app-sidebar {(sidebarExpanded ? "sidebar-expanded" : "sidebar-collapsed")} {(IsDarkTheme ? "sidebar-theme-dark" : "sidebar-theme-light")}")" style="z-index: 2;">
    <div class="sidebar-top">
        <div class="sidebar-brand-mark">
            <img src="images/logoiconAsteel.png" alt="AsteelFlash" class="sidebar-brand-logo" />
        </div>
        @if (sidebarExpanded)
        {
                <div class="sidebar-brand-copy">
                    <div class="sidebar-kicker">AsteelFlash</div>
                    <h1 class="sidebar-title">Inventory Control</h1>
                    <p class="sidebar-subtitle">Command center for IT operations</p>
                </div>
        }
    </div>

    <nav class="sidebar-scroll" aria-label="Main navigation">
        <div class="menu-group @MenuGroupStateClass(coreExpanded)">
            <button type="button" class="menu-group-toggle" aria-expanded="@coreExpanded" @onclick='() => ToggleMenuGroup("core")' disabled="@(!sidebarExpanded)">
                <span class="menu-group-meta">
                    <span class="menu-group-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 10.5L12 3l9 7.5" />
                            <path d="M5 9.5V20h14V9.5" />
                        </svg>
                    </span>
                    @if (sidebarExpanded)
                    {
                        <span class="menu-group-title">CORE</span>
                    }
                </span>
                @if (sidebarExpanded)
                {
                    <span class="menu-group-chevron"><RadzenIcon Icon="@(coreExpanded ? "expand_less" : "expand_more")" /></span>
                }
            </button>
            <div class="menu-links">
                <SidebarItem Roles="Admin,PDR,Purchasing,IT,Infrastructure,Employee" Text="Dashboard" Icon="dashboard" Path="/" Compact="@(!sidebarExpanded)" Exact="true" />
            </div>
        </div>

        <div class="menu-group @MenuGroupStateClass(inventoryExpanded)">
            <button type="button" class="menu-group-toggle" aria-expanded="@inventoryExpanded" @onclick='() => ToggleMenuGroup("inventory")' disabled="@(!sidebarExpanded)">
                <span class="menu-group-meta">
                    <span class="menu-group-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3.5 8.5L12 4l8.5 4.5L12 13z" />
                            <path d="M3.5 8.5V16L12 20l8.5-4V8.5" />
                        </svg>
                    </span>
                    @if (sidebarExpanded)
                    {
                        <span class="menu-group-title">INVENTORY</span>
                    }
                </span>
                @if (sidebarExpanded)
                {
                    <span class="menu-group-chevron"><RadzenIcon Icon="@(inventoryExpanded ? "expand_less" : "expand_more")" /></span>
                }
            </button>
            <div class="menu-links">
                <SidebarItem Roles="Admin,Purchasing,IT" Text="Materials View" Icon="inventory_2" Path="/materials-view-interface" Compact="@(!sidebarExpanded)" />
                <SidebarItem Roles="Admin,IT,Infrastructure,Employee" Text="Materials Assignments" Icon="assignment" Path="/assignments-interface" Compact="@(!sidebarExpanded)" />
                <SidebarItem Roles="Admin,PDR,Purchasing" Text="Materials View (PDR)" Icon="inventory" Path="/materials-view-interface-pdr" Compact="@(!sidebarExpanded)" />
            </div>
        </div>

        <div class="menu-group @MenuGroupStateClass(lifecycleExpanded)">
            <button type="button" class="menu-group-toggle" aria-expanded="@lifecycleExpanded" @onclick='() => ToggleMenuGroup("lifecycle")' disabled="@(!sidebarExpanded)">
                <span class="menu-group-meta">
                    <span class="menu-group-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4v6h6" />
                            <path d="M20 20v-6h-6" />
                            <path d="M20 10a8 8 0 0 0-13.66-5.66L4 6" />
                            <path d="M4 14a8 8 0 0 0 13.66 5.66L20 18" />
                        </svg>
                    </span>
                    @if (sidebarExpanded)
                    {
                        <span class="menu-group-title">ASSET LIFECYCLE</span>
                    }
                </span>
                @if (sidebarExpanded)
                {
                    <span class="menu-group-chevron"><RadzenIcon Icon="@(lifecycleExpanded ? "expand_less" : "expand_more")" /></span>
                }
            </button>
            <div class="menu-links">
                <SidebarItem Roles="Admin,IT,Infrastructure" Text="Lifecycle Tracker" Icon="autorenew" Path="/asset-lifecycle" Compact="@(!sidebarExpanded)" />
                <SidebarItem Roles="Admin,IT,Infrastructure" Text="Maintenance Tickets" Icon="build" Path="/maintenance" Compact="@(!sidebarExpanded)" />
                <SidebarItem Roles="Admin,IT,Infrastructure" Text="Health Predictions" Icon="monitoring" Path="/asset-predictions" Compact="@(!sidebarExpanded)" />
                <SidebarItem Roles="Admin,IT,Infrastructure" Text="Infrastructure" Icon="memory" Path="/infra-interface" Compact="@(!sidebarExpanded)" />
            </div>
        </div>

        <div class="menu-group @MenuGroupStateClass(purchasingExpanded)">
            <button type="button" class="menu-group-toggle" aria-expanded="@purchasingExpanded" @onclick='() => ToggleMenuGroup("purchasing")' disabled="@(!sidebarExpanded)">
                <span class="menu-group-meta">
                    <span class="menu-group-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="20" r="1.5" />
                            <circle cx="18" cy="20" r="1.5" />
                            <path d="M3 4h2l2.4 10.5a1 1 0 0 0 .98.78h9.6a1 1 0 0 0 .98-.8L21 7H7" />
                        </svg>
                    </span>
                    @if (sidebarExpanded)
                    {
                        <span class="menu-group-title">PURCHASING</span>
                    }
                </span>
                @if (sidebarExpanded)
                {
                    <span class="menu-group-chevron"><RadzenIcon Icon="@(purchasingExpanded ? "expand_less" : "expand_more")" /></span>
                }
            </button>
            <div class="menu-links">
                <SidebarItem Roles="Admin,Purchasing" Text="Purchase Requests" Icon="shopping_cart" Path="/purchase-page" Compact="@(!sidebarExpanded)" />
                <SidebarItem Roles="Admin,Purchasing,PDR" Text="Suppliers" Icon="storefront" Path="/suppliers" Compact="@(!sidebarExpanded)" />
                <SidebarItem Roles="Admin,Purchasing,PDR" Text="Add Delivery Orders" Icon="add_circle" Path="/delivery-order" Compact="@(!sidebarExpanded)" />
                <SidebarItem Roles="Admin,Purchasing,PDR" Text="Pending Deliveries" Icon="local_shipping" Path="/pending-deliveries" Compact="@(!sidebarExpanded)" />
                <SidebarItem Roles="Admin,Purchasing,PDR" Text="D.O History" Icon="history" Path="/delivery-order-history" Compact="@(!sidebarExpanded)" BadgeCount="@orderNumbersNF" OnClick="ForceRefresh" />
            </div>
        </div>

        <AuthorizeView Roles="Admin,Purchasing">
            <Authorized>
                <div class="menu-group @MenuGroupStateClass(archivesExpanded)">
                    <button type="button" class="menu-group-toggle" aria-expanded="@archivesExpanded" @onclick='() => ToggleMenuGroup("archives")' disabled="@(!sidebarExpanded)">
                        <span class="menu-group-meta">
                            <span class="menu-group-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="4" y="4" width="16" height="4" rx="1" />
                                    <path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8" />
                                    <path d="M10 12h4" />
                                </svg>
                            </span>
                            @if (sidebarExpanded)
                            {
                                <span class="menu-group-title">ARCHIVES</span>
                            }
                        </span>
                        @if (sidebarExpanded)
                        {
                            <span class="menu-group-chevron"><RadzenIcon Icon="@(archivesExpanded ? "expand_less" : "expand_more")" /></span>
                        }
                    </button>
                    <div class="menu-links">
                        <SidebarItem Text="Archived Requests" Icon="archive" Path="/archived-requests-page" Compact="@(!sidebarExpanded)" />
                        <SidebarItem Roles="Admin" Text="Archived Assignments" Icon="inventory_2" Path="/assignments-archive" Compact="@(!sidebarExpanded)" />
                        <SidebarItem Roles="Admin" Text="Archived Missions" Icon="event_repeat" Path="/archived-missions" Compact="@(!sidebarExpanded)" />
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="menu-group @MenuGroupStateClass(adminExpanded)">
                    <button type="button" class="menu-group-toggle" aria-expanded="@adminExpanded" @onclick='() => ToggleMenuGroup("admin")' disabled="@(!sidebarExpanded)">
                        <span class="menu-group-meta">
                            <span class="menu-group-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 3l2 3.2 3.7.6-2.4 2.6.6 3.6-3.9-1.7-3.9 1.7.6-3.6-2.4-2.6 3.7-.6z" />
                                    <path d="M5 14v5h14v-5" />
                                </svg>
                            </span>
                            @if (sidebarExpanded)
                            {
                                <span class="menu-group-title">ADMINISTRATION</span>
                            }
                        </span>
                        @if (sidebarExpanded)
                        {
                            <span class="menu-group-chevron"><RadzenIcon Icon="@(adminExpanded ? "expand_less" : "expand_more")" /></span>
                        }
                    </button>
                    <div class="menu-links">
                        <SidebarItem Text="Materials" Icon="category" Path="/materiels-super-admin" Compact="@(!sidebarExpanded)" />
                        <SidebarItem Text="Assignments" Icon="assignment_turned_in" Path="/assignments-super-admin" Compact="@(!sidebarExpanded)" />
                        <SidebarItem Text="Assignment Materials" Icon="assignment_late" Path="/assignment-materiels-super-admin" Compact="@(!sidebarExpanded)" />
                        <SidebarItem Text="Delivery Orders" Icon="receipt_long" Path="/delivery-orders-super-admin" Compact="@(!sidebarExpanded)" />
                        <SidebarItem Text="Delivery Orders Mats" Icon="receipt" Path="/delivery-order-materiels-super-admin" Compact="@(!sidebarExpanded)" />
                        <SidebarItem Text="Requests" Icon="description" Path="/requests-super-admin" Compact="@(!sidebarExpanded)" />
                        <SidebarItem Text="Employees" Icon="people" Path="/employees-super-admin" Compact="@(!sidebarExpanded)" />
                        <SidebarItem Text="Offers" Icon="local_offer" Path="/offers-super-admin" Compact="@(!sidebarExpanded)" />
                        <SidebarItem Text="Projects" Icon="work" Path="/projects-super-admin" Compact="@(!sidebarExpanded)" />
                        <SidebarItem Text="Suppliers" Icon="store" Path="/suppliers-super-admin" Compact="@(!sidebarExpanded)" />
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>

    <div class="footer-container">
        @if (sidebarExpanded)
        {
            <p class="footer-line">Inventory Suite v1.0.0</p>
            <p class="footer-line">AsteelFlash</p>
        }
        else
        {
            <span class="footer-dot" aria-hidden="true"></span>
        }
    </div>
</RadzenSidebar>
