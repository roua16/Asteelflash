@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web

@if (string.IsNullOrWhiteSpace(Roles))
{
    <NavLink href="@Path" Match="@MatchMode" class="sidebar-link" title="@Text" @onclick="OnClick">
        <span class="sidebar-link-icon" aria-hidden="true">
            <RadzenIcon Icon="@Icon" />
        </span>
        @if (!Compact)
        {
            <span class="sidebar-link-label">@Text</span>
        }
        else
        {
            <span class="sr-only">@Text</span>
        }
        @if (BadgeCount > 0 && !Compact)
        {
            <span class="sidebar-link-badge">@BadgeCount</span>
        }
    </NavLink>
}
else
{
    <AuthorizeView Roles="@Roles">
        <Authorized>
            <NavLink href="@Path" Match="@MatchMode" class="sidebar-link" title="@Text" @onclick="OnClick">
                <span class="sidebar-link-icon" aria-hidden="true">
                    <RadzenIcon Icon="@Icon" />
                </span>
                @if (!Compact)
                {
                    <span class="sidebar-link-label">@Text</span>
                }
                else
                {
                    <span class="sr-only">@Text</span>
                }
                @if (BadgeCount > 0 && !Compact)
                {
                    <span class="sidebar-link-badge">@BadgeCount</span>
                }
            </NavLink>
        </Authorized>
    </AuthorizeView>
}

@code {
    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Icon { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Path { get; set; } = string.Empty;

    [Parameter]
    public string? Roles { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public bool Exact { get; set; }

    [Parameter]
    public int BadgeCount { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    private NavLinkMatch MatchMode => Exact ? NavLinkMatch.All : NavLinkMatch.Prefix;
}
