@inherits LayoutComponentBase

<RadzenComponents />
@if (NavigationManager.Uri.Contains("access-denied"))
{
    <ITStockM.Components.Pages.auth.AccessDenied />
}
else
{
    <AuthorizeView>
        <Authorized>
            <RadzenLayout class="app-shell">
                <SideLayout />
                <RadzenBody class="app-body">
                    <div class="app-content-shell">
                        @Body
                    </div>
                </RadzenBody>
            </RadzenLayout>
        </Authorized>
        <NotAuthorized>
            <ITStockM.Components.Pages.auth.Login />
        </NotAuthorized>
    </AuthorizeView>
}


