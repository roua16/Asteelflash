<PageTitle>Pending Deliveries Details</PageTitle>

<div class="container-fluid py-4 pending-deliveries-details-page">
    <RadzenRow>
        <RadzenColumn Size="12" SizeLG="10" OffsetLG="1">
            <RadzenCard class="rz-shadow-3 p-0 m-0 details-shell-card">

                <div class=" p-4">
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Start" Gap="0.5rem">
                                <RadzenText TextStyle="TextStyle.Overline" class="rz-color-text-tertiary overline-spaced">For</RadzenText>
                                <RadzenText TextStyle="TextStyle.H5" Class="heading-name">@request.Employee.FullName</RadzenText>
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4" Class="status-column">
                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" AlignItems="AlignItems.End">
                                <RadzenBadge Shade="Shade.Lighter"
                                             BadgeStyle="@GetStatusStyle(request.Status)"
                                             Class="status-badge"
                                             Text="@request.Status" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </div>

                <div class="p-4">
                    <RadzenStack Gap="2rem" Orientation="Orientation.Vertical">
                      



                        <RadzenStack Gap="1rem" Orientation="Orientation.Vertical">

                            <RadzenCard class="rz-shadow-1 detail-card-primary">
                                <RadzenRow>

                                    <RadzenColumn Size="10" SizeSM="10">
                                        <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                                            <RadzenText TextStyle="TextStyle.Overline" class="rz-color-text-tertiary text-medium">TITLE</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Body1" Class="text-semibold">@request.Title</RadzenText>
                                        </RadzenStack>
                                    </RadzenColumn>
                                    
                                        
                                            <RadzenColumn Size="6" SizeSM="3">
                                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                                                    <RadzenText TextStyle="TextStyle.Overline" class="rz-color-text-tertiary text-medium">MAT TYPE</RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body1">@request.MaterialType</RadzenText>
                                                </RadzenStack>
                                            </RadzenColumn>
                                   
                                        <RadzenColumn Size="6" SizeSM="4">
                                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                                                <RadzenText TextStyle="TextStyle.Overline" class="rz-color-text-tertiary text-medium">DATE</RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body1">@(request.Date.ToString("MMMM dd, yyyy"))</RadzenText>
                                            </RadzenStack>
                                        </RadzenColumn>
                                    
                                    <RadzenColumn Size="6" SizeSM="10">
                                        <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                                            <RadzenText TextStyle="TextStyle.Overline" class="rz-color-text-tertiary text-medium">DESCRIPTION</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Body1" >@request.Description</RadzenText>
                                        </RadzenStack>
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenCard>

                        </RadzenStack>

                        <div>
                            <RadzenText TextStyle="TextStyle.H6" Class="section-title">Selected Offer</RadzenText>

                           
                                <RadzenStack Gap="1rem" Orientation="Orientation.Vertical">
                                  
                                        <RadzenCard class="rz-shadow-1 detail-card-primary">
                                            <RadzenRow>
                                              
                                                <RadzenColumn Size="10" SizeSM="4">
                                                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                                                        <RadzenText TextStyle="TextStyle.Overline" class="rz-color-text-tertiary text-medium">SUPPLIER</RadzenText>
                                                        <RadzenText TextStyle="TextStyle.Body1" Class="text-medium">@offer.SupplierName</RadzenText>
                                                    </RadzenStack>
                                                </RadzenColumn>
                                                <RadzenColumn Size="6" SizeSM="4">
                                                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                                                        <RadzenText TextStyle="TextStyle.Overline" class="rz-color-text-tertiary text-medium">DELIVERY DATE</RadzenText>
                                                        <RadzenText TextStyle="TextStyle.Body1">@(offer.DeliveryDate.ToString("MMM dd, yyyy"))</RadzenText>
                                                    </RadzenStack>
                                                </RadzenColumn>
                                                <RadzenColumn Size="6" SizeSM="3">
                                                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                                                        <RadzenText TextStyle="TextStyle.Overline" class="rz-color-text-tertiary text-medium">PRICE</RadzenText>
                                                        <RadzenText TextStyle="TextStyle.Body1" class="rz-color-primary-dark text-semibold">@offer.Price.ToString()</RadzenText>
                                                    </RadzenStack>
                                                </RadzenColumn>
                                            </RadzenRow>
                                        </RadzenCard>
                                    
                                </RadzenStack>

                 
                      
                        </div>

                        @if (request.File != null)
                        {
                            <div class="d-flex justify-content-end">
                                <RadzenButton Click=@(() => DownloadFile(request))
                                              ButtonStyle="ButtonStyle.Light"
                                              class="rz-border rz-shadow-0 attachment-button">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                        <RadzenImage Path="images/attach1.png" Class="attachment-icon" />
                                        <RadzenText TextStyle="TextStyle.Body1">Download Attachment : @request.FileName</RadzenText>
                                    </RadzenStack>
                                </RadzenButton>
                            </div>
                        }
                    </RadzenStack>
                </div>


            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
</div>
