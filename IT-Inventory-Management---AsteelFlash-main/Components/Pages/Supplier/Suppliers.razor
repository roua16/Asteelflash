@page "/suppliers"
@using ITStockM.Models.ITStockManagment


<AuthorizeView Roles="SuperAdmin,  Purchasing, PDR">
    <Authorized>
        <PageTitle>Suppliers</PageTitle>

        <div class="container-fluid py-4">
            <RadzenCard class="mb-4 rz-shadow-2" Style="border-radius: 12px; border: none;">
                <!-- Header Section -->
                <RadzenRow AlignItems="AlignItems.Center" class="mb-4">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText Text="Suppliers"
                                    TextStyle="TextStyle.H3"
                                    TagName="TagName.H1"
                                    Style="margin: 0; text-transform: uppercase; font-weight: 600; letter-spacing: 1px; margin-bottom:25px;" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6" Class="d-flex justify-content-md-end mt-3 mt-md-0">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="1rem">
                            <RadzenSplitButton ButtonStyle="ButtonStyle.Light"
                                               Icon="download"
                                               Text="Export"
                                               Click="@ExportClick"
                                               Style="border-radius: 8px;">
                                <RadzenSplitButtonItem Text="Excel" Value="xlsx" Icon="table_view" />
                                <RadzenSplitButtonItem Text="CSV" Value="csv" Icon="description" />
                            </RadzenSplitButton>
                            <RadzenButton Text="Add Supplier"
                                          Click="@AddButtonClick"
                                          ButtonStyle="ButtonStyle.Light" Icon="add_circle" Size="ButtonSize.Medium"
                                          Shade="Shade.Lighter" Variant="Variant.Flat" Style="border-radius:8px;" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>

                <!-- Search Box -->
                <RadzenRow class="mb-4">
                    <RadzenColumn Size="12">
                        <div class="position-relative">
                            <RadzenTextBox Placeholder="🔍 Search suppliers..."
                                           @oninput="@Search"
                                           aria-label="Search by all string columns"
                                           Style="display: block;width: 100%;padding: 10px;border: 1px solid #ccc;border-radius: 8px; box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);"
                                           Icon="find_in_page" />
                            <i class="rzi rzi-search position-absolute" style="left: 0.75rem; top: 50%; transform: translateY(-50%);"></i>
                        </div>
                    </RadzenColumn>
                </RadzenRow>

                <!-- Data Grid -->
                <RadzenDataGrid @ref="grid0"
                                AllowFiltering="true"
                                FilterMode="FilterMode.Advanced"
                                AllowPaging="true"
                                AllowSorting="true"
                                PageSize="10"
                                ShowPagingSummary="true"
                                PageSizeOptions="@(new int[]{5, 10, 20, 30})"
                                Data="@suppliers"
                                TItem="ITStockM.Models.ITStockManagment.Supplier"
                                Style="border-radius: 10px; overflow: hidden; border: none;"
                                EmptyText="No suppliers found"
                                RowDoubleClick="@EditRow">
                    <Columns>
                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Supplier" Property="SupplierName" Title="Supplier Name" Width="200px">
                            <Template Context="supplier">
                                <div class="d-flex align-items-center">
                                    <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 500;">@supplier.SupplierName</RadzenText>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Supplier" Property="Adress" Title="Address" Width="200px">
                            <Template Context="supplier">
                                <div class="d-flex align-items-center">
                                    <span>@supplier.Adress</span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Supplier" Property="Email" Title="Email" Width="200px">
                            <Template Context="supplier">
                                <div class="d-flex align-items-center">
                                    <a href="mailto:@supplier.Email" style=" text-decoration: none;">
                                        @supplier.Email
                                    </a>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Supplier" Property="PhoneNumber" Title="Phone Number" Width="150px">
                            <Template Context="supplier">
                                <div class="d-flex align-items-center">
                                    <a href="tel:@supplier.PhoneNumber" style=" text-decoration: none;">
                                        @supplier.PhoneNumber
                                    </a>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>



                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Supplier" Filterable="false" Sortable="false" Width="120px" TextAlign="TextAlign.Center" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                            <Template Context="supplier">
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.5rem">
                                    <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                                  Icon="delete"
                                                  Size="ButtonSize.Medium"
                                                  Style="border-radius: 8px;"
                                                  Shade="Shade.Lighter"
                                                  Variant="Variant.Flat"
                                                  Title="Delete Supplier"
                                                  Click="@(args => GridDeleteButtonClick(args, supplier))"
                                                  @onclick:stopPropagation="true" />
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                    <EmptyTemplate>
                        <div class="d-flex flex-column align-items-center justify-content-center py-5">
                            <i class="rzi rzi-business mb-3" style="font-size: 3rem; opacity: 0.5;"></i>
                            <RadzenText TextStyle="TextStyle.H6">No suppliers found</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" class="rz-color-text-secondary">Try adjusting your search or filters</RadzenText>
                            <RadzenButton Text="Add Supplier"
                                          Click="@AddButtonClick"
                                          ButtonStyle="ButtonStyle.Light" Icon="add_circle" Size="ButtonSize.Medium"
                                          Shade="Shade.Lighter" Variant="Variant.Flat" Style="border-radius:8px;" />
                        </div>
                    </EmptyTemplate>
                </RadzenDataGrid>
            </RadzenCard>
        </div>
    </Authorized>
    <NotAuthorized>
        <ITStockM.Components.Pages.auth.RedirectToAccessDenied />
    </NotAuthorized>
</AuthorizeView>



