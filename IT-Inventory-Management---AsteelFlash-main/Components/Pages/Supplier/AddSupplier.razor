@page "/add-supplier"
@inject Radzen.DialogService dialogService

<PageTitle>Add Supplier</PageTitle>
<div class="add-supplier-page">
    <div class="container-fluid py-4">
        <RadzenCard class="supplier-card rz-shadow-2">
            <div class="form-container">
                <div class="form-header">
                    <RadzenText Text="Add New Supplier" TextStyle="TextStyle.H4" TagName="TagName.H1"
                                Class="form-heading" />
                </div>

                @if (errorVisible)
                {
                    <div class="error-alert">
                        <span class="error-icon">⚠️</span>
                        <div>
                            <strong>Error:</strong> Cannot save supplier. Please check the form for errors and try again.
                        </div>
                    </div>
                }

                <RadzenTemplateForm TItem="ITStockM.Models.ITStockManagment.Supplier" Data="@supplier" Visible="@(supplier != null)" Submit="@FormSubmit">

                    <div class="form-section section-basic">
                        <div class="section-title">
                            <span class="section-icon icon-basic"><RadzenIcon Icon="Warehouse" /></span>
                            Basic Information
                        </div>

                        <div class="form-field">
                            <label class="field-label">
                                Supplier Name
                                <span class="required-indicator">*</span>
                            </label>
                            <RadzenTextBox Class="field-input"
                                           @bind-Value="@supplier.SupplierName"
                                           Name="SupplierName"
                                           Placeholder="Enter supplier name" />
                            <RadzenRequiredValidator Component="SupplierName" Text="Supplier name is required" />
                        </div>

                        <div class="form-field">
                            <label class="field-label">
                                Address
                                <span class="required-indicator">*</span>
                            </label>
                            <RadzenTextBox Class="field-input"
                                           @bind-Value="@supplier.Adress"
                                           Name="Adress"
                                           Placeholder="Enter supplier address" />
                            <RadzenRequiredValidator Component="Adress" Text="Address is required" />
                        </div>
                    </div>

                    <div class="form-section section-contact">
                        <div class="section-title">
                            <span class="section-icon icon-contact"><RadzenIcon Icon="Contact_Support" /></span>
                            Contact Information
                        </div>

                        <div class="form-field">
                            <label class="field-label">
                                Email
                                <span class="required-indicator">*</span>
                            </label>
                            <RadzenTextBox Class="field-input"
                                           @bind-Value="@supplier.Email"
                                           Name="Email"
                                           Placeholder="Enter supplier email" />
                            <div class="field-helper">
                                This email will be used for communications and notifications
                            </div>
                            <RadzenRequiredValidator Component="Email" Text="Email is required" />
                            <RadzenEmailValidator Component="Email" Text="Please enter a valid email address" />
                        </div>

                        <div class="form-field">
                            <label class="field-label">
                                Phone Number
                                <span class="required-indicator">*</span>
                            </label>
                            <RadzenTextBox Class="field-input"
                                           @bind-Value="@supplier.PhoneNumber"
                                           Name="PhoneNumber"
                                           Placeholder="Enter supplier phone number" />
                            <div class="field-helper">
                                Include country code if applicable
                            </div>
                            <RadzenRequiredValidator Component="PhoneNumber" Text="Phone number is required" />
                        </div>
                    </div>

                    <RadzenStack Class="form-actions"
                                 Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center"
                                 JustifyContent="JustifyContent.Center"
                                 Gap="1rem">
                        <RadzenButton Text="Save" ButtonType="ButtonType.Submit" Icon="save" Size="ButtonSize.Medium" ButtonStyle="ButtonStyle.Info" Class="action-button" Shade="Shade.Darker" Variant="Variant.Filled" />
                        <RadzenButton Icon="highlight_off" Text="Cancel" Size="ButtonSize.Medium" ButtonStyle="ButtonStyle.Danger" Class="action-button" Shade="Shade.Darker" Variant="Variant.Filled" Click="@CancelButtonClick" />
                    </RadzenStack>
                </RadzenTemplateForm>
            </div>
        </RadzenCard>
    </div>
</div>