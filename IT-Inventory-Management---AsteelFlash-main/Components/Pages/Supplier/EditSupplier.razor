@page "/edit-supplier"

<PageTitle>Edit Supplier</PageTitle>

<style>
    :root {
        --primary: #4f46e5;
        --primary-light: #e0e7ff;
        --success: #10b981;
        --success-light: #d1fae5;
        --warning: #f59e0b;
        --warning-light: #fef3c7;
        --danger: #ef4444;
        --danger-light: #fee2e2;
        --gray-light: #f3f4f6;
        --gray: #9ca3af;
        --dark: #1f2937;
    }

    .page-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 1.5rem;
    }

    .page-title {
        position: relative;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        text-align: center;
    }

        .page-title::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 3px;
            background-color: var(--primary);
            border-radius: 3px;
        }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .form-field-full {
        grid-column: span 2;
    }

    .error-alert {
        background-color: var(--danger-light);
        color: var(--danger);
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .error-icon {
        font-size: 1.5rem;
    }

    .form-actions {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-top: 2rem;
    }

    .field-label {
        display: block;
        font-size: 0.875rem;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .required-indicator {
        color: var(--danger);
        margin-left: 0.25rem;
    }

    .field-input {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.2s;
    }

    .field-helper {
        font-size: 0.75rem;
        color: var(--gray);
        margin-top: 0.25rem;
    }
</style>

<div class="container-fluid py-4">
    <RadzenCard class="mb-4 rz-shadow-2" Style="border-radius: 12px; border: none;">
        <div class="page-container">
            <div class="page-title">
                <RadzenText Text="Edit Supplier" TextStyle="TextStyle.H3" TagName="TagName.H1"
                            Style="text-transform: uppercase; font-weight: 600; letter-spacing: 1px;" />
            </div>

            @if (errorVisible)
            {
                <div class="error-alert">
                    <span class="error-icon">⚠️</span>
                    <div>
                        <strong>Error:</strong> Cannot save supplier. Please check the form for errors and try again.
                    </div>
                </div>
            }

            <RadzenTemplateForm TItem="ITStockM.Models.ITStockManagment.Supplier"
                                Data="@supplier"
                                Visible="@(supplier != null)"
                                Submit="@FormSubmit">

                <RadzenFieldset Style="margin: 0 0 20px 0; border-radius: 12px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
                    <HeaderTemplate>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenIcon Icon="business" /><b>Supplier Information</b>
                        </RadzenStack>
                    </HeaderTemplate>

                    <ChildContent>
                        <div class="form-grid" style="padding: 1rem;">
                            <div class="form-field-full">
                                <label class="field-label">
                                    Supplier Name
                                    <span class="required-indicator">*</span>
                                </label>
                                <RadzenTextBox Class="field-input"
                                               @bind-Value="@supplier.SupplierName"
                                               Name="SupplierName"
                                               Placeholder="Enter supplier name" />
                                <RadzenRequiredValidator Component="SupplierName" Text="Supplier name is required" />
                            </div>

                            <div class="form-field-full">
                                <label class="field-label">
                                    Address
                                    <span class="required-indicator">*</span>
                                </label>
                                <RadzenTextArea Rows="3"
                                                Class="field-input"
                                                @bind-Value="@supplier.Adress"
                                                Name="Adress"
                                                Placeholder="Enter complete address" />
                                <RadzenRequiredValidator Component="Adress" Text="Address is required" />
                            </div>
                        </div>
                    </ChildContent>
                </RadzenFieldset>

                <RadzenFieldset Style="margin: 0 0 20px 0; border-radius: 12px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
                    <HeaderTemplate>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenIcon Icon="contact_phone" /><b>Contact Information</b>
                        </RadzenStack>
                    </HeaderTemplate>

                    <ChildContent>
                        <div class="form-grid" style="padding: 1rem;">
                            <div class="form-field">
                                <label class="field-label">
                                    Email
                                    <span class="required-indicator">*</span>
                                </label>
                                <RadzenTextBox Class="field-input"
                                               @bind-Value="@supplier.Email"
                                               Name="Email"
                                               Placeholder="Enter email address" />
                                <div class="field-helper">
                                    Primary contact email for communications
                                </div>
                                <RadzenRequiredValidator Component="Email" Text="Email is required" />
                                <RadzenEmailValidator Component="Email" Text="Please enter a valid email address" />
                            </div>

                            <div class="form-field">
                                <label class="field-label">
                                    Phone Number
                                    <span class="required-indicator">*</span>
                                </label>
                                <RadzenTextBox Class="field-input"
                                               @bind-Value="@supplier.PhoneNumber"
                                               Name="PhoneNumber"
                                               Placeholder="Enter phone number" />
                                <div class="field-helper">
                                    Include country code if applicable
                                </div>
                                <RadzenRequiredValidator Component="PhoneNumber" Text="Phone number is required" />
                            </div>
                        </div>
                    </ChildContent>
                </RadzenFieldset>

                <div class="form-actions">
                    <RadzenButton Text="Save Changes"
                                  Icon="save"
                                  ButtonType="ButtonType.Submit"
                                  ButtonStyle="ButtonStyle.Info"
                                  Style="border-radius: 8px;"
                                  Shade="Shade.Darker"
                                  Variant="Variant.Filled" />
                    <RadzenButton Text="Cancel"
                                  Icon="cancel"
                                  ButtonType="ButtonType.Button"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Style="border-radius: 8px;"
                                  Shade="Shade.Darker"
                                  Variant="Variant.Filled"
                                  Click="@CancelButtonClick" />
                </div>
            </RadzenTemplateForm>
        </div>
    </RadzenCard>
</div>