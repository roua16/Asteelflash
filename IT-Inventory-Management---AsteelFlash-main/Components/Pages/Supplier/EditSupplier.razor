@page "/edit-supplier"

<PageTitle>Edit Supplier</PageTitle>
<div class="edit-supplier-page">
    <div class="container-fluid py-4">
        <RadzenCard class="supplier-card mb-4 rz-shadow-2">
            <div class="page-container">
                <div class="page-title">
                    <RadzenText Text="Edit Supplier" TextStyle="TextStyle.H3" TagName="TagName.H1"
                                Class="page-heading" />
                </div>

                @if (errorVisible)
                {
                    <div class="error-alert">
                        <span class="error-icon">⚠️</span>
                        <div>
                            <strong>Error:</strong> Cannot save supplier. Please check the form for errors and try again.
                        </div>
                    </div>
                }

                <RadzenTemplateForm TItem="ITStockM.Domain.Entities.Supplier"
                                    Data="@supplier"
                                    Visible="@(supplier != null)"
                                    Submit="@FormSubmit">

                    <RadzenFieldset Class="supplier-fieldset">
                        <HeaderTemplate>
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                <RadzenIcon Icon="business" /><b>Supplier Information</b>
                            </RadzenStack>
                        </HeaderTemplate>

                        <ChildContent>
                            <div class="form-grid fieldset-content">
                                <div class="form-field-full">
                                    <label class="field-label">
                                        Supplier Name
                                        <span class="required-indicator">*</span>
                                    </label>
                                    <RadzenTextBox Class="field-input"
                                                   @bind-Value="@supplier.SupplierName"
                                                   Name="SupplierName"
                                                   Placeholder="Enter supplier name" />
                                    <RadzenRequiredValidator Component="SupplierName" Text="Supplier name is required" />
                                </div>

                                <div class="form-field-full">
                                    <label class="field-label">
                                        Address
                                        <span class="required-indicator">*</span>
                                    </label>
                                    <RadzenTextArea Rows="3"
                                                    Class="field-input"
                                                    @bind-Value="@supplier.Adress"
                                                    Name="Adress"
                                                    Placeholder="Enter complete address" />
                                    <RadzenRequiredValidator Component="Adress" Text="Address is required" />
                                </div>
                            </div>
                        </ChildContent>
                    </RadzenFieldset>

                    <RadzenFieldset Class="supplier-fieldset">
                        <HeaderTemplate>
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                <RadzenIcon Icon="contact_phone" /><b>Contact Information</b>
                            </RadzenStack>
                        </HeaderTemplate>

                        <ChildContent>
                            <div class="form-grid fieldset-content">
                                <div class="form-field">
                                    <label class="field-label">
                                        Email
                                        <span class="required-indicator">*</span>
                                    </label>
                                    <RadzenTextBox Class="field-input"
                                                   @bind-Value="@supplier.Email"
                                                   Name="Email"
                                                   Placeholder="Enter email address" />
                                    <div class="field-helper">
                                        Primary contact email for communications
                                    </div>
                                    <RadzenRequiredValidator Component="Email" Text="Email is required" />
                                    <RadzenEmailValidator Component="Email" Text="Please enter a valid email address" />
                                </div>

                                <div class="form-field">
                                    <label class="field-label">
                                        Phone Number
                                        <span class="required-indicator">*</span>
                                    </label>
                                    <RadzenTextBox Class="field-input"
                                                   @bind-Value="@supplier.PhoneNumber"
                                                   Name="PhoneNumber"
                                                   Placeholder="Enter phone number" />
                                    <div class="field-helper">
                                        Include country code if applicable
                                    </div>
                                    <RadzenRequiredValidator Component="PhoneNumber" Text="Phone number is required" />
                                </div>
                            </div>
                        </ChildContent>
                    </RadzenFieldset>

                    <div class="form-actions">
                        <RadzenButton Text="Save Changes"
                                      Icon="save"
                                      ButtonType="ButtonType.Submit"
                                      ButtonStyle="ButtonStyle.Info"
                                      Class="action-button"
                                      Shade="Shade.Darker"
                                      Variant="Variant.Filled" />
                        <RadzenButton Text="Cancel"
                                      Icon="cancel"
                                      ButtonType="ButtonType.Button"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Class="action-button"
                                      Shade="Shade.Darker"
                                      Variant="Variant.Filled"
                                      Click="@CancelButtonClick" />
                    </div>
                </RadzenTemplateForm>
            </div>
        </RadzenCard>
    </div>
</div>