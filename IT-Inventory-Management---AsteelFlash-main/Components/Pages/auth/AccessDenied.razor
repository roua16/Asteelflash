@page "/access-denied"
@layout MainLayout

<style>
    :root {
        --primary: #4f46e5;
        --primary-light: #e0e7ff;
        --danger: #dc3545;
        --danger-light: #fee2e2;
    }

    .access-denied-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 200px);
        text-align: center;
    }

    .access-denied-card {
        width: 100%;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        position: relative;
        animation: fadeInUp 0.6s ease-out forwards;
    }

    .card-header {
        background: linear-gradient(135deg, #0055a4, #dc3545);
        padding: 1.5rem;
        color: white;
        position: relative;
    }

        .card-header::after {
            content: "";
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 5px;
            background-color: white;
            border-radius: 10px;
        }

    .card-body {
        padding: 2.5rem 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
       
    }

    .icon-container {
        width: 120px;
        height: 120px;
        background-color: var(--danger-light);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
        position: relative;
        animation: pulse 2s infinite;
    }

        .icon-container::before {
            content: "";
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            border: 2px solid var(--danger);
            opacity: 0.5;
            animation: ripple 1.5s ease-out infinite;
        }

    .icon {
        font-size: 3.5rem;
        color: var(--danger);
    }

    .message-title {
        font-size: 1.75rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .message-description {
        font-size: 1.1rem;
        margin-bottom: 2rem;
        max-width: 500px;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        margin-top: 1rem;
    }

    .home-button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: transform 0.2s;
    }

        .home-button:hover {
            transform: translateY(-2px);
        }

        .home-button .icon-small {
            font-size: 1rem;
        }

    @@keyframes fadeInUp {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes pulse {
        0%

    {
        box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.4);
    }

    70% {
        box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
    }

    100% {
        box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
    }

    }

    @@keyframes ripple {
        0%

    {
        transform: scale(1);
        opacity: 0.5;
    }

    100% {
        transform: scale(1.2);
        opacity: 0;
    }

    }

    @@media (max-width: 640px) {
        .access-denied-container

    {
        padding: 1rem;
    }

    .card-body {
        padding: 1.5rem 1rem;
    }

    .icon-container {
        width: 100px;
        height: 100px;
    }

    .icon {
        font-size: 3rem;
    }

    .message-title {
        font-size: 1.5rem;
    }

    .message-description {
        font-size: 1rem;
    }

    .action-buttons {
        flex-direction: column;
    }

    }</style>

<div class="access-denied-container">
    <div class="access-denied-card">
        
        <div class="card-body">
            <div class="icon-container">
                <RadzenIcon Icon="block" Class="icon" />
            </div>

            <h3 class="message-title">Permission Denied</h3>
            <p class="message-description">
                You don't have the necessary permissions to access this page.
                Please contact your administrator if you believe this is an error.
            </p>

            <div class="action-buttons">
                <RadzenButton Click="@(() => NavigationManager.NavigateTo("/"))"
                              ButtonStyle="ButtonStyle.Primary" Shade="Shade.Lighter" Variant="Variant.Filled"
                              Class="home-button" Style="border-radius:8px">
                    <RadzenIcon Icon="home" Class="icon-small" />
                    <span>Return to Dashboard</span>
                </RadzenButton>

        
            </div>
        </div>
    </div>
</div>
