@inject Radzen.DialogService dialogService

<PageTitle>Request Details</PageTitle>
<div class="container-fluid py-4 archived-request-details-page">
    <RadzenRow>
        <RadzenColumn Size="12" SizeLG="10" OffsetLG="1">
            <RadzenCard class="p-0 m-0 request-card details-shell-card">
                <div class="p-4 header-section card-section">
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Start" Gap="0.5rem">
                                <RadzenText TextStyle="TextStyle.Overline" class="rz-color-text-tertiary overline-spaced">REQUEST DETAILS</RadzenText>
                                <RadzenText TextStyle="TextStyle.H5" Class="heading-name">@request.Employee.FullName</RadzenText>
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4" Class="status-column">
                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" AlignItems="AlignItems.End">
                                <RadzenBadge Shade="Shade.Lighter"
                                             BadgeStyle="@GetStatusStyle(request.Status)"
                                             Class="status-badge details-status-badge"
                                             Text="@request.Status" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </div>

                <div class="p-4 card-section content-section">
                    <RadzenStack Gap="2rem" Orientation="Orientation.Vertical">
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="6" class="mb-4 mb-md-0">
                                <RadzenCard class="h-100 rz-border rz-shadow-0 detail-card detail-card-primary">
                                    <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Start" Gap="1rem">
                                        <div class="w-100">
                                            <div class="info-label">TITLE</div>
                                            <div class="info-value">@request.Title</div>
                                        </div>

                                        <div class="w-100">
                                            <div class="info-label">DESCRIPTION</div>
                                            <div class="info-value">@request.Description</div>
                                        </div>

                                        <div class="w-100">
                                            <div class="info-label">DATE</div>
                                            <div class="info-value">@(request.Date.ToString("MMMM dd, yyyy"))</div>
                                        </div>
                                    </RadzenStack>
                                </RadzenCard>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenCard class="h-100 rz-border rz-shadow-0 detail-card detail-card-secondary">
                                    <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Start" Gap="1rem">
                                       

                                        <div class="w-100">
                                            <div class="info-label">PROJECT NAME</div>
                                            <div class="info-value">@request.ProjectName</div>
                                        </div>

                                        <div class="w-100">
                                            <div class="info-label">MATERIAL TYPE</div>
                                            <div class="info-value">@request.MaterialType</div>
                                        </div>
                                    </RadzenStack>
                                </RadzenCard>
                            </RadzenColumn>
                        </RadzenRow>

                        <div>
                            <RadzenText TextStyle="TextStyle.H6" Class="section-title">Selected Offer</RadzenText>


                            <RadzenStack Gap="1rem" Orientation="Orientation.Vertical">

                                <RadzenCard class="rz-shadow-1 selected-offer-card">
                                    <RadzenRow>

                                        <RadzenColumn Size="10" SizeSM="4">
                                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                                                <RadzenText TextStyle="TextStyle.Overline" class="rz-color-text-tertiary text-medium">SUPPLIER</RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body1" Class="text-medium">@offer.SupplierName</RadzenText>
                                            </RadzenStack>
                                        </RadzenColumn>
                                        <RadzenColumn Size="6" SizeSM="4">
                                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                                                <RadzenText TextStyle="TextStyle.Overline" class="rz-color-text-tertiary text-medium">DELIVERY DATE</RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body1">@(offer.DeliveryDate.ToString("MMM dd, yyyy"))</RadzenText>
                                            </RadzenStack>
                                        </RadzenColumn>
                                        <RadzenColumn Size="6" SizeSM="3">
                                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                                                <RadzenText TextStyle="TextStyle.Overline" class="rz-color-text-tertiary text-medium">PRICE</RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body1" class="rz-color-primary-dark text-semibold">@offer.Price.ToString()</RadzenText>
                                            </RadzenStack>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenCard>

                            </RadzenStack>



                        </div>
                        @if (request.File != null)
                        {
                            <div class="d-flex justify-content-end">
                                <RadzenButton Click=@(() => DownloadFile(request))
                                              ButtonStyle="ButtonStyle.Light"
                                              class="rz-border rz-shadow-0 attachment-button">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                        <RadzenImage Path="images/attach1.png" Class="attachment-icon" />
                                        <RadzenText TextStyle="TextStyle.Body1">Download Attachment : @request.FileName</RadzenText>
                                    </RadzenStack>
                                </RadzenButton>
                            </div>
                        }

                    </RadzenStack>
                </div>

            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
</div>

