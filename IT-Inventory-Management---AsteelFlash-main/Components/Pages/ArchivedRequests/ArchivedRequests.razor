@page "/archived-requests-page"

@using ITStockM.Models.Constants
<AuthorizeView Roles="@($"{UserRoles.Admin},{UserRoles.Purchasing}")">
    <Authorized>
        
        <PageTitle>Archived Requests</PageTitle>

        <div class="container-fluid py-4 archived-requests-page">
            <RadzenCard class="mb-4 rz-shadow-2 archived-requests-card">

                <RadzenRow AlignItems="AlignItems.Center" class="mb-4">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText Text="Archived Requests"
                                    TextStyle="TextStyle.H3"
                                    TagName="TagName.H1"
                                    Class="page-heading" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6" Class="d-flex justify-content-md-end mt-3 mt-md-0">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="1rem">
                            <RadzenSplitButton ButtonStyle="ButtonStyle.Light"
                                               Icon="download"
                                               Text="Export"
                                               Click="@ExportClick"
                                               Class="export-btn">
                                <RadzenSplitButtonItem Text="Excel" Value="xlsx" Icon="table_view" />
                                <RadzenSplitButtonItem Text="CSV" Value="csv" Icon="description" />
                            </RadzenSplitButton>
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow class="mb-4">
                    <RadzenColumn Size="12">
                        <div class="position-relative">
                            <RadzenTextBox Placeholder="🔍 Search requests..." @oninput="@Search" aria-label="Search by all string columns"
                                           Class="request-search" Icon="find_in_page" />
                            <i class="rzi rzi-search position-absolute search-indicator"></i>
                        </div>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenDataGrid @ref="grid0"
                                AllowFiltering="true"
                                FilterMode="FilterMode.Advanced"
                                AllowPaging="true"
                                AllowSorting="true"
                                PageSize="10"
                                ShowPagingSummary="true"
                                PageSizeOptions="@(new int[]{5, 10, 20, 30})"
                                Data="@requests"
                                TItem="ITStockM.Models.ITStockManagment.Request"
                                Class="archived-requests-grid"
                                EmptyText="No purchase requests found">
                    <Columns>
                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Employee.FullName" Title="Employee" Width="150px">
                            <Template Context="request">
                                <div class="d-flex align-items-center">
                                    <RadzenText TextStyle="TextStyle.Body1" Class="text-medium">@request.Employee.FullName</RadzenText>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Title" Title="Title" Width="180px">
                            <Template Context="request">
                                <RadzenText TextStyle="TextStyle.Body1" Class="text-medium">@request.Title</RadzenText>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Description" Title="Description" Width="200px" Visible="false">
                            <Template Context="request">
                                <div class="description-ellipsis">
                                    @request.Description
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Type" Title="Type" Width="120px" Visible="false" />

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="ProjectName" Title="Project" Width="150px" Visible="false" />

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="MaterialType" Title="Material" Width="120px" Visible="false" />
                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Date" Title="Date" Width="120px">
                            <Template Context="request">
                                @request.Date.ToString("MMM dd, yyyy")
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Status" Title="Status" Width="120px">
                            <Template Context="request">
                                <div class="status-center">
                                    <RadzenBadge BadgeStyle="BadgeStyle.Success"
                                                 Shade="Shade.Lighter"
                                                 Class="archived-status-badge"
                                                 Text="@request.Status" />
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Filterable="false" Sortable="false" Width="120px" TextAlign="TextAlign.Center" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                            <Template Context="request">
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.5rem">

                                    <RadzenButton ButtonStyle="ButtonStyle.Info"
                                                  Icon="info"
                                                  Size="ButtonSize.Medium"
                                                  Class="details-btn"
                                                  Shade="Shade.Lighter"
                                                  Variant="Variant.Flat"
                                                  Title="View Details"
                                                  Click="@(() => RequestDetails(request.Id))" />
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                    <EmptyTemplate>
                        <div class="d-flex flex-column align-items-center justify-content-center py-5">
                            <i class="rzi rzi-shopping-cart-2 mb-3 empty-icon"></i>
                            <RadzenText TextStyle="TextStyle.H6">No purchase requests found</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" class="rz-color-text-secondary">Try adjusting your search or filters</RadzenText>
                        </div>
                    </EmptyTemplate>
                </RadzenDataGrid>
            </RadzenCard>
        </div>

    </Authorized>
    <NotAuthorized>
        <ITStockM.Components.Pages.auth.RedirectToAccessDenied />
    </NotAuthorized>
</AuthorizeView>


