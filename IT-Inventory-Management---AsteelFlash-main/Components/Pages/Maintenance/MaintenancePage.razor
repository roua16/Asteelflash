@page "/maintenance"
@using ITStockM.Models.ITStockManagment
<AuthorizeView Roles="Admin,IT">
    <Authorized>
        <PageTitle>Maintenance Tickets</PageTitle>

        
        <div class="container-fluid py-4">
            <RadzenCard class="mb-4 rz-shadow-2" Style="border-radius:12px;border:none">
                <div class="p-2">
                    <RadzenText Text="Maintenance Tickets" TextStyle="TextStyle.H4" TagName="TagName.H1"
                                Style="text-transform:uppercase;font-weight:600;letter-spacing:1px;margin-bottom:1.5rem;color:var(--rz-text-title-color)" />

                    <RadzenRow Class="mb-4">
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="4" Class="mb-4">
                            <div class="dashboard-card card-alert" style="position:relative">
                                <div class="card-header">
                                    <div>
                                        <div class="card-title">Open Tickets</div>
                                        <div class="card-value">@openCount</div>
                                    </div>
                                    <div class="kpi-icon bg-danger">
                                        <RadzenIcon Icon="error" />
                                    </div>
                                </div>
                            </div>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="4" Class="mb-4">
                            <div class="dashboard-card card-stock" style="position:relative">
                                <div class="card-header">
                                    <div>
                                        <div class="card-title">In Progress</div>
                                        <div class="card-value">@inProgressCount</div>
                                    </div>
                                    <div class="kpi-icon bg-warning">
                                        <RadzenIcon Icon="pending" />
                                    </div>
                                </div>
                            </div>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="4" Class="mb-4">
                            <div class="dashboard-card card-warning" style="position:relative">
                                <div class="card-header">
                                    <div>
                                        <div class="card-title">Closed</div>
                                        <div class="card-value">@closedCount</div>
                                    </div>
                                    <div class="kpi-icon bg-success">
                                        <RadzenIcon Icon="check_circle" />
                                    </div>
                                </div>
                            </div>
                        </RadzenColumn>
                    </RadzenRow>

                    <div class="search-export-container" style="margin-bottom:1.5rem">
                        <div class="search-container">
                            <span class="search-icon">🔍</span>
                            <RadzenTextBox Placeholder="Search tickets…" Value="@search"
                                           ValueChanged="@(async (string s) => await OnSearchChanged(s))"
                                           Class="search-box" />
                        </div>
                        <div class="export-container">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                <RadzenDropDown Data="@statusOptions" Value="@selectedStatus"
                                                ValueChanged="@(async (string s) => await OnStatusFilter(s))"
                                                Placeholder="All statuses" AllowClear="true" Style="width:160px;border-radius:8px" />
                                @if (userRole == "Admin" || userRole == "IT")
                                {
                                    <RadzenButton Text="New Ticket" Icon="add" ButtonStyle="ButtonStyle.Primary"
                                                  Style="border-radius:8px" Click="@OpenNewTicketDialog" />
                                }
                                <RadzenButton Text="CSV" Icon="download" ButtonStyle="ButtonStyle.Light"
                                              Style="border-radius:8px"
                                              Click="@(() => NavigationManager.NavigateTo("/export/ITStockManagment/maintenance/csv", true))" />
                            </RadzenStack>
                        </div>
                    </div>

                    <div class="datagrid-container" style="border-radius:12px;overflow:hidden;box-shadow:0 4px 12px rgba(0,0,0,.08);border:1px solid rgba(0,0,0,.05)">
                        <RadzenDataGrid Data="@tickets" TItem="MaintenanceTicket"
                                        AllowPaging="true" PageSize="15"
                                        PageSizeOptions="@(new int[]{10,15,25,50})"
                                        ShowPagingSummary="true" AllowSorting="true" AllowFiltering="true"
                                        @ref="grid">
                            <Columns>
                                <RadzenDataGridColumn TItem="MaintenanceTicket" Property="Materiel.MaterielName" Title="Asset" />
                                <RadzenDataGridColumn TItem="MaintenanceTicket" Property="Materiel.SerialNumber" Title="Serial #" />
                                <RadzenDataGridColumn TItem="MaintenanceTicket" Property="ProblemDescription" Title="Problem" />
                                <RadzenDataGridColumn TItem="MaintenanceTicket" Property="Status" Title="Status">
                                    <Template Context="row">
                                        <span class="status-badge @StatusCss(row.Status)">@row.Status</span>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="MaintenanceTicket" Property="ReportedAt" Title="Reported" FormatString="{0:dd/MM/yyyy}" />
                                <RadzenDataGridColumn TItem="MaintenanceTicket" Property="Cost" Title="Cost (€)" FormatString="{0:N2}" />
                                <RadzenDataGridColumn TItem="MaintenanceTicket" Title="Actions" Sortable="false" Filterable="false">
                                    <Template Context="row">
                                        @if (row.Status != "Closed" && (userRole == "Admin" || userRole == "IT"))
                                        {
                                            <RadzenButton Text="Close" Icon="check_circle" ButtonStyle="ButtonStyle.Success"
                                                          Size="ButtonSize.Small" Style="border-radius:6px"
                                                          Click="@(() => OpenCloseDialog(row))" />
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                </div>
            </RadzenCard>
        </div>

        @if (showNewDialog)
        {
            <div class="modal-backdrop" @onclick="CloseDialogs">
                <div class="modal-card" @onclick:stopPropagation="true">
                    <RadzenText Text="New Maintenance Ticket" TextStyle="TextStyle.H6" Style="font-weight:600;margin-bottom:1rem" />
                    <div style="display:flex;flex-direction:column;gap:.75rem">
                        <RadzenDropDown Data="@materielOptions" @bind-Value="newMaterielId"
                                        TextProperty="MaterielName" ValueProperty="Id"
                                        Placeholder="Select asset…" Style="width:100%" />
                        <RadzenTextArea @bind-Value="newDescription" Placeholder="Problem description…" Rows="4" Style="width:100%" />
                        <div style="display:flex;gap:.75rem;justify-content:flex-end">
                            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Style="border-radius:8px" Click="@CloseDialogs" />
                            <RadzenButton Text="Create" ButtonStyle="ButtonStyle.Primary" Style="border-radius:8px" Click="@CreateTicket" />
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (showCloseDialog && ticketToClose != null)
        {
            <div class="modal-backdrop" @onclick="CloseDialogs">
                <div class="modal-card" @onclick:stopPropagation="true">
                    <RadzenText Text="@($"Close Ticket #{ticketToClose.Id}")" TextStyle="TextStyle.H6" Style="font-weight:600;margin-bottom:1rem" />
                    <div style="display:flex;flex-direction:column;gap:.75rem">
                        <RadzenTextArea @bind-Value="closeResolution" Placeholder="Resolution notes…" Rows="4" Style="width:100%" />
                        <RadzenNumeric @bind-Value="closeCost" Placeholder="Final cost (€)" Style="width:100%" />
                        <div style="display:flex;gap:.75rem;justify-content:flex-end">
                            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Style="border-radius:8px" Click="@CloseDialogs" />
                            <RadzenButton Text="Close Ticket" ButtonStyle="ButtonStyle.Success" Style="border-radius:8px" Click="@CloseTicket" />
                        </div>
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <ITStockM.Components.Pages.auth.RedirectToAccessDenied />
    </NotAuthorized>
</AuthorizeView>
