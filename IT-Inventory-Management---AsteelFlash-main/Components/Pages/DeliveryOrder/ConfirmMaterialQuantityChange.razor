<div class="confirmation-dialog">
    <div class="dialog-header">
        @if (!ToDelete)
        {
            <h3 class="dialog-title">
                <i class="rz-icon-edit"></i> Confirm Edit
            </h3>
            <p class="dialog-subtitle">
                You are about to edit the quantity of <span class="highlight-text">@DeliveryOrderMaterial.Materiel.MaterielName</span>
                from delivery order <span class="highlight-text">@DeliveryOrderMaterial.DeliveryOrder.DeliveryOrderNumber</span>
            </p>
        }
        else
        {
            <h3 class="dialog-title">
                <i class="rz-icon-delete"></i> Confirm Remove
            </h3>
            <p class="dialog-subtitle">
                You are about to remove <span class="highlight-text">@DeliveryOrderMaterial.Materiel.MaterielName</span>
                from delivery order <span class="highlight-text">@DeliveryOrderMaterial.DeliveryOrder.DeliveryOrderNumber</span>
            </p>
        }
    </div>

    <div class="dialog-content">
        <div class="checkbox-container">
            <RadzenCheckBox @bind-Value="isChecked" />
            <label class="checkbox-label">
                Check if you are going to add materials in this delivery order
                (<span class="highlight-text">@DeliveryOrderMaterial.DeliveryOrder.DeliveryOrderNumber</span>) again
            </label>
        </div>
    </div>

    <div class="dialog-actions">
        <RadzenButton Click="()=>DialogService.Close(isChecked)"
                      ButtonStyle="ButtonStyle.Primary"
                      Icon="check"
                      Text="Yes, Proceed"
                      class="confirm-button" />

        <RadzenButton Click="()=>DialogService.Close(null)"
                      ButtonStyle="ButtonStyle.Light"
                      Icon="close"
                      Text="Cancel"
                      class="cancel-button" />
    </div>
</div>

