<div class="page-container">
    <h1 class="page-title">Delivery Order Details</h1>

    <div class="details-card material-card">


        <div class="property-grid">
            <div class="property-item material-property">
                <div class="property-label">Deliver Order Number</div>
                <div class="property-value">@DeliveryOrder.DeleveryOrderNumber</div>
            </div>
            <div class="property-item material-property">

                <div class="property-label">Order Number</div>
                <div class="property-value">@DeliveryOrder.OrderNumber</div>
            </div>


            <div class="property-item material-property">
                <div class="property-label">Delivery Order Exact date</div>
                <div class="property-value">@DeliveryOrder.DeliveryDate</div>
            </div>


            <div class="property-item material-property">

                <div class="property-label">Registred By</div>
                <div class="property-value">@DeliveryOrder.Employee.FullName</div>
            </div>



        </div>
        <div class="description-section">
            <div class="property-label material-property">Description</div>
            <div class="property-value description-value">

                @DeliveryOrder.Descriptoin

            </div>
        </div>




    </div>

    <div class="material-details-header">
        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; font-weight: 600;">Material List</RadzenText>
        <RadzenIcon Icon="notes"></RadzenIcon>
    </div>
    <div class="datagrid-container">
        <RadzenDataGrid @ref="grid0"
        AllowFiltering="true"
        AllowSorting="true"
        AllowPaging="true"
        PageSize="10"
        ShowPagingSummary="true"
        PageSizeOptions=@(new int[]{5, 10, 20, 30})
        Data="@DeliveryOrderMateriels"
        TItem="ITStockM.Domain.Entities.DeliveryOrderMateriel">
            <Columns>

                <RadzenDataGridColumn  TItem="ITStockM.Domain.Entities.DeliveryOrderMateriel" Property="Materiel.MaterielName" Title="Material Name">
                    <Template Context="data">


                        @data.Materiel.MaterielName

                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Width="90px" TextAlign="TextAlign.Center" TItem="ITStockM.Domain.Entities.DeliveryOrderMateriel" Property="Qte" Title="QTE">
                    <Template Context="data" >

                        <div class="QuantityPDRStock-badge QuantityPDRStock-high" @onclick="() => Edit(data)" >
                            @data.Qte
                        </div>
                    </Template>

                    <EditTemplate Context="data">
                        <RadzenNumeric ShowUpDown="false" @bind-Value="data.Qte" Style="width:100%" @onkeypress=" (e) => ChangeValue(e,data)" Max="data.Qte" Min="1" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ITStockM.Domain.Entities.DeliveryOrderMateriel" Property="Materiel.Warranty" Title="Warranty">
                    <Template Context="data">

                        <span> @data.Materiel.Warranty.ToString("MMM dd, yyyy")</span>

                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Width="90px" TItem="ITStockM.Domain.Entities.DeliveryOrderMateriel" Property="Materiel.SerialNumber" Title="SN">
                    <Template Context="data">
                        @data.Materiel.SerialNumber
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ITStockM.Domain.Entities.DeliveryOrderMateriel"
                                      Filterable="false" Sortable="false" Width="15%"
                                      TextAlign="TextAlign.Center">
                    <Template Context="data">                      
                        <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                  Icon="delete"
                                  Size="ButtonSize.Medium"
                                  Style="border-radius: 8px;"
                                  Shade="Shade.Lighter"
                                  Variant="Variant.Flat"
                                  Class="info-button"
                                  Click="()=>DeleteDeliveryOrderMaterial(data)"
                                   />
                    </Template>

                </RadzenDataGridColumn>

                

            </Columns>
        </RadzenDataGrid>
    </div>
</div>
