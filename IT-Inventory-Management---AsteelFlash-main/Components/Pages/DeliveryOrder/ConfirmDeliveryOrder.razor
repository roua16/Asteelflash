@inject Radzen.DialogService ds

<div class="confirmation-container">
    <div class="dialog-header">
        <div class="dialog-icon">
            @if (IsDeliveryOrder)
            {
                <i class="rz-icon-local-shipping"></i>
            }
            else
            {
                <i class="rz-icon-inventory"></i>
            }
        </div>
        <h3 class="dialog-title">Confirm Action</h3>
    </div>

    <div class="dialog-content">
        <RadzenStack Gap="1.5rem">
            <div class="confirmation-question">
                @if (IsDeliveryOrder)
                {
                    <span>Are you sure you want to add this <span class="highlight-text">delivery order</span>?</span>
                }
                else
                {
                    <span>Are you sure you want to add these <span class="highlight-text">delayed materials</span>?</span>
                }
            </div>

            <div class="secondary-question">
                <i class="rz-icon-help"></i>
                @if (IsDeliveryOrder)
                {
                    <span>Do you have delayed materials?</span>
                }
                else
                {
                    <span>Still have delayed materials?</span>
                }
            </div>

            <div class="checkbox-container">
                <input type="checkbox"
                       @bind="returnValue"
                       class="custom-checkbox"
                       id="delayedMaterialsCheckbox" />
                <label for="delayedMaterialsCheckbox" class="checkbox-label">
                    <i class="rz-icon-schedule" style="color: #ffc107;"></i>
                    @if (IsDeliveryOrder)
                    {
                        <span>Yes, I have delayed materials</span>
                    }
                    else
                    {
                        <span>Yes, I still have delayed materials</span>
                    }
                </label>
            </div>

            <div class="dialog-actions">
                <RadzenButton Text="Cancel"
                              Click="() => ds.Close(null)"
                              Class="btn-secondary"
                              Icon="close" />

                <RadzenButton Text="OK"
                              Click="() => ds.Close(returnValue)"
                              Class="btn-primary"
                              Icon="check" />
            </div>
        </RadzenStack>
    </div>
</div>

@code {
    [Parameter]
    public bool IsDeliveryOrder { get; set; }

    bool returnValue = false;
}