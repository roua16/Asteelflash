@inject Radzen.DialogService ds

<style>
    .confirmation-container {
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        overflow: hidden;
        width: 100%;
        max-width: 450px;
        margin: 0 auto;
        padding: 0;
    }

    .dialog-header {
        background: linear-gradient(135deg, #10b981, #40b156);
        color: white;
        padding: 20px 24px;
        text-align: center;
        margin-bottom: 0;
    }

    .dialog-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        background-color: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        margin: 0 auto 12px;
        font-size: 20px;
    }

    .dialog-title {
        font-size: 18px;
        font-weight: 600;
        margin: 0;
        letter-spacing: 0.5px;
    }

    .dialog-content {
        padding: 24px;
    }

    .confirmation-question {
        font-size: 16px;
        font-weight: 500;
        text-align: center;
        margin-bottom: 20px;
        line-height: 1.5;
        padding: 16px;
        border-radius: 8px;
        border-left: 4px solid #10b981;
    }

    .secondary-question {
        font-size: 14px;
        text-align: center;
        margin-bottom: 16px;
        padding: 12px;
        border-radius: 6px;
        border-left: 4px solid #ffc107;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .checkbox-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 24px;
        padding: 16px;
        border-radius: 8px;
        border: 1px solid rgba(108, 117, 125, 0.2);
        transition: all 0.2s ease;
    }

        .checkbox-container:hover {
            border-color: #6c757d;
        }

    .checkbox-label {
        font-size: 15px;
        font-weight: 500;
        cursor: pointer;
        user-select: none;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .custom-checkbox {
        appearance: none;
        width: 20px;
        height: 20px;
        border: 2px solid #6c757d;
        border-radius: 4px;
        background-color: white;
        cursor: pointer;
        position: relative;
        transition: all 0.2s ease;
    }

        .custom-checkbox:checked {
            background-color: #ffc107;
            border-color: #ffc107;
        }

            .custom-checkbox:checked::after {
                content: '✓';
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                font-size: 12px;
                font-weight: bold;
            }

        .custom-checkbox:hover {
            border-color: #495057;
            box-shadow: 0 0 0 3px rgba(108, 117, 125, 0.1);
        }

    .dialog-actions {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 24px 24px;
        border-top: 1px solid #e9ecef;
    }

    .btn-primary {
        background-color: #10b981 !important;
        color: white !important;
        border: none !important;
        padding: 10px 20px !important;
        border-radius: 6px !important;
        font-weight: 500 !important;
        min-width: 80px !important;
        transition: all 0.2s ease !important;
    }

        .btn-primary:hover {
            background-color: #10b981 !important;
            transform: translateY(-1px);
        }

    .btn-secondary {
        background-color: #f8f9fa !important;
        color: #495057 !important;
        border: 1px solid #ced4da !important;
        padding: 10px 20px !important;
        border-radius: 6px !important;
        font-weight: 500 !important;
        min-width: 80px !important;
        transition: all 0.2s ease !important;
    }

        .btn-secondary:hover {
            background-color: #e9ecef !important;
            transform: translateY(-1px);
        }

    .highlight-text {
        color: #0055a4;
        font-weight: 600;
    }

    @@keyframes slideIn {
        from

    {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .confirmation-container {
        animation: slideIn 0.3s ease-out;
    }

    @@media (max-width: 576px) {
        .dialog-actions

    {
        flex-direction: column;
    }

    .dialog-actions .rz-button {
        width: 100%;
        margin-bottom: 8px;
    }

    }</style>

<div class="confirmation-container">
    <div class="dialog-header">
        <div class="dialog-icon">
            @if (IsDeliveryOrder)
            {
                <i class="rz-icon-local-shipping"></i>
            }
            else
            {
                <i class="rz-icon-inventory"></i>
            }
        </div>
        <h3 class="dialog-title">Confirm Action</h3>
    </div>

    <div class="dialog-content">
        <RadzenStack Gap="1.5rem">
            <div class="confirmation-question">
                @if (IsDeliveryOrder)
                {
                    <span>Are you sure you want to add this <span class="highlight-text">delivery order</span>?</span>
                }
                else
                {
                    <span>Are you sure you want to add these <span class="highlight-text">delayed materials</span>?</span>
                }
            </div>

            <div class="secondary-question">
                <i class="rz-icon-help"></i>
                @if (IsDeliveryOrder)
                {
                    <span>Do you have delayed materials?</span>
                }
                else
                {
                    <span>Still have delayed materials?</span>
                }
            </div>

            <div class="checkbox-container">
                <input type="checkbox"
                       @bind="returnValue"
                       class="custom-checkbox"
                       id="delayedMaterialsCheckbox" />
                <label for="delayedMaterialsCheckbox" class="checkbox-label">
                    <i class="rz-icon-schedule" style="color: #ffc107;"></i>
                    @if (IsDeliveryOrder)
                    {
                        <span>Yes, I have delayed materials</span>
                    }
                    else
                    {
                        <span>Yes, I still have delayed materials</span>
                    }
                </label>
            </div>

            <div class="dialog-actions">
                <RadzenButton Text="Cancel"
                              Click="() => ds.Close(null)"
                              Class="btn-secondary"
                              Icon="close" />

                <RadzenButton Text="OK"
                              Click="() => ds.Close(returnValue)"
                              Class="btn-primary"
                              Icon="check" />
            </div>
        </RadzenStack>
    </div>
</div>

@code {
    [Parameter]
    public bool IsDeliveryOrder { get; set; }

    bool returnValue = false;
}