@page "/delivery-order"

@using ITStockM.Models.Constants
<AuthorizeView Roles="@($"{UserRoles.Admin},{UserRoles.Purchasing},{UserRoles.PDR}")">
    <Authorized Context="authContext">
        <PageTitle>Delivery Order</PageTitle>

                <span id="scrollback"></span>
        <div class="container-fluid py-4">
            <RadzenCard class="mb-4 rz-shadow-2" Style="border-radius: 12px; border: none;">
                <div class="page-container">
                    <div class="page-title">
                        <RadzenText Text="Delivery Order" TextStyle="TextStyle.H3" TagName="TagName.H1"
                                    Style="text-transform: uppercase; font-weight: 600; letter-spacing: 1px;" />

                                    
                    </div>

                    <RadzenTemplateForm TItem="ITStockM.Models.ITStockManagment.DeliveryOrder"
                                        Data="@deliveryOrder"
                                        Visible="@(deliveryOrder != null)"
                                        Submit="@AddDeliveryOrderAsync"
                                        @ref="form">

                        <!-- Error Alert -->
                        @if (errorVisible)
                        {
                            <div class="error-alert">
                                <span class="error-icon">⚠️</span>
                                <div>
                                    <strong>Error:</strong> Cannot save Delivery Order. Please check your inputs and try again.
                                </div>
                            </div>
                        }



                        <div class="panel panel-order">
                            <div class="panel-header">
                                <div class="panel-icon icon-order">
                                    <RadzenIcon Icon="Orders" />
                                </div>
                                <h2 class="panel-title">Delivery Order Details</h2>
                            </div>

                            <div class="panel-body">
                                <RadzenFieldset AllowCollapse="true"
                                                Style="margin: 2px auto; border-radius: 12px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
                                    <HeaderTemplate>
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                            <b>Collapse</b>
                                        </RadzenStack>
                                    </HeaderTemplate>
                                    <ChildContent>
                                        <div class="form-row">
                                            <div class="form-col form-col-6">
                                                <div class="form-field">
                                                    <label class="field-label">
                                                        Delivery Order Number
                                                        <span class="required-indicator">*</span>
                                                    </label>
                                                    <RadzenTextBox Class="field-input"
                                                                   @bind-Value="@deliveryOrder.DeleveryOrderNumber"
                                                                   Name="DeleveryOrderNumber"
                                                                   Placeholder="Enter delivery order number" />
                                                    <RadzenRequiredValidator Component="DeleveryOrderNumber" Text="Delivery Order Number is required" />
                                                </div>
                                            </div>

                                            <div class="form-col form-col-6">
                                                <div class="form-field">
                                                    <label class="field-label">
                                                        Order Number
                                                    </label>
                                                    <RadzenTextBox Class="field-input"
                                                                   @bind-Value="@deliveryOrder.OrderNumber"
                                                                   Name="OrderNumber"
                                                                   Placeholder="Enter order number" />

                                                </div>
                                            </div>

                                            <div class="form-col form-col-12">
                                                <div class="form-field">
                                                    <label class="field-label">
                                                        Description
                                                        <span class="required-indicator">*</span>
                                                    </label>
                                                    <RadzenTextArea Rows="3"
                                                                    Class="field-input"
                                                                    @bind-Value="@deliveryOrder.Descriptoin"
                                                                    Name="Descriptoin"
                                                                    Placeholder="Enter detailed description" />
                                                    <RadzenRequiredValidator Component="Descriptoin" Text="Description is required" />
                                                </div>
                                            </div>

                                            <div class="form-col form-col-12">
                                                <div class="form-field">
                                                    <label class="field-label">
                                                        Supplier
                                                    </label>
                                                    <RadzenDropDownDataGrid Class="field-input" @bind-Value=@deliveryOrder.SupplierName Data=@suppliersForSupplierName TextProperty="SupplierName" ValueProperty="SupplierName" AllowColumnResize="true" AllowFilteringByAllStringColumns="true" Name="SupplierName" Placeholder="Select supplier" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                                                        <Columns>
                                                            <RadzenDropDownDataGridColumn Property="@nameof(ITStockM.Models.ITStockManagment.Supplier.SupplierName)" Title="SupplierName" Width="200px" />

                                                        </Columns>
                                                    </RadzenDropDownDataGrid>
                                                    <RadzenRequiredValidator Component="SupplierName" Text="Description is required" />

                                                    <div class="supplier-link" @onclick="AddSupplier">
                                                        <RadzenIcon Icon="add_circle" Style="font-size: 0.875rem;" />
                                                        Supplier not in the list? Click here to add one.
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-col form-col-12">
                                                <div class="form-field">
                                                    <label class="field-label">
                                                        Exact Delivery Date
                                                        <span class="required-indicator">*</span>
                                                    </label>

                                                    <RadzenDatePicker @bind-Value="@deliveryOrder.DeliveryDate"
                                                                      Name="DeliveryDate"
                                                                      ShowTime="true"
                                                                      Class="field-input1"
                                                                      ShowIcon="true"
                                                                      Placeholder="Select delivery date..." />
                                                    <RadzenRequiredValidator Component="DeliveryDate" Text="Order Number is required" />
                                                </div>
                                            </div>



                                        </div>
                                    </ChildContent>

                                    <SummaryTemplate>

                                        <div style="margin-top: 1.5rem;">
                                            <table class="summary-table">
                                                <thead>
                                                    <tr>
                                                        <th>Delivery Order Number</th>
                                                        <th>Order Number</th>
                                                        <th>Supplier Name</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td>@deliveryOrder.DeleveryOrderNumber</td>
                                                        <td>@deliveryOrder.OrderNumber</td>
                                                        <td>@deliveryOrder.SupplierName</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </SummaryTemplate>
                                </RadzenFieldset>

                            </div>
                        </div>


                        <!-- Materials Panel -->
                        <div class="add-material-btn">
                            <RadzenButton Click="@(() => AddMateriel())"
                                          Text="Add Material"
                                          ButtonStyle="ButtonStyle.Light" Icon="add_circle" Size="ButtonSize.Medium"
                                          Shade="Shade.Lighter" Variant="Variant.Flat" Style="border-radius:8px;" />
                        </div>

                        <div class="panel panel-materials">
                            <div class="panel-header">

                                <div class="panel-icon icon-materials">
                                    <RadzenIcon Icon="build" />
                                </div>
                                <h2 class="panel-title">Materials</h2>
                            </div>

                            <div class="panel-body">
                                <RadzenFieldset AllowCollapse="true"
                                                Style="margin: 2px auto; border-radius: 12px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
                                    <HeaderTemplate>
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                            <b>Collapse</b>
                                        </RadzenStack>
                                    </HeaderTemplate>
                                    <ChildContent>
                                        <div class="material-cards">
                                            @foreach (var (MaterialItem, i) in MaterielsList.Select((value, index) => (value, index)))
                                            {
                                                <div class="material-card">
                                                    <div class="card-header">
                                                        <h3 class="card-title">Material @(i + 1)</h3>
                                                        @if (i != 0)
                                                        {
                                                            <RadzenButton Click="@(() => RemoveMateriel(i))"
                                                                          Icon="delete"
                                                                          ButtonStyle="ButtonStyle.Light"
                                                                          Size="ButtonSize.Small"
                                                                          Style="border-radius: 50%; width: 32px; height: 32px; padding: 0;"
                                                                          Title="Remove Material" />
                                                        }
                                                    </div>

                                                    <div class="form-field">
                                                        <label class="field-label">
                                                            Material Name
                                                            <span class="required-indicator">*</span>
                                                        </label>
                                                        <RadzenAutoComplete Class="field-input"
                                                                            @bind-Value="@MaterialItem.Materiel.MaterielName"
                                                                            Name='@("MaterielName"+i.ToString())'
                                                                            Data="@MaterialSuggestions"
                                                                            AllowClear="true"
                                                                            Placeholder="Type to search materials..."
                                                                            Change="@(() => UpdateMaterialType(MaterialItem.Materiel.MaterielName, i))" />
                                                        <RadzenRequiredValidator Component='@("MaterielName"+i.ToString())' Text="Material Name is required" />
                                                    </div>

                                                    <div class="form-field">
                                                        <label class="field-label">
                                                            Material Type
                                                            <span class="required-indicator">*</span>
                                                        </label>
                                                        <RadzenDropDown TValue="string"
                                                                        Data="@options"
                                                                        Placeholder="Select a material type"
                                                                        Class="field-input"
                                                                        Name='@("MaterialType"+i.ToString())'
                                                                        Change="@(()=>TypeSRChecker(i))"
                                                                        @bind-Value="@MaterialItem.Materiel.Type" />
                                                        <RadzenRequiredValidator Component='@("MaterialType"+i.ToString())' Text="Material Type is required" />
                                                    </div>

                                                    <div class="form-field">
                                                        <label class="field-label">
                                                            Quantity
                                                            <span class="required-indicator">*</span>
                                                        </label>
                                                        <input type="number" Class="field-input"
                                                        value="1"
                                                               @onchange="(args) => {MaterialItem.Materiel.QuantityPDRStock =Int32.Parse(((string)args.Value));if (MaterialItem.HaveSr){ AddSerielNumber(i,true);}}"
                                                                       
                                                                      min="1"
                                                                      />
                                                       
                                                    </div>

                                                    <div class="warranty-container">
                                                        <div class="warranty-title">
                                                            <span class="warranty-icon"><RadzenIcon Icon="schedule" /></span>
                                                            Warranty Period
                                                        </div>
                                                        <div class="warranty-fields">
                                                            <div>
                                                                <label class="field-label">Years</label>
                                                                <RadzenNumeric Class="field-input"
                                                                               @bind-Value="@MaterialItem.Year"
                                                                               Name="MaterielWarrantyYear"
                                                                               ShowUpDown="false"
                                                                               Min="0" />
                                                            </div>
                                                            <div>
                                                                <label class="field-label">Months</label>
                                                                <RadzenNumeric Class="field-input"
                                                                               @bind-Value="@MaterialItem.Month"
                                                                               Name="MaterielWarrantyMonth"
                                                                               ShowUpDown="false"
                                                                               Min="0"
                                                                               Max="12" />
                                                            </div>
                                                        </div>
                                                    </div>

                                                    @if (MaterialItem.HaveSr)
                                                    {
                                                        <div class="serial-number-container">
                                                            <div class="serial-title">
                                                                <span class="serial-icon"><RadzenIcon Icon="pin" /></span>
                                                                Serial Numbers
                                                            </div>
                                                            @foreach (var (srNumber, j) in MaterialItem.SRList.Select((value, index) => (value, index)))
                                                            {
                                                                <div class="form-field">
                                                                    <label class="field-label">
                                                                        Serial Number @(j + 1)
                                                                        <span class="required-indicator">*</span>
                                                                    </label>
                                                                    <RadzenTextBox Class="field-input"
                                                                                   @bind-Value="@srNumber.SR"
                                                                                   Name='@("SerialNumber"+i.ToString()+j.ToString())'
                                                                                   Placeholder="Enter serial number" />
                                                                    <RadzenRequiredValidator Component='@("SerialNumber"+i.ToString()+j.ToString())' Text="Serial Number is required" />
                                                                </div>
                                                            }
                                                        </div>
                                                    }

                                                    <div class="card-actions">
                                                        <RadzenButton Disabled="@changeSR"
                                                                      Click="@(() => AddSerielNumber(i))"
                                                                      Text=@(MaterialItem.HaveSr ? "Remove Serial Number" : "Add Serial Number(s)")
                                                                      Icon=@(MaterialItem.HaveSr ? "remove_circle" : "add_circle")
                                                                      Size="ButtonSize.Medium"
                                                                      ButtonStyle="ButtonStyle.Light"
                                                                      Style="border-radius: 8px;"
                                                                      Shade="Shade.Lighter"
                                                                      Variant="Variant.Filled" />
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </ChildContent>
                                    <SummaryTemplate>

                                        <div style="margin-top: 1.5rem;">
                                            <table class="summary-table">
                                                <thead>
                                                    <tr>
                                                        <th>Material Name</th>
                                                        <th>Material Type</th>
                                                        <th>Quantity</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in MaterielsList)
                                                    {
                                                        <tr>
                                                            <td>@item.Materiel.MaterielName</td>
                                                            <td>@item.Materiel.Type</td>
                                                            <td>@item.Materiel.QuantityPDRStock</td>
                                                        </tr>
                                                    }
                                                    <tr>
                                                        <td colspan="2" style="text-align: right; font-weight: bold;">Total Items:</td>
                                                        <td style="font-weight: bold;">@MaterielsList.Sum(m => m.Materiel.QuantityPDRStock)</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </SummaryTemplate>
                                </RadzenFieldset>
                            </div>
                        </div>


                        <div class="submit-container">

                            <RadzenButton ButtonType="ButtonType.Submit"
                                          Text="Save Delivery Order"
                                          Icon="save" Size="ButtonSize.Medium" ButtonStyle="ButtonStyle.Info" Style=" border-radius: 8px;" Shade="Shade.Darker" Variant="Variant.Filled" />

                        </div>
                    </RadzenTemplateForm>

                </div>
            </RadzenCard>
        </div>
    </Authorized>
    <NotAuthorized>
        <ITStockM.Components.Pages.auth.RedirectToAccessDenied />
    </NotAuthorized>
</AuthorizeView>

