@page "/delivery-order-history"
@using ITStockM.Models.Constants
<AuthorizeView Roles="@($"{UserRoles.Admin},{UserRoles.Purchasing},{UserRoles.PDR}")">
    <Authorized>
<PageTitle>Delivery Order History</PageTitle>


<div class="container-fluid py-4">
    <RadzenCard class="mb-4 rz-shadow-2" Style="border-radius: 12px; border: none;">
        <div class="page-container">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenText Text="Delivery Order History"
                TextStyle="TextStyle.H3"
                TagName="TagName.H1"
                Style="margin: 0; text-transform: uppercase; font-weight: 600; letter-spacing: 1px; " />
            </RadzenColumn>



            <div class="search-export-container">
                <div class="search-container">
                    <span class="search-icon">🔍</span>
                    <RadzenTextBox Placeholder="Search..."
                    @oninput="@Search"
                    Class="search-box" />
                </div>

                <div class="export-container" >
                    <!---->
                   

                    <RadzenSplitButton ButtonStyle="ButtonStyle.Light"
                    Icon="download"
                    Text="Export"
                    Click="@ExportClick"
                    Style="border-radius: 8px; margin-right:15px;">
                        <RadzenSplitButtonItem Text="Excel" Value="xlsx" Icon="table_view" />
                        <RadzenSplitButtonItem Text="CSV" Value="csv" Icon="description" />
                    </RadzenSplitButton>

                    <RadzenButton Click="AdddDelayedMaterial" ButtonStyle="ButtonStyle.Light" Text="Add Delayed Materials" Icon="add_circle" Size="ButtonSize.Medium"
                                  Shade="Shade.Lighter" Variant="Variant.Flat" Style="border-radius:8px; " />
                </div>

            </div>

            <div class="datagrid-container">
                <RadzenDataGrid @ref="grid0"
                Data="@DeliveryOrders"
                TItem="ITStockM.Models.ITStockManagment.DeliveryOrder"
                AllowFiltering="true"
                AllowSorting="true"
                AllowPaging="true"
                PageSize="10"
                ShowPagingSummary="true"
                PageSizeOptions="@(new int[]{5, 10, 20, 30})">

                    <Columns>
                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.DeliveryOrder"
                        Property="DeleveryOrderNumber" Title="DON"
                        Width="25%">
                            <Template Context="data">
                                <div  class="quantity-badge">
                                    <span>@data.DeleveryOrderNumber</span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.DeliveryOrder"
                        Property="OrderNumber" Title="Order Number"
                        Width="25%">
                            <Template Context="data">
                                @if (data.OrderNumber != null){
                                    <div style="display: flex; align-items: center;">
                                        <span>@data.OrderNumber</span>
                                    </div>
                                }
                                else
                                {
                                    <div style="display: flex; align-items: center;">
                                        <span>[Need to Be filled]</span>
                                    </div>
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Width="150px" TextAlign="TextAlign.Center"
                        TItem="ITStockM.Models.ITStockManagment.DeliveryOrder"
                        Property="SupplierName"
                        Title="Supplier">
                            <Template Context="data">
                                <div style="display: flex; align-items: center;">
                                    @data.SupplierName
                                </div>
                            </Template>
                        </RadzenDataGridColumn>






                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.DeliveryOrder"
                        Property="Employee.FullName" Title="Registred By"
                        Width="25%">
                            <Template Context="data">
                                <div style="display: flex; align-items: center;">
                                    <span>@data.Employee.FullName</span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.DeliveryOrder"
                        Property="Date" Title="Date"
                        Width="25%">
                            <Template Context="data">
                                <div style="display: flex; align-items: center;">
                                    <span>@data.Date</span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.DeliveryOrder"
                        Filterable="false" Sortable="false" Width="15%"
                        TextAlign="TextAlign.Center">
                            <Template Context="data">
                                @if (data.OrderNumber != null)
                                {
                                    <RadzenButton ButtonStyle="ButtonStyle.Info"
                                    Icon="info"
                                    Size="ButtonSize.Medium"
                                    Style="border-radius: 8px;"
                                    Shade="Shade.Lighter"
                                    Variant="Variant.Flat"
                                    Class="info-button"
                                    Click="@(() => DeliveryOrderDetails(data))" />

                                }
                                else
                                {
                                       <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                    Icon="info"
                                    Size="ButtonSize.Medium"
                                    Style="border-radius: 8px;"
                                    Shade="Shade.Lighter"
                                    Variant="Variant.Flat"
                                    Class="info-button"
                                    Click="@(() => DeliveryOrderDetailsWithoutON(data))" />
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        

                        

                        
                    </Columns>
                </RadzenDataGrid>
            </div>
        </div>
    </RadzenCard>
</div>
</Authorized>
    <NotAuthorized>
        <ITStockM.Components.Pages.auth.RedirectToAccessDenied />
    </NotAuthorized>
       </AuthorizeView>


