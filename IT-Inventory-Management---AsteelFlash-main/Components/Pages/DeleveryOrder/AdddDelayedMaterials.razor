
<RadzenTemplateForm TItem="ITStockM.Models.ITStockManagment.DeliveryOrder"
                    Data="@SelectedDeliveryOrders"
                    Visible="@(SelectedDeliveryOrders != null)"
                    Submit="@AddDelayedMats"
                    @ref="form">

    <div class="delivery-order-selector">
        <div class="delivery-order-label">
            <span class="delivery-order-icon">
                <RadzenIcon Icon="local_shipping" />
            </span>
            Select Delivery Order
        </div>
        <RadzenDropDownDataGrid Data="@DeliveryOrders"
                                @bind-Value="@SelectedDeliveryOrders"
                                TextProperty="DeleveryOrderNumber"
                                Style="width: 100%; border-radius: 8px;"
                                AllowFilteringByAllStringColumns="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Class="field-input">
            <Columns>
                <RadzenDropDownDataGridColumn Property="DeleveryOrderNumber" Title="Delivery Order Number" />
                <RadzenDropDownDataGridColumn Property="OrderNumber" Title="Delivery Order Number" Visible="false" />
            </Columns>
        </RadzenDropDownDataGrid>
    </div>

    <div class="add-material-btn">
        <RadzenButton Click="@(() => AddMateriel())"
                      Text="Add Material"
                      ButtonStyle="ButtonStyle.Light"

                      Icon="add_circle"
                      Size="ButtonSize.Medium"
                      Shade="Shade.Lighter" Variant="Variant.Flat"
                     
                      Style="border-radius: 8px;" />
    </div>

    <div class="panel panel-materials">
        <div class="panel-header">
            <div class="panel-icon icon-materials">
                <RadzenIcon Icon="build" />
            </div>
            <h2 class="panel-title">Materials</h2>
        </div>

        <div class="panel-body">
            <RadzenFieldset AllowCollapse="true"
                            Style="margin: 2px auto; border-radius: 12px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                        <RadzenIcon Icon="expand_more" />
                        <b>Collapse/Expand Materials</b>
                    </RadzenStack>
                </HeaderTemplate>
                <ChildContent>
                    <div class="material-cards">
                        @foreach (var (MaterialItem, i) in MaterielsList.Select((value, index) => (value, index)))
                        {
                            <div class="material-card">
                                <div class="card-header">
                                    <h3 class="card-title">
                                        <span class="card-title-icon">
                                            <RadzenIcon Icon="inventory_2" />
                                        </span>
                                        Material @(i + 1)
                                    </h3>
                                    @if (i != 0)
                                    {
                                        <RadzenButton Click="@(() => RemoveMateriel(i))"
                                                      Icon="delete"
                                                      ButtonStyle="ButtonStyle.Danger"
                                                      Size="ButtonSize.Small"
                                                      Style="border-radius: 50%; width: 36px; height: 36px; padding: 0;"
                                                      Title="Remove Material" />
                                    }
                                </div>

                                <div class="form-field">
                                    <label class="field-label">
                                        Material Name
                                        <span class="required-indicator">*</span>
                                    </label>
                                    <RadzenAutoComplete Class="field-input"
                                                        @bind-Value="@MaterialItem.Materiel.MaterielName"
                                                        Name='@("MaterielName"+i.ToString())'
                                                        Data="@MaterialSuggestions"
                                                        AllowClear="true"
                                                        Placeholder="Type to search materials..."
                                                        Change="@(() => UpdateMaterialType(MaterialItem.Materiel.MaterielName, i))" />
                                    <RadzenRequiredValidator Component='@("MaterielName"+i.ToString())' Text="Material Name is required" />
                                </div>

                                <div class="form-field">
                                    <label class="field-label">
                                        Material Type
                                        <span class="required-indicator">*</span>
                                    </label>
                                    <RadzenDropDown TValue="string"
                                                    Data="@options"
                                                    Placeholder="Select a material type"
                                                    Class="field-input"
                                                    Name='@("MaterialType"+i.ToString())'
                                                    Change="@(()=>TypeSRChecker(i))"
                                                    @bind-Value="@MaterialItem.Materiel.Type" />
                                    <RadzenRequiredValidator Component='@("MaterialType"+i.ToString())' Text="Material Type is required" />
                                </div>

                                <div class="form-field">
                                    <label class="field-label">
                                        Quantity
                                        <span class="required-indicator">*</span>
                                    </label>
                                    <input type="number" Class="field-input"
                                           value="1"
                                           @onchange="(args) => {MaterialItem.Materiel.QuantityPDRStock =Int32.Parse(((string)args.Value));if (MaterialItem.HaveSr){ AddSerielNumber(i,true);}}"
                                           min="1" />

                                </div>

                                <div class="warranty-container">
                                    <div class="warranty-title">
                                        <span class="warranty-icon"><RadzenIcon Icon="schedule" /></span>
                                        Warranty Period
                                    </div>
                                    <div class="warranty-fields">
                                        <div>
                                            <label class="field-label">Years</label>
                                            <RadzenNumeric Class="field-input"
                                                           @bind-Value="@MaterialItem.Year"
                                                           Name="MaterielWarrantyYear"
                                                           ShowUpDown="false"
                                                           Min="0" />
                                        </div>
                                        <div>
                                            <label class="field-label">Months</label>
                                            <RadzenNumeric Class="field-input"
                                                           @bind-Value="@MaterialItem.Month"
                                                           Name="MaterielWarrantyMonth"
                                                           ShowUpDown="false"
                                                           Min="0"
                                                           Max="12" />
                                        </div>
                                    </div>
                                </div>

                                @if (MaterialItem.HaveSr)
                                {
                                    <div class="serial-number-container">
                                        <div class="serial-title">
                                            <span class="serial-icon"><RadzenIcon Icon="pin" /></span>
                                            Serial Numbers
                                        </div>
                                        @foreach (var (srNumber, j) in MaterialItem.SRList.Select((value, index) => (value, index)))
                                        {
                                            <div class="form-field">
                                                <label class="field-label">
                                                    Serial Number @(j + 1)
                                                    <span class="required-indicator">*</span>
                                                </label>
                                                <RadzenTextBox Class="field-input"
                                                               @bind-Value="@srNumber.SR"
                                                               Name='@("SerialNumber"+i.ToString()+j.ToString())'
                                                               Placeholder="Enter serial number" />
                                                <RadzenRequiredValidator Component='@("SerialNumber"+i.ToString()+j.ToString())' Text="Serial Number is required" />
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="card-actions">
                                    <RadzenButton Disabled="@changeSR"
                                                  Click="@(() => AddSerielNumber(i))"
                                                  Text=@(MaterialItem.HaveSr ? "Remove Serial Numbers" : "Add Serial Numbers")
                                                  Icon=@(MaterialItem.HaveSr ? "remove_circle" : "add_circle")
                                                  Size="ButtonSize.Medium"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  Style="border-radius: 8px;"
                                                  Shade="Shade.Lighter"
                                                  Variant="Variant.Flat" />
                                </div>
                            </div>
                        }
                    </div>
                </ChildContent>
                <SummaryTemplate>
                    <div style="margin-top: 1.5rem;">
                        <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 1rem; color: var(--primary); display: flex; align-items: center; gap: 0.5rem;">
                            <RadzenIcon Icon="summarize" />
                            Materials Summary
                        </h3>
                        <table class="summary-table">
                            <thead>
                                <tr>
                                    <th>Material Name</th>
                                    <th>Material Type</th>
                                    <th>Quantity</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in MaterielsList)
                                {
                                    <tr>
                                        <td>@item.Materiel.MaterielName</td>
                                        <td>@item.Materiel.Type</td>
                                        <td>@item.Materiel.QuantityPDRStock</td>
                                    </tr>
                                }
                                <tr>
                                    <td colspan="2" style="text-align: right;">Total Items:</td>
                                    <td>@MaterielsList.Sum(m => m.Materiel.QuantityPDRStock)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </SummaryTemplate>
            </RadzenFieldset>
        </div>
    </div>

    <div class="submit-container">
        <RadzenButton ButtonType="ButtonType.Submit"
                      Text="Save Materials"
                      Icon="save"
                      Size="ButtonSize.Medium"
                      ButtonStyle="ButtonStyle.Info"
                      Style="border-radius: 8px;   padding: 0.75rem 1.5rem;"
                      Shade="Shade.Darker" Variant="Variant.Filled" />
    </div>
</RadzenTemplateForm>