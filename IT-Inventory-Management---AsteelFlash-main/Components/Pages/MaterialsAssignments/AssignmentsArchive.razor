@page "/assignments-archive"

@using ITStockM.Models.Constants
<AuthorizeView Roles="@UserRoles.Admin">
    <Authorized>


        <PageTitle>Assignments Archive</PageTitle>

        

        <div class="container-fluid py-4">
            <RadzenCard class="mb-4 rz-shadow-2" Style="border-radius: 12px; border: none;">
                <div class="page-container">
                    <RadzenText Text="Archived Assignments"
                                    TextStyle="TextStyle.H3"
                                    TagName="TagName.H1"
                                    Style="margin: 0; text-transform: uppercase; font-weight: 600; letter-spacing: 1px; margin-bottom:25px;" />



                    <div class="search-export-container">
                        <div class="search-container">
                            <span class="search-icon">🔍</span>
                            <RadzenTextBox Placeholder="Search..."
                                           @oninput="@Search"
                                           Class="search-box" />
                        </div>

                        <div class="export-container">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="1rem">

                                <RadzenDropDown Data="@Assignments"
                                                Placeholder="Select Assignments"
                                                Class="field-input"
                                                TValue="string"
                                                @bind-Value="@SelectedAssignment"
                                                Name="Type"
                                                Change="AssignemntFilter"
                                                Style="width : 130px; border-radius:8px" />

                                <RadzenSplitButton ButtonStyle="ButtonStyle.Light"
                                                   Icon="download"
                                                   Text="Export"
                                                   Click="@ExportClick"
                                                   Style="border-radius: 8px;">
                                                   
                                    <RadzenSplitButtonItem Text="Excel" Value="xlsx" Icon="table_view" />
                                    <RadzenSplitButtonItem Text="CSV" Value="csv" Icon="description" />
                                </RadzenSplitButton>


                            </RadzenStack>
                        </div>

                    </div>

                    <div class="datagrid-container">
                        <RadzenDataGrid @ref="grid0"
                                        Data="@assignmentMateriels"
                                        TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                        AllowFiltering="true"
                                        AllowSorting="true"
                                        AllowPaging="true"
                                        PageSize="10"
                                        ShowPagingSummary="true"
                                        PageSizeOptions="@(new int[]{5, 10, 20, 30})">
                            <Columns>
                                <RadzenDataGridColumn Width="90px" TextAlign="TextAlign.Center"
                                                      TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                                      Property="AssignmentId"
                                                      Title="ID">
                                    <Template Context="data">
                                        <div class="quantity-badge">
                                            @data.AssignmentId
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                                      Property="Materiel.MaterielName" Title="Material Name"
                                                      Width="40%">
                                    <Template Context="data">
                                        <div style="display: flex; align-items: center;">
                                            <span>@data.Materiel?.MaterielName</span>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>

                               

                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                                      Property="Assignment.Employee.FullName" Title="Assigned By"
                                                      Width="25%">
                                    <Template Context="data">
                                        <div style="display: flex; align-items: center;">
                                            <span>@data.Assignment?.Employee?.FullName</span>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                                      Title="Assigned To"
                                                      Width="25%">
                                    <Template Context="data">
                                        <div style="display: flex; align-items: center;">
                                            @if (data.Assignment?.AssignedTo != null)
                                            {
                                                <RadzenBadge BadgeStyle="BadgeStyle.Secondary"
                                                             Shade="Shade.Lighter"
                                                             Style="padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.8rem; font-weight: 500;"
                                                             Text="@data.Assignment?.AssignedEmployee?.FullName" />
                                            }
                                            else
                                            {
                                                <RadzenBadge BadgeStyle="BadgeStyle.Info"
                                                             Shade="Shade.Lighter"
                                                             Style="padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.8rem; font-weight: 500;"
                                                             Text="@data.Assignment?.Project?.ProjectName" />
                                            }
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>




                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                                      Property="Assignment.Date" Title="Date"
                                                      Width="25%">
                                    <Template Context="data">
                                        <div style="display: flex; align-items: center;">
                                            <span>@data.Assignment.Date.ToString("MMM dd,yyyy")</span>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                                      Filterable="false" Sortable="false" Width="15%"
                                                      TextAlign="TextAlign.Center">
                                    <Template Context="data">
                                        <RadzenButton ButtonStyle="ButtonStyle.Info"
                                                      Icon="info"
                                                      Size="ButtonSize.Medium"
                                                      Style="border-radius: 8px;"
                                                      Shade="Shade.Lighter"
                                                      Variant="Variant.Flat"
                                                      Class="info-button"
                                                      Click="@(() => AssignmentDetails(data))" />
                                    </Template>
                                </RadzenDataGridColumn>

                            </Columns>
                        </RadzenDataGrid>
                    </div>
                </div>
            </RadzenCard>
        </div>




    </Authorized>
    <NotAuthorized>
        <ITStockM.Components.Pages.auth.RedirectToAccessDenied />
    </NotAuthorized>
</AuthorizeView>
