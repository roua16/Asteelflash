<PageTitle>Materials Assignments Details</PageTitle>
<div class="page-container archived-materials-assignment-details-page">
    <h1 class="page-title">Materials Assignment Details</h1>

    <div class="details-card material-card">
        <div class="card-header">
            <RadzenText TextStyle="TextStyle.H6" Class="section-heading">Material Details</RadzenText>
            <span class="card-header-icon">
                <RadzenIcon Icon="Inventory_2" />
            </span>
        </div>

        <div class="property-grid">
            <div class="property-item material-property">
                <div class="property-label">Material Name</div>
                <div class="property-value">@AssignmentMateriel.Materiel.MaterielName</div>
            </div>

            <div class="property-item material-property">
                <div class="property-label">Type</div>
                <div class="property-value">@AssignmentMateriel.Materiel.Type</div>
            </div>

            <div class="property-item material-property">
                <div class="property-label">Warranty</div>
                <div class="property-value">@AssignmentMateriel.Materiel.Warranty</div>
            </div>

            @if (AssignmentMateriel.Materiel.SerialNumber != null)
            {
                <div class="property-item material-property">
                    <div class="property-label">Serial Number</div>
                    <div class="property-value">@AssignmentMateriel.Materiel.SerialNumber</div>
                </div>
            }
        </div>

        <div class="description-section">
            <div class="property-label material-property">Description</div>
            <div class="property-value description-value">
                @if (string.IsNullOrEmpty(AssignmentMateriel.Assignment.Descipriton))
                {
                    <span class="no-description">No description available</span>
                }
                else
                {
                    @AssignmentMateriel.Assignment.Descipriton
                }
            </div>
        </div>


    </div>

    @if (AssignmentMateriel.Assignment.AssignedTo != null)
    {
        <div class="assignment-connector">
            <div class="connector-line"></div>
            <div class="connector-circle"> <RadzenIcon Icon="person" /></div>
        </div>

        <div class="details-card employee-card">
            <div class="card-header">
                <RadzenText TextStyle="TextStyle.H6" Class="section-heading">Employee Details</RadzenText>
                <span class="card-header-icon">
                    <RadzenIcon Icon="person" />
                </span>
            </div>

            <div class="property-grid">
                <div class="property-item employee-property">
                    <div class="property-label">Full Name</div>
                    <div class="property-value">@AssignmentMateriel.Assignment.AssignedEmployee.FullName</div>
                </div>

                @if (AssignmentMateriel.Materiel.SerialNumber != "")
                {
                    <div class="property-item employee-property">
                        <div class="property-label">Email</div>
                        <div class="property-value">@AssignmentMateriel.Assignment.AssignedEmployee.Email</div>
                    </div>
                }

                <div class="property-item employee-property">
                    <div class="property-label">Post</div>
                    <div class="property-value">@AssignmentMateriel.Assignment.AssignedEmployee.Post</div>
                </div>

                <div class="property-item employee-property">
                    <div class="property-label">Service</div>
                    <div class="property-value">@AssignmentMateriel.Assignment.AssignedEmployee.Service</div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="assignment-connector">
            <div class="connector-line"></div>
            <div class="connector-circle"> <RadzenIcon Icon="Auto_Awesome_Mosaic" /></div>
        </div>

        <div class="details-card employee-card">
            <div class="card-header">
                <RadzenText TextStyle="TextStyle.H6" Class="section-heading">Project Details</RadzenText>
                <span class="card-header-icon">
                    <RadzenIcon Icon="Auto_Awesome_Mosaic" />
                </span>
            </div>

            <div class="property-grid">
                <div class="property-item employee-property">
                    <div class="property-label">Project Name</div>
                    <div class="property-value">@AssignmentMateriel.Assignment.Project.ProjectName</div>
                </div>
            </div>
        </div>
    }

   
</div>

