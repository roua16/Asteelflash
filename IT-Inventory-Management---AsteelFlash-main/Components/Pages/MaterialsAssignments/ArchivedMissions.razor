@page "/archived-missions"
@using ITStockM.Models.ITStockManagment



@using ITStockM.Models.Constants
<AuthorizeView Roles="@($"{UserRoles.Admin},{UserRoles.Purchasing}")">
    <Authorized>
                
        <PageTitle>Archived Missions</PageTitle>

        <div class="container-fluid py-4">
            <RadzenCard class="mb-4 rz-shadow-2" Style="border-radius: 12px; border: none;">
                <!-- Header Section -->
                <RadzenRow AlignItems="AlignItems.Center" class="mb-4">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText Text="Archived Missions"
                                    TextStyle="TextStyle.H3"
                                    TagName="TagName.H1"
                                    Style="margin: 0; text-transform: uppercase; font-weight: 600; letter-spacing: 1px; margin-bottom:25px;" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6" Class="d-flex justify-content-md-end mt-3 mt-md-0">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="1rem">
                            <RadzenSplitButton ButtonStyle="ButtonStyle.Light"
                                               Icon="download"
                                               Text="Export"
                                               Style="border-radius: 8px;"
                                               Click="@ExportClick">
                                <RadzenSplitButtonItem Text="Excel" Value="xlsx" Icon="table_view" />
                                <RadzenSplitButtonItem Text="CSV" Value="csv" Icon="description" />
                            </RadzenSplitButton>
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow class="mb-4">
                    <RadzenColumn Size="12">
                        <div class="position-relative">
                            <RadzenTextBox Placeholder="🔍 Search missions..." aria-label="Search by all string columns" @oninput="@Search"
                                           Style="display: block;width: 100%;padding: 10px;border: 1px solid #ccc;border-radius: 8px;  box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);" Icon="find_in_page" />
                            <i class="rzi rzi-search position-absolute" style="left: 0.75rem; top: 50%; transform: translateY(-50%);"></i>
                        </div>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenDataGrid @ref="grid0"
                                AllowFiltering="true"
                                FilterMode="FilterMode.Advanced"
                                AllowPaging="true"
                                AllowSorting="true"
                                PageSize="10"
                                ShowPagingSummary="true"
                                PageSizeOptions="@(new int[]{5, 10, 20, 30})"
                                Data="@assignmentMateriels"
                                TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                Style="border-radius: 10px; overflow: hidden; border: none;"
                                EmptyText="No archived missions found">
                    <Columns>
                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel" Property="AssignmentId" Title="ID" Width="80px" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                <div style="display: flex; justify-content: center; align-items: center;">
                                   
                                        <div class="quantity-badge">
                                            @item.AssignmentId.ToString()
                                        </div>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel" Title="Date" Width="120px">
                            <Template Context="item">
                                <div class="d-flex align-items-center">
                                    <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 500;">
                                        @(((DateTime?)item.Assignment.Date)?.ToString("MMM dd, yyyy"))
                                    </RadzenText>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel" Property="Materiel.MaterielName" Title="Material Name" Width="180px">
                            <Template Context="item">
                                <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 500;">@item.Materiel.MaterielName</RadzenText>
                            </Template>
                        </RadzenDataGridColumn>

                        

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel" Property="Assignment.Employee.FullName" Title="Assigned By" Width="150px">
                            <Template Context="item">
                                <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 500;">@item.Assignment.Employee.FullName</RadzenText>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel" Property="Assignment.AssignedEmployee.FullName" Title="Assigned To" Width="150px">
                            <Template Context="data">
                                <div style="display: flex; align-items: center;">
                                    @if (data.Assignment?.AssignedTo != null)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Secondary"
                                                     Shade="Shade.Lighter"
                                                     Style="padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.8rem; font-weight: 500;"
                                                     Text="@data.Assignment?.AssignedEmployee?.FullName" />
                                    }
                                    else
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Info"
                                                     Shade="Shade.Lighter"
                                                     Style="padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.8rem; font-weight: 500;"
                                                     Text="@data.Assignment?.Project?.ProjectName" />
                                    }
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel" Title="Date Limit" Width="120px">
                            <Template Context="item">
                                <RadzenText TextStyle="TextStyle.Body1">
                                    @(((DateTime?)item.Assignment.RestoreDateLimit)?.ToString("MMM dd, yyyy"))
                                </RadzenText>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel" Property="Assignment.RestoreDate" Title="Restore Date" Width="120px">
                            <Template Context="item">
                                @if (item.Assignment.RestoreDate.HasValue)
                                {
                                    <RadzenText TextStyle="TextStyle.Body1">
                                        @(item.Assignment.RestoreDate.Value.ToString("MMM dd, yyyy"))
                                    </RadzenText>
                                }
                                else
                                {
                                    <RadzenText TextStyle="TextStyle.Body1" class="rz-color-text-secondary">Not returned</RadzenText>
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel" Title="Status" Width="120px">
                            <Template Context="item">
                                <div style="display: flex; justify-content: center; align-items: center;">
                                    <RadzenBadge BadgeStyle="@GetReturnStatusStyle(item)"
                                                 Shade="Shade.Lighter"
                                                 Style="padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.8rem; font-weight: 500;"
                                                 Text="@GetReturnStatusText(item)" />
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel" Filterable="false" Sortable="false" Width="120px" TextAlign="TextAlign.Center" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                            <Template Context="assignmentMateriel">
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.5rem">
                                    <RadzenButton ButtonStyle="ButtonStyle.Info"
                                                  Icon="info"
                                                  Size="ButtonSize.Medium"
                                                  Style="border-radius: 8px;"
                                                  Shade="Shade.Lighter"
                                                  Variant="Variant.Flat"
                                                  Title="View Details"
                                                  Click="@(() => AssignmentDetails(assignmentMateriel))" />
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                    <EmptyTemplate>
                        <div class="d-flex flex-column align-items-center justify-content-center py-5">
                            <i class="rzi rzi-assignment-turned-in mb-3" style="font-size: 3rem; opacity: 0.5;"></i>
                            <RadzenText TextStyle="TextStyle.H6">No archived missions found</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" class="rz-color-text-secondary">Try adjusting your search or filters</RadzenText>
                        </div>
                    </EmptyTemplate>
                </RadzenDataGrid>
            </RadzenCard>
        </div>


    </Authorized>
    <NotAuthorized>
        <ITStockM.Components.Pages.auth.RedirectToAccessDenied />
    </NotAuthorized>
</AuthorizeView>


