
<PageTitle>Add Assignment</PageTitle>


<div class="container-fluid py-4">
    <RadzenCard class="rz-shadow-2" Style="border-radius: 12px; border: none;">
        <div class="form-container">
            <div class="form-header">
                <RadzenText Text="Add New Assignment" TextStyle="TextStyle.H4" TagName="TagName.H1"
                Style="font-weight: 600; margin: 0;" />
            </div>

            @if (errorVisible)
            {
                <div class="error-alert">
                    <span class="error-icon">⚠️</span>
                    <div>
                        <strong>Error:</strong> Cannot save assignment. Please check the form for errors and try again.@errorMsg
                    </div>
                </div>
            }

            <RadzenTemplateForm TItem="ITStockM.Models.ITStockManagment.Assignment" Data="@assignment" Visible="@(assignment != null)" Submit="@FormSubmit">

                <!--            Materials                 -->

                <div class="form-section section-material">
                    <div class="section-title">
                        <span class="section-icon icon-material"><RadzenIcon Icon="Inventory_2"></RadzenIcon></span>
                        Material Selection

                        <RadzenButton Click="addMaterial"
                        ButtonStyle="ButtonStyle.Light" Icon="add_circle" Size="ButtonSize.Medium"
                        Shade="Shade.Lighter" Variant="Variant.Flat" Style="border-radius:8px;"
                        class="add-material-btn" />
                    </div>

                    @foreach (var (material, i) in listMaterials.Select((value, index) => (value, index)))
                    {
                        <RadzenFieldset Style="margin: 12px auto; border-radius: 12px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
                            <HeaderTemplate>
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <b>Material @(i+1) </b>
                                </RadzenStack>
                            </HeaderTemplate>
                            <ChildContent>
                                <div class="form-field">
                                    <div class="label-container">
                                        <label class="field-label">
                                            Select Material
                                            <span class="required-indicator">*</span>
                                        </label>

                                        @if (i != 0)
                                        {
                                            <RadzenButton Click="@(()=>deleteMaterial(i))"
                                            Icon="Close"
                                            ButtonStyle="ButtonStyle.Light"
                                            Size="ButtonSize.Small"
                                            Style="border-radius: 8px; display: flex; align-items: center; gap: 0.5rem; font-weight: 500; transition: all 0.2s;"
                                            Shade="Shade.Lighter"
                                            Variant="Variant.Outlined"
                                            class="delete-material-btn" />
                                        }
                                    </div>

                                    <RadzenDropDownDataGrid @ref="myDropDowns[i]" Class="field-input" @bind-Value=@material.Materiel Data=@materiels TextProperty="MaterielName" AllowColumnResize="true" AllowFilteringByAllStringColumns="true" Name="@("DropDownDataGridColumns"+i)" Placeholder="Select Material" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Change="@((args) => RemoveMatOnSelect(args, i))">
                                        <Columns>
                                            <RadzenDropDownDataGridColumn Property="@nameof(ITStockM.Models.ITStockManagment.Materiel.MaterielName)" Title="Material Name" Width="200px" />
                                            <RadzenDropDownDataGridColumn Property="@nameof(ITStockM.Models.ITStockManagment.Materiel.SerialNumber)" Title="Serial Number" Width="100px" Visible="false" />
                                            <RadzenDropDownDataGridColumn Property="@nameof(ITStockM.Models.ITStockManagment.Materiel.Type)" Title="Type" Width="100px" Visible="false" />
                                        </Columns>
                                    </RadzenDropDownDataGrid>
                                    <RadzenRequiredValidator Component="@("DropDownDataGridColumns"+i)" Text="Assignee is required" />
                                </div>

                                @if (material.Materiel != null && material.Materiel.SerialNumber != null && material.Materiel.SerialNumber != "")
                                {
                                    <div class="serial-number-display">
                                        <span class="serial-number-icon">🔢</span>
                                        <span>Serial Number: <strong>@material.Materiel.SerialNumber</strong></span>
                                    </div>
                                }

                                <div class="form-field">
                                    <label class="field-label">
                                        Quantity
                                        <span class="required-indicator">*</span>
                                    </label>
                                    <RadzenNumeric Class="field-input"
                                    @bind-Value="@material.Qtee"
                                    ShowUpDown="false"
                                    Name="Quantity"
                                    Min="1"
                                    Max="@(material.Materiel !=null ? material.Materiel.QuantityITStock : 0)" />
                                    <div class="field-helper">
                                        Available: @(material.Materiel != null ? material.Materiel.QuantityITStock : 0)
                                    </div>
                                    <RadzenRequiredValidator Component="Quantity" Text="Quantity is required" />
                                </div>
                            </ChildContent>
                        </RadzenFieldset>
                    }
                </div>


                <div class="form-section section-assignment">
                    <div class="section-title">
                        <span class="section-icon icon-assignment"><RadzenIcon Icon="Group"></RadzenIcon></span>
                        Assignment Information
                    </div>

                    <div class="form-field">
                        <label class="field-label">
                            Person Or Project
                        </label>
                        <RadzenRadioButtonList @bind-Value=@personOrProject TValue="int">
                            <Items>
                                <RadzenRadioButtonListItem Text="Person" Value="1" />
                                <RadzenRadioButtonListItem Text="Project" Value="2" />
                            </Items>
                        </RadzenRadioButtonList>
                    </div>
                    @if (personOrProject == 1)
                    {

                        assignment.ProjectId = null;

                        <div class="form-field">
                            <label class="field-label">
                                Assigned To (Employee)
                                <span class="required-indicator">*</span>
                            </label>
                            <RadzenDropDownDataGrid Data="@employeesForAssignedBy"
                            TextProperty="FullName"
                            ValueProperty="Id"
                            AllowClear="true"
                            Class="field-input"
                            @bind-Value="@assignment.AssignedTo"
                            Name="AssignedTo"
                            Placeholder="Select employee" />
                            <RadzenRequiredValidator Component="AssignedTo" Text="Employee is required" />
                        </div>
                    }
                    else
                    {
                        assignment.AssignedTo = null;

                        <div class="form-field">
                            <label class="field-label">
                                Assigned to (Project)
                                <span class="required-indicator">*</span>
                            </label>
                            <RadzenDropDownDataGrid Data="@projects"
                            TextProperty="ProjectName"
                            ValueProperty="Id"
                            AllowClear="true"
                            Class="field-input"
                            @bind-Value="@assignment.ProjectId"
                            Name="ProjectName"
                            Placeholder="Select project" />
                            <RadzenRequiredValidator Component="ProjectName" Text="Project is required" />
                        </div>
                    }


                </div>

                <div class="form-section section-details">
                    <div class="section-title">
                        <span class="section-icon icon-details"><RadzenIcon Icon="Description"></RadzenIcon></span>
                        Assignment Details
                    </div>

                    <div class="form-field">
                        <label class="field-label">
                            Description
                            <span class="required-indicator">*</span>
                        </label>
                        <RadzenTextBox Class="field-input"
                        @bind-Value="@assignment.Descipriton"
                        Name="Descipriton"
                        Placeholder="Enter assignment description" />
                        <RadzenRequiredValidator Component="Descipriton" Text="Description is required" />
                    </div>
                    @if (personOrProject == 1)
                    {

                        <div class="form-field">
                            <label class="field-label">
                                Assignment Type
                                <span class="required-indicator">*</span>
                            </label>
                            <RadzenDropDownDataGrid Data="options"
                            TextProperty="Label"
                            ValueProperty="Value"
                            AllowClear="true"
                            Class="field-input"
                            @bind-Value="@assignment.OnMission"
                            Name="AssignmentType"
                            Placeholder="Select assignment type" />
                            <RadzenRequiredValidator Component="AssignmentType" Text="Assignment type is required" />
                        </div>
                    }
                    else
                    {
                        assignment.OnMission = false;
                    }
                    

                    @if ( assignment.OnMission == true )
                    {
                        <div class="conditional-section">
                            <div class="form-field">
                                <label class="field-label">
                                    Return Deadline
                                    <span class="required-indicator">*</span>
                                </label>
                                <RadzenDatePicker DateFormat="MM/dd/yyyy"
                                                  Class="field-input"
                                                  @bind-Value="@assignment.RestoreDateLimit"
                                                  Name="Date"
                                                  Placeholder="Select return deadline"
                                                  Min="DateTime.Today"/>
                                <div class="field-helper">
                                    The date by which the material must be returned
                                </div>
                                <RadzenRequiredValidator Component="Date" Text="Return deadline is required for mission assignments" />
                            </div>
                        </div>
                    }
                </div>

                <RadzenStack Style="margin-top: 2rem;"
                             Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.Center"
                             Gap="1rem">
                    <RadzenButton Text="Save" ButtonType="ButtonType.Submit" Icon="save" Size="ButtonSize.Medium" ButtonStyle="ButtonStyle.Info" Style=" border-radius: 8px;" Shade="Shade.Darker" Variant="Variant.Filled" />
                    <RadzenButton Icon="highlight_off" Text="Cancel" Size="ButtonSize.Medium" ButtonStyle="ButtonStyle.Danger" Style=" border-radius: 8px;" Shade="Shade.Darker" Variant="Variant.Filled" Click="@CancelButtonClick" />
                </RadzenStack>
            </RadzenTemplateForm>
        </div>
    </RadzenCard>
</div>