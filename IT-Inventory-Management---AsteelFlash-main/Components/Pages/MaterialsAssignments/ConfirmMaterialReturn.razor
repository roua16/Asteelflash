<div class="form-container">
    <div class="section-header">
        <h2 class="section-title">
            <div class="section-icon icon-condition">
                <RadzenIcon Icon="settings" />
            </div>
            Material Details
        </h2>
    </div>

    <div class="form-field">
        <label class="field-label">
            Material Condition
            <span class="required-indicator">*</span>
        </label>
        <RadzenDropDown Data="@options"
                        @bind-Value="@selectedOption"
                        Style="width: 100%;"
                        Class="field-input"
                        Placeholder="Select condition..." />
    </div>

    @if (HasSN)
    {
        <div class="form-field">
            <label class="field-label">
                Quantity
                <span class="required-indicator">*</span>
            </label>
            <div class="quantity-container">
                <div class="quantity-input">
                    <RadzenNumeric @bind-Value="@qte"
                                   Min="1"
                                   Max="MaxQte"
                                   Style="width: 100%;"
                                   Class="field-input"
                                   Placeholder="Enter quantity..." />
                </div>
                <div class="quantity-max">
                    <RadzenIcon Icon="inventory" />
                    <span>Maximum Available:</span>
                    <span class="quantity-max-value">@MaxQte</span>
                </div>
            </div>
        </div>
    }

    <!-- Optional: Other material returned (not part of assignment) -->
    <div class="form-field">
        <label class="field-label">Other material returned (optional)</label>
        <RadzenTextBox @bind-Value="@otherName" Placeholder="Material name (leave blank if none)" Class="field-input" />
    </div>
    <div class="form-field">
        <label class="field-label">Other material quantity</label>
        <RadzenNumeric @bind-Value="@otherQty" Min="0" Style="width: 150px;" Class="field-input" />
        <div style="font-size:0.85rem;color:var(--gray-600);margin-top:6px;">If you specify a material name, quantity &gt; 0 will be added to inventory (or created if missing).</div>
    </div>
</div>

<div class="form-container">
    <div class="section-header">
        <h2 class="section-title">
            <div class="section-icon icon-description">
                <RadzenIcon Icon="description" />
            </div>
            Description
        </h2>
    </div>

    <div class="form-field">
        <label class="field-label">
            Additional Details
        </label>
        <RadzenTextArea @bind-Value="@description"
                        Class="field-input"
                        Placeholder="Enter description or additional notes..."
                        Rows="4" />
    </div>
</div>

<div class="actions-container">
    <RadzenButton Click="()=>Submit()"
                  Text="Confirm"
                  ButtonStyle="ButtonStyle.Info"
                  Icon="done"
                  Size="ButtonSize.Medium"
                  Style="border-radius: 8px; font-weight: 500; margin-top:10px;"
                  Class="action-button"
                  Shade="Shade.Darker" Variant="Variant.Filled" />

    <RadzenButton Click="()=>{DialogService.Close(null);}"
                  Text="Cancel"
                  ButtonStyle="ButtonStyle.Danger"
                  Icon="highlight_off"
                  Size="ButtonSize.Medium"
                  Style="border-radius: 8px; font-weight: 500; margin-top:10px;"
                  Class="action-button"
                  Shade="Shade.Darker" Variant="Variant.Filled" />

   
</div>