@page "/mission-interface"

<PageTitle>Mission Interface</PageTitle>


<div class="container-fluid py-4">
    <RadzenCard class="mb-4 rz-shadow-2" Style="border-radius: 12px; border: none;">
        <div class="page-container">
            <div class="page-title">
                <RadzenText Text="Mission Management" TextStyle="TextStyle.H3" TagName="TagName.H1"
                            Style="text-transform: uppercase; font-weight: 600; letter-spacing: 1px;" />
            </div>

            <div class="mission-summary">
                <RadzenText TextStyle="TextStyle.H6" Style="margin-top: 0;">Active Missions Overview</RadzenText>
                

                <div class="mission-stats">
                    <div class="stat-item">
                        <div class="stat-icon"><RadzenIcon Icon="Category"></RadzenIcon></div>
                        <div class="stat-content">
                            <div class="stat-label">Total Items</div>
                            <div class="stat-value">@(assignmentMateriels?.Count() ?? 0)</div>
                        </div>
                    </div>

                    <div class="stat-item">
                        <div class="stat-icon"><RadzenIcon Icon="Group"></RadzenIcon></div>
                        <div class="stat-content">
                            <div class="stat-label">Assigned To</div>
                            <div class="stat-value">@(assignmentMateriels?.Select(a => a.Assignment?.AssignedTo).Distinct().Count() ?? 0)</div>
                        </div>
                    </div>

                    <div class="stat-item">
                        <div class="stat-icon"><RadzenIcon Icon="Timer"></RadzenIcon></div>
                        <div class="stat-content">
                            <div class="stat-label">Expiring Soon</div>
                            <div class="stat-value">@(assignmentMateriels?.Count(a => a.Assignment?.RestoreDateLimit != null && a.Assignment.RestoreDateLimit <= DateTime.Now.AddDays(7)) ?? 0)</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="datagrid-container">
                <RadzenDataGrid @ref="grid0"
                                Data="@assignmentMateriels"
                                TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                AllowFiltering="true"
                                AllowSorting="true"
                                AllowPaging="true"
                                PageSize="10"
                                ColumnWidth="150px"
                                AllowColumnResize="true"
                                    ShowPagingSummary="true"
                                PageSizeOptions="@(new int[]{5, 10, 20, 30})">
                    <Columns>
                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                              Property="Assignment.RestoreDateLimit"
                                              Title="Return Deadline">
                            <Template Context="data">
                                @{
                                    var restoreDate = data.Assignment?.RestoreDateLimit;
                                    var today = DateTime.Now;
                                    string badgeClass = "";

                                    if (restoreDate.HasValue)
                                    {
                                        var daysLeft = (restoreDate.Value - today).TotalDays;
                                        badgeClass = daysLeft <= 0 ? "date-danger" :
                                        daysLeft <= 7 ? "date-warning" : "date-normal";
                                    }
                                }
                                <div class="date-badge @badgeClass">
                                    @(restoreDate?.ToString("yyyy-MM-dd") ?? "No deadline")
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                              Property="Materiel.MaterielName"
                                              Title="Mat Name"
                                              
                                             >
                            <Template Context="data">
                                <div style="display: flex; align-items: center;">
                                    <span>@data.Materiel?.MaterielName</span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn 
                                              TextAlign="TextAlign.Center"
                                              TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                              Property="Qte"
                                              Title="QTE"
                                              Width="110px;"
                                              >
                            <Template Context="data">
                                <div class="quantity-badge">
                                    @data.Qte
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                              Property="Assignment.Employee.FullName"
                                              Title="Assigned By"
                                              >
                            <Template Context="data">
                                <div style="display: flex; align-items: center;">
                                    <span>@data.Assignment?.Employee?.FullName</span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                              Title="Assigned To"
                                              >
                            <Template Context="data">
                                <div style="display: flex; align-items: center;">
                                    @if (data.Assignment?.AssignedTo != null)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Secondary"
                                                     Shade="Shade.Lighter"
                                                     Style="padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.8rem; font-weight: 500;"
                                                     Text="@data.Assignment?.AssignedEmployee?.FullName" />
                                    }
                                    else
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Info"
                                                     Shade="Shade.Lighter"
                                                     Style="padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.8rem; font-weight: 500;"
                                                     Text="@data.Assignment?.Project?.ProjectName" />
                                    }
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                              Property="Assignment.Date"
                                              Title="Start Date"
                                              >
                            <Template Context="data">
                                <div style="display: flex; align-items: center;">
                                    <span>@data.Assignment?.Date.ToString("MMM dd, yyyy")</span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        

                        <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                              Filterable="false"
                                              Sortable="false"
                                              TextAlign="TextAlign.Center"
                                              Frozen="true"
                                              FrozenPosition="FrozenColumnPosition.Right">
                            <Template Context="data">
                                <RadzenButton ButtonStyle="ButtonStyle.Info"
                                              Shade="Shade.Darker" Variant="Variant.Filled"
                                              Icon="assignment_return"
                                              Text="Restore"
                                              Size="ButtonSize.Small"
                                              Class="restore-button"
                                              Click="@(() => MissionEnd(data))" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                    <EmptyTemplate>
                        <div class="empty-state">
                            <div class="empty-state-icon">📭</div>
                            <div class="empty-state-title">No active missions found</div>
                            <div class="empty-state-description">There are currently no materials assigned to missions. All equipment is accounted for in inventory.</div>
                        </div>
                    </EmptyTemplate>
                </RadzenDataGrid>
            </div>
        </div>
    </RadzenCard>
</div>

