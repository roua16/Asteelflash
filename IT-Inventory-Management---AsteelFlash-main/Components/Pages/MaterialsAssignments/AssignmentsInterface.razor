@page "/assignments-interface"

@using ITStockM.Models.Constants
<AuthorizeView Roles="Admin,IT,Infrastructure,Employee">
    <Authorized>
        <PageTitle>Assignments Interface</PageTitle>
        <div class="container-fluid py-4 assignments-page">
            <RadzenCard class="mb-4 rz-shadow-2" Style="border-radius: 12px; border: none;">
                <div class="page-container">
                    <div class="page-title">
                        <RadzenText Text="Assignments Dashboard" TextStyle="TextStyle.H3" TagName="TagName.H1"
                                    Style="text-transform: uppercase; font-weight: 600; letter-spacing: 1px;" />
                    </div>

                    <RadzenRow Class="mb-6">
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="3" Class="mb-4">
                            <div class="dashboard-card card-primary">
                                <div class="card-header">
                                    <div>
                                        <div class="card-title">Total Assignments</div>
                                        <div class="card-value">@totalAssignments</div>
                                    </div>
                                    <div class="kpi-icon bg-primary">

                                        <RadzenIcon Icon="Assignment" />
                                    </div>
                                </div>
                            </div>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="6" SizeLG="3" Class="mb-4">
                            <div class="dashboard-card card-stock">
                                <div class="card-header">
                                    <div>
                                        <div class="card-title">Stock Left</div>
                                        <div class="card-value">@stockLeft</div>
                                    </div>
                                    <div class="kpi-icon bg-success">

                                        <RadzenIcon Icon="Inventory_2" />
                                    </div>
                                </div>
                            </div>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="6" SizeLG="3" Class="mb-4">
                            <div class="dashboard-card card-warning">
                                <div class="card-header">
                                    <div>
                                        <div class="card-title">Active Assignments</div>
                                        <div class="card-value">@activeAssignments</div>
                                    </div>
                                    <div class="kpi-icon bg-warning">
                                        <RadzenIcon Icon="Assignment_Turned_In" />
                                    </div>
                                </div>
                            </div>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="6" SizeLG="3" Class="mb-4 clickable-card" @onclick="@(() => AssignmentDetails())">
                            <div class="dashboard-card card-alert">
                                <div class="card-header">
                                    <div>
                                        <div class="card-title">Materials in Mission</div>
                                        <div class="card-value">@missions</div>
                                    </div>
                                    <div class="kpi-icon bg-danger">
                                        <RadzenIcon Icon="engineering" />
                                    </div>
                                </div>
                            </div>
                        </RadzenColumn>
                    </RadzenRow>

                    @if (dangerMission)
                    {
                        <div class="warning-alert">
                            <span class="warning-icon" style="font-size:30px;">⚠️</span>
                            <span>Some people have 1 week left to retrieve their materials.</span>
                        </div>
                    }

                    <div class="search-export-container">
                        <div class="search-container">
                            <span class="search-icon">🔍</span>
                            <RadzenTextBox Placeholder="Search..."
                                           @oninput="@Search"
                                           Class="search-box" />
                        </div>

                        <div class="export-container">
                            <RadzenSplitButton ButtonStyle="ButtonStyle.Light"
                                               Icon="download"
                                               Text="Export"
                                               Click="@ExportClick"
                                               Style="border-radius: 8px;">
                                <RadzenSplitButtonItem Text="Excel" Value="xlsx" Icon="table_view" />
                                <RadzenSplitButtonItem Text="CSV" Value="csv" Icon="description" />
                            </RadzenSplitButton>
                        </div>
                        <RadzenColumn SizeMD="12" class="action-button">
                            <RadzenButton Text="Add Assignment" Click="@AddButtonClick"
                                          ButtonStyle="ButtonStyle.Light" Icon="add_circle" Size="ButtonSize.Medium"
                                          Shade="Shade.Lighter" Variant="Variant.Flat" Style="border-radius:8px;" />
                        </RadzenColumn>
                    </div>

                    <div class="datagrid-container">
                        <RadzenDataGrid @ref="grid0"
                                        Data="@assignmentMateriels"
                                        TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                        AllowFiltering="true"
                                        AllowSorting="true"
                                        AllowPaging="true"
                                        PageSize="10"
                                        ShowPagingSummary="true"
                                        PageSizeOptions="@(new int[]{5, 10, 20, 30})">
                            <Columns>
                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                                      Property="Materiel.MaterielName" Title="Material Name"
                                                      Width="40%">
                                    <Template Context="data">
                                        <div style="display: flex; align-items: center;">
                                            <span>@data.Materiel?.MaterielName</span>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn Width="150px" TextAlign="TextAlign.Center"
                                                      TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                                      Property="Qte"
                                                      Title="QTE">
                                    <Template Context="data">
                                        <div class="quantity-badge">
                                            @data.Qte
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                                      Property="Assignment.Employee.FullName" Title="Assigned By"
                                                      Width="25%">
                                    <Template Context="data">
                                        <div style="display: flex; align-items: center;">
                                            <span>@data.Assignment?.Employee?.FullName</span>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                                      Title="Assigned To"
                                                      Width="25%">
                                    <Template Context="data">
                                        <div style="display: flex; align-items: center;">
                                            @if (data.Assignment?.AssignedTo != null)
                                            {
                                                <RadzenBadge BadgeStyle="BadgeStyle.Secondary"
                                                             Shade="Shade.Lighter"
                                                             Style="padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.8rem; font-weight: 500;"
                                                             Text="@data.Assignment?.AssignedEmployee?.FullName" />
                                            }
                                            else
                                            {
                                                <RadzenBadge BadgeStyle="BadgeStyle.Info"
                                                             Shade="Shade.Lighter"
                                                             Style="padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.8rem; font-weight: 500;"
                                                             Text="@data.Assignment?.Project?.ProjectName" />
                                            }
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>




                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                                      Property="Assignment.Date" Title="Date"
                                                      Width="25%">
                                    <Template Context="data">
                                        <div style="display: flex; align-items: center;">
                                            <span>@data.Assignment.Date.ToString("MMM dd,yyyy")</span>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel"
                                                      Filterable="false" Sortable="false" Width="15%"
                                                      TextAlign="TextAlign.Center">
                                    <Template Context="data">
                                        <RadzenButton ButtonStyle="ButtonStyle.Info"
                                                      Icon="info"
                                                      Size="ButtonSize.Medium"
                                                      Style="border-radius: 8px;"
                                                      Shade="Shade.Lighter"
                                                      Variant="Variant.Flat"
                                                      Class="info-button"
                                                      Click="@(() => AssignmentDetails(data))" />
                                    </Template>
                                </RadzenDataGridColumn>

                            </Columns>
                        </RadzenDataGrid>
                    </div>
                </div>
            </RadzenCard>
        </div>

    </Authorized>
    <NotAuthorized>
        <ITStockM.Components.Pages.auth.RedirectToAccessDenied />
    </NotAuthorized>
</AuthorizeView>


