

<PageTitle>Add Offer</PageTitle>


<div class="container-fluid py-4">
    <RadzenCard class="rz-shadow-2" Style="border-radius: 12px; border: none;">
        <div class="form-container">
            <div class="form-header">
                <RadzenText Text="@requestTitle" TextStyle="TextStyle.H4" TagName="TagName.H1"
                            Style="font-weight: 600; margin: 0;" />
            </div>

            @if (errorVisible)
            {
                <div class="error-alert">
                    <span class="error-icon">⚠️</span>
                    <div>
                        <strong>Error:</strong> Cannot save offer. Please check the form for errors and try again.
                    </div>
                </div>
            }

            <RadzenTemplateForm TItem="ITStockM.Models.ITStockManagment.Offer" Data="@offer" Visible="@(offer != null)" Submit="@FormSubmit">

                <div class="form-section section-supplier">
                    <div class="section-title">
                        <span class="section-icon icon-supplier"><RadzenIcon Icon="store"></RadzenIcon></span>
                        Supplier Information
                    </div>

                    <div class="form-field">
                        <label class="field-label">
                            Supplier
                            <span class="required-indicator">*</span>
                        </label>
                        <RadzenDropDownDataGrid Data="@suppliersForSupplierName"
                                                TextProperty="SupplierName"
                                                ValueProperty="SupplierName"
                                                AllowClear="true"
                                                AllowFiltering="true"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                Placeholder="Select a supplier..."
                                                Class="field-input"
                                                @bind-Value="@offer.SupplierName"
                                                Name="SupplierName" />

                        <div class="helper-text" @onclick="AddSupplier">
                            <RadzenIcon Icon="add_circle" Class="helper-icon" />
                            <span>Supplier not in the list? Click here to add one.</span>
                        </div>

                        <RadzenRequiredValidator Component="SupplierName" Text="Supplier is required" Style="font-size: 0.75rem;" />
                    </div>
                </div>

                <div class="form-section section-details">
                    <div class="section-title">
                        <span class="section-icon icon-details"><RadzenIcon Icon="local_offer"></RadzenIcon></span>
                        Offer Details
                    </div>

                    <RadzenRow>
                        <RadzenColumn SizeMD="6">
                            <div class="form-field">
                                <label class="field-label">
                                    Delivery Date
                                    <span class="required-indicator">*</span>
                                </label>
                                <RadzenDatePicker DateFormat="MM/dd/yyyy"
                                                  Class="field-input1"
                                                  @bind-Value="@offer.DeliveryDate"
                                                  Name="DeliveryDate"
                                                  ShowTime="false"
                                                  ShowIcon="true"
                                                  Min="DateTime.Now.AddDays(-1)"
                                                  Placeholder="Select delivery date..." />
                                <div class="field-helper">
                                    <RadzenIcon Icon="event" Style="font-size: 0.875rem;" />
                                    Expected date of delivery
                                </div>
                                <RadzenRequiredValidator Component="DeliveryDate" Text="Delivery date is required" Style="font-size: 0.75rem;" />
                            </div>
                        </RadzenColumn>
                        <RadzenColumn SizeMD="6">
                            <div class="form-field">
                                <label class="field-label">
                                    Price
                                    <span class="required-indicator">*</span>
                                </label>
                                <RadzenNumeric Class="field-input1"
                                               @bind-Value="@offer.Price"
                                               Name="Price"
                                               Placeholder="Enter price..."
                                               Min="0"
                                               ShowUpDown="false" />
                                <div class="field-helper">
                                    <RadzenIcon Icon="info" Style="font-size: 0.875rem;" />
                                    Enter the total price including taxes
                                </div>
                                <RadzenRequiredValidator Component="Price" Text="Price is required" Style="font-size: 0.75rem;" />
                            </div>
                        </RadzenColumn>
                    </RadzenRow>

                </div>

                <div class="form-actions">
                    <RadzenButton Text="Save"
                                  ButtonType="ButtonType.Submit"
                                  Icon="save"
                                  Size="ButtonSize.Medium"
                                  ButtonStyle="ButtonStyle.Info"
                                  Shade="Shade.Darker" Variant="Variant.Filled"
                                  Style="border-radius: 8px; " />

                    <RadzenButton Icon="cancel"
                                  Text="Cancel"
                                  Size="ButtonSize.Medium"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Shade="Shade.Darker" Variant="Variant.Filled"
                                  Style="border-radius: 8px;"
                                  Click="@CancelButtonClick" />
                </div>
            </RadzenTemplateForm>
        </div>
    </RadzenCard>
</div>