@page "/infra-interface"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,IT,Infrastructure")]

<AuthorizeView Context="authContext" Roles="Admin,IT,Infrastructure">
    <Authorized>
        <PageTitle>Infrastructure Management</PageTitle>
        <span id="scrollback"></span>
        <div class="container-fluid py-4 infra-page">
            <RadzenCard class="mb-4 rz-shadow-2 infra-shell-card">
                <div class="page-container">
                    <div class="page-title">
                        <RadzenText Text="Infrastructure Management" TextStyle="TextStyle.H3" TagName="TagName.H1" Class="page-heading" />
                    </div>

                    <RadzenRow>
                        <!-- Left Column: Request Form -->
                        <RadzenColumn Size="12" SizeMD="6">
                            <div class="panel panel-form">
                                <div class="panel-header">
                                    <div class="panel-icon icon-form">
                                        <RadzenIcon Icon="gavel" />
                                    </div>
                                    <h2 class="panel-title">New Infrastructure Request</h2>
                                </div>
                                <!-- Left Column: Request Form -->
                                <div class="panel-body">

                                    <RadzenFieldset AllowCollapse="true" Class="section-fieldset">
                                        <HeaderTemplate>
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                                <b>Collapse</b>
                                            </RadzenStack>
                                        </HeaderTemplate>

                                        <ChildContent>
                                            <div class="panel-body">
                                                @if (errorVisible)
                                                {
                                                    <div class="error-alert">
                                                        <span class="error-icon">⚠️</span>
                                                        <div>
                                                            <strong>Error:</strong> Cannot save request. Please check the
                                                            form for errors and try again.
                                                        </div>
                                                    </div>
                                                }

                                                <RadzenTemplateForm TItem="ITStockM.Domain.Entities.Request"
                                                    Data="@request" Visible="@(request != null)" Submit="@FormSubmit">

                                                    <div class="form-field">
                                                        <label class="field-label">
                                                            Title
                                                            <span class="required-indicator">*</span>
                                                        </label>
                                                        <RadzenTextBox Class="field-input" @bind-Value="@request.Title"
                                                            Name="Title" Placeholder="Enter request title" />
                                                        <RadzenRequiredValidator Component="Title"
                                                            Text="Title is required" />
                                                    </div>

                                                    <div class="form-field">
                                                        <label class="field-label">
                                                            Description
                                                            <span class="required-indicator">*</span>
                                                        </label>
                                                        <RadzenTextArea Rows="3" Class="field-input"
                                                            @bind-Value="@request.Description" Name="Description"
                                                            Placeholder="Enter detailed description" />
                                                        <RadzenRequiredValidator Component="Description"
                                                            Text="Description is required" />
                                                    </div>



                                                    <div class="form-field">
                                                        <label class="field-label">
                                                            Project Name
                                                            <span class="required-indicator">*</span>
                                                        </label>
                                                        <RadzenDropDown Data="@projectNames" AllowClear="true"
                                                            Placeholder="Select project name" Class="field-input"
                                                            @bind-Value="@request.ProjectName" Name="ProjectName" />
                                                        <RadzenRequiredValidator Component="ProjectName"
                                                            Text="Project Name is required" />
                                                    </div>

                                                    <div class="form-field">
                                                        <label class="field-label">
                                                            Material Type
                                                            <span class="required-indicator">*</span>
                                                        </label>
                                                        <RadzenDropDown TValue="string" Data="@materialTypes"
                                                            Placeholder="Select a material type" Class="field-input"
                                                            Name="MaterialType" @bind-Value="@request.MaterialType" />
                                                        <RadzenRequiredValidator Component="MaterialType"
                                                            Text="Material Type is required" />
                                                    </div>



                                                    <div class="form-field">
                                                        <label class="field-label">
                                                            Status
                                                            <span class="required-indicator">*</span>
                                                        </label>
                                                        <RadzenDropDown Data="@status" AllowClear="true"
                                                            Placeholder="Select a status" Class="field-input"
                                                            @bind-Value="@request.Status" Name="Status" />
                                                        <RadzenRequiredValidator Component="Status"
                                                            Text="Status is required" />
                                                    </div>

                                                    <div class="form-field">
                                                        <label class="field-label">Supporting Documents</label>
                                                        <RadzenUpload ChooseText="Upload File" Class="date upload-full" Change="@OnFileUpload" />

                                                    </div>

                                                    <RadzenStack Class="form-actions"
                                                        Orientation="Orientation.Horizontal"
                                                        AlignItems="AlignItems.Center"
                                                        JustifyContent="JustifyContent.Center" Gap="1rem">
                                                        <RadzenButton Text="Save" ButtonType="ButtonType.Submit"
                                                            Icon="save" Size="ButtonSize.Medium"
                                                            ButtonStyle="ButtonStyle.Info" Class="btn-submit"
                                                            Shade="Shade.Darker" Variant="Variant.Filled" />
                                                        <RadzenButton Icon="highlight_off" Text="Reset"
                                                            Size="ButtonSize.Medium" ButtonStyle="ButtonStyle.Danger"
                                                            Class="btn-reset" Shade="Shade.Darker"
                                                            Variant="Variant.Filled" ButtonType="ButtonType.Reset" />
                                                    </RadzenStack>
                                                </RadzenTemplateForm>
                                            </div>
                                        </ChildContent>

                                        <SummaryTemplate>
                                            <RadzenCard class="rz-mt-4 summary-card">
                                                <table class="summary-table">
                                                    <thead>
                                                        <tr class="summary-head-row">
                                                            <th>
                                                                Title</th>
                                                            <th>
                                                                Material Type</th>
                                                            <th>
                                                                Status</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (request != null)
                                                        {
                                                            <tr>
                                                                <td>@request.Title</td>
                                                                <td>@request.MaterialType</td>
                                                                <td>
                                                                    <RadzenBadge
                                                                        BadgeStyle="@GetStatusStyle(request.Status)"
                                                                        Shade="Shade.Lighter"
                                                                        Class="status-badge"
                                                                        Text="@request.Status" />
                                                                </td>
                                                            </tr>
                                                        }
                                                        else
                                                        {
                                                            <tr>
                                                                <td colspan="3" class="summary-empty">No request selected.</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </RadzenCard>
                                        </SummaryTemplate>
                                    </RadzenFieldset>
                                </div>
                            </div>
                        </RadzenColumn>

                        <!-- Right Column: Requests Queue and Offers -->
                        <RadzenColumn Size="12" SizeMD="6">
                            <div class="panel panel-queue">
                                <div class="panel-header">
                                    <div class="panel-icon icon-queue">
                                        <RadzenIcon Icon="alarm" />
                                    </div>
                                    <h2 class="panel-title">Requests Queue</h2>
                                </div>

                                <div class="panel-body">
                                    <RadzenFieldset AllowCollapse="true" Class="section-fieldset">
                                        <HeaderTemplate>
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                                <b>Collapse</b>
                                            </RadzenStack>

                                        </HeaderTemplate>
                                        <ChildContent>
                                            <div class="datagrid-container">
                                                <RadzenDataGrid @ref="grid0" AllowFiltering="true"
                                                    FilterMode="FilterMode.Advanced" AllowPaging="true"
                                                    AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@(new
                                                                                                                                                     int[] { 5, 10, 20, 30 }) Data="@requests"
                                                    TItem="ITStockM.Domain.Entities.Request"
                                                    RowDoubleClick="@EditRow">
                                                    <Columns>
                                                        <RadzenDataGridColumn
                                                            TItem="ITStockM.Domain.Entities.Request"
                                                            Property="Title" Title="Title" Width="60%">
                                                            <Template Context="data">
                                                                <div class="inline-center">
                                                                    <span>@data.Title</span>
                                                                </div>
                                                            </Template>
                                                        </RadzenDataGridColumn>
                                                        <RadzenDataGridColumn
                                                            TItem="ITStockM.Domain.Entities.Request"
                                                            Property="Status" Title="Status" Width="25%">
                                                            <Template Context="data">
                                                                <RadzenBadge BadgeStyle="@GetStatusStyles(data.Status)"
                                                                    Shade="Shade.Lighter"
                                                                    Style="padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.8rem; font-weight: 500;"
                                                                    Text="@data.Status" />
                                                            </Template>
                                                        </RadzenDataGridColumn>
                                                        <RadzenDataGridColumn
                                                            TItem="ITStockM.Domain.Entities.Request"
                                                            Filterable="false" Sortable="false" Width="15%"
                                                            TextAlign="TextAlign.Center">
                                                            <Template Context="data">
                                                                <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                                                    Icon="delete" Size="ButtonSize.Small"
                                                                    Shade="Shade.Lighter" Variant="Variant.Flat"
                                                                    Class="btn-icon" Click=@(args =>
                                                                                                                                                                    GridDeleteButtonClick(args, data))
                                                                    @onclick:stopPropagation="true" />
                                                            </Template>
                                                        </RadzenDataGridColumn>
                                                    </Columns>
                                                    <EmptyTemplate>
                                                        <div class="empty-state">
                                                            <div class="empty-state-icon">📭</div>
                                                            <div class="empty-state-title">No Requests to Display </div>
                                                            <div class="empty-state-description">There are currently no
                                                                requests to display..</div>
                                                        </div>
                                                    </EmptyTemplate>
                                                </RadzenDataGrid>
                                            </div>
                                        </ChildContent>

                                        <SummaryTemplate>
                                            @if (requests.Any())
                                            {
                                                <div class="carousel-container">
                                                    <RadzenCarousel @ref="carousel" @bind-SelectedIndex="@selectedIndex"
                                                        Auto="@auto" Interval="@interval" PagerOverlay="false"
                                                        ButtonShade="Shade.Dark" Class="request-carousel">
                                                        <Items>



                                                            @foreach (var (item, i) in requests.Select((value, index) =>
                                                                                                                    (value, index)))
                                                            {
                                                                <RadzenCarouselItem>

                                                                    <div class="carousel-card"
                                                                        @onclick="@(() => EditCard(item.Id))">
                                                                        <div class="card-header">
                                                                            <RadzenText TextStyle="TextStyle.H5" Class="carousel-title">
                                                                                Request @(i + 1)
                                                                            </RadzenText>
                                                                        </div>
                                                                        <div class="card-body">
                                                                            <div class="card-center-block">
                                                                                <div class="card-label">Title</div>
                                                                                <div class="card-value">@item.Title</div>
                                                                            </div>
                                                                            <div class="card-footer">
                                                                                <div class="card-stat">
                                                                                    <div class="card-label">Date</div>
                                                                                    <div class="card-value">
                                                                                        @item.Date.ToString("yyyy-MM-dd")</div>
                                                                                </div>
                                                                                <div class="card-stat">
                                                                                    <div class="card-label">Status</div>
                                                                                    <RadzenBadge
                                                                                        BadgeStyle="@GetStatusStyle(item.Status)"
                                                                                        Shade="Shade.Lighter"
                                                                                        Class="status-badge"
                                                                                        Text="@item.Status" />
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </RadzenCarouselItem>
                                                            }
                                                        </Items>
                                                    </RadzenCarousel>

                                                </div>
                                            }
                                            else
                                            {
                                                <div class="empty-state">
                                                    <div class="empty-state-icon">📭</div>
                                                    <div class="empty-state-title">No Requests to Display </div>
                                                    <div class="empty-state-description">There are currently no requests to
                                                        display..</div>
                                                </div>
                                            }

                                        </SummaryTemplate>

                                    </RadzenFieldset>



                                </div>
                            </div>

                            <div class="panel panel-offers">

                                <div class="panel-header">
                                    <div class="panel-icon icon-offers">
                                        <RadzenIcon Icon="book" />
                                    </div>
                                    <h2 class="panel-title">Available Offers</h2>
                                </div>
                                <div class="panel-body">
                                    <RadzenFieldset AllowCollapse="true"
                                        Class="section-fieldset">
                                        <HeaderTemplate>
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                                <b>Collapse</b>
                                            </RadzenStack>
                                        </HeaderTemplate>
                                        <ChildContent>
                                            <div class="datagrid-container">
                                                <RadzenDataGrid @ref="grid1" AllowFiltering="true"
                                                    FilterMode="FilterMode.Advanced" AllowPaging="true"
                                                    AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@(new
                                                                                                                                                     int[] { 5, 10, 20, 30 }) Data="@groupedOffers"
                                                    TItem="ITStockM.Models.ViewModels.InfraViewModel"
                                                    RowDoubleClick="@EditRowOffer">
                                                    <Columns>
                                                        <RadzenDataGridColumn
                                                            TItem="ITStockM.Models.ViewModels.InfraViewModel"
                                                            Property="RequestTitle" Title="Request" Width="70%">
                                                            <Template Context="data">
                                                                <div class="inline-center">
                                                                    <span>@data.RequestTitle</span>
                                                                </div>
                                                            </Template>
                                                        </RadzenDataGridColumn>
                                                        <RadzenDataGridColumn
                                                            TItem="ITStockM.Models.ViewModels.InfraViewModel"
                                                            Property="OffersAvai" Title="Available Offers" Width="30%"
                                                            TextAlign="TextAlign.Center">
                                                            <Template Context="data">
                                                                <div class="status-badge status-success">
                                                                    @data.OffersAvai
                                                                </div>
                                                            </Template>
                                                        </RadzenDataGridColumn>
                                                    </Columns>
                                                    <EmptyTemplate>
                                                        <div class="empty-state">
                                                            <div class="empty-state-icon">📭</div>
                                                            <div class="empty-state-title">No Available Offers to
                                                                Display </div>
                                                            <div class="empty-state-description">There are currently no
                                                                available offers to display. All procurement requests
                                                                are being processed..</div>
                                                        </div>
                                                    </EmptyTemplate>
                                                </RadzenDataGrid>
                                            </div>
                                        </ChildContent>
                                        <SummaryTemplate>
                                            @if (groupedOffers.Any())
                                            {
                                                <div class="carousel-container">
                                                    <RadzenCarousel @ref="carousel1" @bind-SelectedIndex="@selectedIndex1"
                                                        Auto="@auto1" Interval="@interval1" PagerOverlay="false"
                                                        ButtonShade="Shade.Dark" Class="offers-carousel">
                                                        <Items>
                                                            @foreach (var (item, i) in groupedOffers.Select((value, index)
                                                                                                                    => (value, index)))
                                                            {
                                                                <RadzenCarouselItem>
                                                                    <div class="carousel-card"
                                                                        @onclick="@(() => EditCardOffer(item.RequestId))">
                                                                        <div class="card-header">
                                                                            <RadzenText TextStyle="TextStyle.H5" Class="carousel-title">
                                                                                Offer @(i + 1)
                                                                            </RadzenText>
                                                                        </div>
                                                                        <div class="card-body">
                                                                            <div class="card-center-block">
                                                                                <div class="card-label">Request</div>
                                                                                <div class="card-value">@item.RequestTitle</div>
                                                                            </div>
                                                                            <div class="card-footer center-footer">
                                                                                <div class="card-stat">
                                                                                    <div class="card-label">Available Offers
                                                                                    </div>
                                                                                    <div class="card-value success-text">
                                                                                        @item.OffersAvai</div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </RadzenCarouselItem>
                                                            }
                                                        </Items>
                                                    </RadzenCarousel>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="empty-state">
                                                    <div class="empty-state-icon">📭</div>
                                                    <div class="empty-state-title">No Available Offers to Display </div>
                                                    <div class="empty-state-description">There are currently no available
                                                        offers to display. All procurement requests are being processed..
                                                    </div>
                                                </div>
                                            }
                                        </SummaryTemplate>


                                    </RadzenFieldset>
                                </div>

                            </div>
                        </RadzenColumn>
                    </RadzenRow>
                </div>
            </RadzenCard>
        </div>



    </Authorized>
    <NotAuthorized>
        <ITStockM.Components.Pages.auth.RedirectToAccessDenied />
    </NotAuthorized>
</AuthorizeView>