

<PageTitle>Edit Request</PageTitle>

<style>
    :root {
        --primary: #4f46e5;
        --primary-light: #e0e7ff;
        --success: #10b981;
        --success-light: #d1fae5;
        --warning: #f59e0b;
        --warning-light: #fef3c7;
        --danger: #ef4444;
        --danger-light: #fee2e2;
        --gray-light: #f3f4f6;
        --gray: #9ca3af;
        --dark: #1f2937;
    }

    .page-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 1.5rem;
    }

    .page-title {
        position: relative;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        text-align: center;
    }

        .page-title::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 3px;
            background-color: var(--primary);
            border-radius: 3px;
        }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .form-field-full {
        grid-column: span 2;
    }

    .error-alert {
        background-color: var(--danger-light);
        color: var(--danger);
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .error-icon {
        font-size: 1.5rem;
    }

    .file-container {
        margin-top: 0.5rem;
    }

    .file-preview {
        border-radius: 8px;
        padding: 0.75rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .file-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex: 1;
        min-width: 200px;
    }

    .file-icon {
        font-size: 1.5rem;
        color: var(--primary);
    }

    .file-name {
        font-size: 0.875rem;
        font-weight: 500;
        word-break: break-all;
    }

    .file-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .form-actions {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-top: 2rem;
    }

    .field-label {
        display: block;
        font-size: 0.875rem;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .required-indicator {
        color: var(--danger);
        margin-left: 0.25rem;
    }

    .field-input {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.2s;
    }

    .date {
        width: 100%;
        height: 4rem;
        padding: 0.75rem;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.2s;
    }

    .field-helper {
        font-size: 0.75rem;
        color: var(--gray);
        margin-top: 0.25rem;
    }

 

    .form-field-full {
        grid-column: span 1;
    }

    }</style>

<div class="container-fluid py-4">
    <RadzenCard class="mb-4 rz-shadow-2" Style="border-radius: 12px; border: none;">
        <div class="page-container">
            <div class="page-title">
                <RadzenText Text="Edit Request" TextStyle="TextStyle.H3" TagName="TagName.H1"
                            Style="text-transform: uppercase; font-weight: 600; letter-spacing: 1px;" />
            </div>

            @if (errorVisible)
            {
                <div class="error-alert">
                    <span class="error-icon">⚠️</span>
                    <div>
                        <strong>Error:</strong> Cannot save request. Please check the form for errors and try again.
                    </div>
                </div>
            }

            <RadzenTemplateForm TItem="ITStockM.Models.ITStockManagment.Request"
                                Data="@request"
                                Visible="@(request != null)"
                                Submit="@FormSubmit">

                <!-- Basic Information Section -->
                <RadzenFieldset 
                                Style="margin: 0 0 20px 0; border-radius: 12px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
                    <HeaderTemplate>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenIcon Icon="info" /><b>Basic Information</b>
                        </RadzenStack>
                    </HeaderTemplate>

                    <ChildContent>
                        <div class="form-grid" style="padding: 1rem;">
                            

                            <div class="form-field">
                                <label class="field-label">
                                    Date
                                    <span class="required-indicator">*</span>
                                </label>
                                <RadzenDatePicker DateFormat="MM/dd/yyyy"
                                                  Class="date"
                                                  @bind-Value="@request.Date"
                                                  Name="Date"
                                                  Placeholder="Select date"
                                                  Disabled/>
                                <RadzenRequiredValidator Component="Date" Text="Date is required"  />
                            </div>

                            <div class="form-field-full">
                                <label class="field-label">
                                    Title
                                    <span class="required-indicator">*</span>
                                </label>
                                <RadzenTextBox Class="field-input"
                                               @bind-Value="@request.Title"
                                               Name="Title"
                                               Placeholder="Enter request title" />
                                <RadzenRequiredValidator Component="Title" Text="Title is required" />
                            </div>

                            <div class="form-field-full">
                                <label class="field-label">
                                    Description
                                    <span class="required-indicator">*</span>
                                </label>
                                <RadzenTextArea Rows="3"
                                                Class="field-input"
                                                @bind-Value="@request.Description"
                                                Name="Description"
                                                Placeholder="Enter detailed description" 
                                                Style="height:100px"/>
                                <RadzenRequiredValidator Component="Description" Text="Description is required" />
                            </div>
                        </div>
                    </ChildContent>
                </RadzenFieldset>

                <RadzenFieldset 
                                Style="margin: 0 0 20px 0; border-radius: 12px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
                    <HeaderTemplate>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenIcon Icon="description" /><b>Request Details</b>
                        </RadzenStack>
                    </HeaderTemplate>

                    <ChildContent>
                        <div class="form-grid" style="padding: 1rem;">
                            

                            <div class="form-field">
                                <label class="field-label">
                                    Status
                                    <span class="required-indicator">*</span>
                                </label>
                                <RadzenDropDownDataGrid Data="@status"
                                                        AllowClear="true"
                                                        Class="field-input"
                                                        @bind-Value="@request.Status"
                                                        Name="Status"
                                                        Placeholder="Select status" />
                                <RadzenRequiredValidator Component="Status" Text="Status is required" />
                            </div>

                            <div class="form-field">
                                <label class="field-label">
                                    Project Name
                                    <span class="required-indicator">*</span>
                                </label>
                                <RadzenDropDown Data="@projectNames"
                                                AllowClear="true"
                                                Placeholder="Select project name"
                                                Class="field-input"
                                                @bind-Value="@request.ProjectName"
                                                Name="ProjectName" />
                                <RadzenRequiredValidator Component="ProjectName" Text="Project Name is required" />
                            </div>

                            <div class="form-field">
                                <label class="field-label">
                                    Material Type
                                    <span class="required-indicator">*</span>
                                </label>
                                <RadzenDropDownDataGrid Data="@materialTypes"
                                                        AllowClear="true"
                                                        Class="field-input"
                                                        @bind-Value="@request.MaterialType"
                                                        Name="MaterialType"
                                                        Placeholder="Select material type" />
                                <RadzenRequiredValidator Component="MaterialType" Text="Material Type is required" />
                            </div>
                        </div>
                    </ChildContent>
                </RadzenFieldset>

                <!-- Attachments Section -->
                <RadzenFieldset 
                                Style="margin: 0 0 20px 0; border-radius: 12px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
                    <HeaderTemplate>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenIcon Icon="attach_file" /><b>Attachments</b>
                        </RadzenStack>
                    </HeaderTemplate>

                    <ChildContent>
                        <div style="padding: 1rem;">
                            <label class="field-label">
                                Supporting Documents
                            </label>

                            <div class="file-container">
                                @if (request.File != null)
                                {
                                    <div class="file-preview">
                                        <div class="file-info">
                                            <div class="file-icon">
                                                <RadzenIcon Icon="insert_drive_file" />
                                            </div>
                                            <div class="file-name">
                                                @request.FileName
                                            </div>
                                        </div>
                                        <div class="file-actions">
                                            <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                                          Size="ButtonSize.Small"
                                                          Icon="download"
                                                          Text="Download"
                                                          Style="border-radius: 6px;"
                                                          Click="@(async () => await DownloadFile())" />

                                            <RadzenButton ButtonStyle="ButtonStyle.Light"
                                                          Size="ButtonSize.Small"
                                                          Icon="delete"
                                                          Text="Remove"
                                                          Style="border-radius: 6px;"
                                                          Click="@(() => {request.File = null;request.FileExtension = null ; request.FileName = null;} )" />
                                        </div>
                                    </div>
                                }

                                <RadzenUpload ChooseText="@(request.File == null ? "Upload File" : "Replace File")" 
                                              Change="@OnFileUpload"
                                              Style="width: 100%; border-radius: 8px;" />

                                <div class="field-helper">
                                    Upload supporting documents for this request (PDF, DOC, XLS, etc.)
                                </div>
                            </div>
                        </div>
                    </ChildContent>
                </RadzenFieldset>

                <div class="form-actions">
                    <RadzenButton Text="Save Changes"
                                  Icon="save"
                                  ButtonType="ButtonType.Submit"
                                  ButtonStyle="ButtonStyle.Info"
                                  Style="border-radius: 8px;"
                                  Shade="Shade.Darker" Variant="Variant.Filled" />
                    <RadzenButton Text="Cancel"
                                  Icon="cancel"
                                  ButtonType="ButtonType.Button"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Style="border-radius: 8px;"
                                  Shade="Shade.Darker" Variant="Variant.Filled"
                                  Click="@CancelButtonClick" />
                </div>
            </RadzenTemplateForm>
        </div>
    </RadzenCard>
</div>