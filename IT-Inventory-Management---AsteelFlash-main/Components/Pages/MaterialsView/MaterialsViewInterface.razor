@page "/materials-view-interface"
<AuthorizeView Roles="Admin,Purchasing,IT">
    <Authorized>
        <PageTitle>Materials View</PageTitle>
        <div class="container-fluid py-4 materials-page ux-list-shell">
            <RadzenCard class="mb-4 rz-shadow-2">
                <div class="page-container">
                    <div class="page-title ux-list-header">
                        <RadzenText Text="Materials Overview" TextStyle="TextStyle.H3" TagName="TagName.H1"
                                    Class="ux-list-title" />
                    </div>

                    <RadzenRow Class="mb-6">
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="3" Class="mb-4">
                            <div class="dashboard-card card-primary clickable-card" @onclick="NavToRequests">
                                <div class="card-header">
                                    <div>
                                        <div class="card-title">Pending Requests</div>
                                        <div class="card-value">@pendingRequests</div>
                                        <div class="trend-indicator trend-down"></div>
                                    </div>
                                    <div class="kpi-icon bg-primary">

                                        <RadzenIcon Icon="pending_actions" />
                                    </div>
                                </div>
                            </div>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="6" SizeLG="3" Class="mb-4">
                            <div class="dashboard-card card-warning clickable-card" @onclick="NavToPendingDeliveries">
                                <div class="card-header">
                                    <div>
                                        <div class="card-title">Pending Deliveries</div>
                                        <div class="card-value">@pendingDeliveries</div>
                                        <div class="trend-indicator trend-up"></div>
                                    </div>
                                    <div class="kpi-icon bg-success">

                                        <RadzenIcon Icon="local_shipping" />
                                    </div>
                                </div>
                            </div>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="6" SizeLG="3" Class="mb-4">
                            <div class="dashboard-card card-stock">
                                <div class="card-header">
                                    <div>
                                        <div class="card-title">Stock Left</div>
                                        <div class="card-value">@stockLeft</div>
                                    </div>
                                    <div class="kpi-icon bg-warning">
                                        <RadzenIcon Icon="Inventory_2" />
                                    </div>
                                </div>
                            </div>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="6" SizeLG="3" Class="mb-4">
                            <div class="dashboard-card card-alert">
                                <div class="card-header">
                                    <div>
                                        <div class="card-title">Running Out Stock</div>
                                        <div class="card-value">@runingOutOfStock</div>
                                    </div>
                                    <div class="kpi-icon bg-danger">
                                        <RadzenIcon Icon="engineering" />
                                    </div>
                                </div>
                            </div>
                        </RadzenColumn>
                    </RadzenRow>

                    <div class="search-export-container ux-list-toolbar">
                        <div class="search-container">
                            <span class="search-icon">🔍</span>
                            <RadzenTextBox Placeholder="Search..."
                                           @oninput="@Search"
                                           Class="search-box ux-search-input" />
                        </div>

                        <div class="export-container">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="1rem">

                                <RadzenDropDown Data="@materialStorage"
                                                Placeholder="Select material type"
                                                Class="field-input"
                                                TValue="string"
                                                @bind-Value="@selectedStorage"
                                                Name="Type"
                                                Change="MaterialFilter"
                                                Style="width : 110px; border-radius:8px" />

                                <RadzenSplitButton ButtonStyle="ButtonStyle.Light"
                                                   Icon="download"
                                                   Text="Export"
                                                   Click="@ExportClick"
                                                   Style="border-radius: 8px;"
                                                   Disabled="@(selectedStorage == "Repairing" || selectedStorage == "Irreparable")">
                                    <RadzenSplitButtonItem Text="Excel" Value="xlsx" Icon="table_view" />
                                    <RadzenSplitButtonItem Text="CSV" Value="csv" Icon="description" />
                                </RadzenSplitButton>


                            </RadzenStack>
                        </div>
                    </div>

                    <div class="datagrid-container">
                        <RadzenDataGrid @ref="grid0"
                                        Data="@materielsList"
                                        Class="ux-data-grid"
                                        TItem="ITStockM.Models.ViewModels.MaterialsListViewModel"
                                        AllowFiltering="true"
                                        AllowSorting="true"
                                        AllowPaging="true"
                                        PageSize="10"
                                        ShowPagingSummary="true"
                                        PageSizeOptions="@(new int[]{5, 10, 20, 30})">
                            <Columns>
                                <RadzenDataGridColumn TItem="ITStockM.Models.ViewModels.MaterialsListViewModel"
                                                      Property="MatName"
                                                      Title="Material Name"
                                                      Width="40%">
                                    <Template Context="data">
                                        <div style="display: flex; align-items: center;">
                                            <span>@data.MatName</span>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="ITStockM.Models.ViewModels.MaterialsListViewModel"
                                                      Property="Qte"
                                                      Title="In Stock"
                                                      Width="20%"
                                                      TextAlign="TextAlign.Center">
                                    <Template Context="data">
                                        @{
                                            string badgeClass = data.Qte <= 5 ? "stock-danger" :
                                            data.Qte <= 10 ? "stock-warning" : "stock-normal";
                                        }
                                        <div class="stock-badge @badgeClass">
                                            @data.Qte
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="ITStockM.Models.ViewModels.MaterialsListViewModel"
                                                      Property="Type"
                                                      Title="Type"
                                                      Width="25%">
                                    <Template Context="data">
                                        <div style="display: flex; align-items: center;">
                                            <span>@data.Type</span>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                
                                

                                <RadzenDataGridColumn TItem="ITStockM.Models.ViewModels.MaterialsListViewModel"
                                                      Filterable="false"
                                                      Sortable="false"
                                                      Width="15%"
                                                      TextAlign="TextAlign.Center">
                                    <Template Context="data">
                                        <RadzenButton ButtonStyle="ButtonStyle.Info"
                                                      Icon="info"
                                                      Size="ButtonSize.Medium"
                                                      Style="border-radius: 8px;"
                                                      Shade="Shade.Lighter"
                                                      Variant="Variant.Flat"
                                                      Class="info-button"
                                                      Click="@(() => MaterialsDetails(data.Mats.Select(mat => mat.Id).ToList()))" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                </div>
            </RadzenCard>
        </div>
    </Authorized>
    <NotAuthorized>
        <ITStockM.Components.Pages.auth.RedirectToAccessDenied />
    </NotAuthorized>
</AuthorizeView>


