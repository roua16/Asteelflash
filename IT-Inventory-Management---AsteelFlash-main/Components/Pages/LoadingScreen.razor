

<style>
    /* Base styles */
    :root {
        --primary: #0055a4;
        --secondary: #dc3545;
        --background: #FFFFFF8A;
        --text: #333333;
        --shadow: rgba(0, 0, 0, 0.1);
    }

    body, html {
        margin: 0;
        padding: 0;
        height: 100%;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    /* Loading screen container */
    .loading-screen {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    /* Card container */
    .loading-card {
        border-radius: 16px;
        box-shadow: 0 10px 25px var(--shadow);
        padding: 2.5rem;
        width: 300px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        /* Accent bar at top of card */
        .loading-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(to right, var(--primary), var(--secondary));
        }

    /* Logo */
    .logo {
        width: 80px;
        height: 80px;
        margin: 0 auto 1.5rem;
    }

    /* Title */
    .loading-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    /* Subtitle / Message */
    .loading-message {
        font-size: 0.875rem;
        margin-bottom: 2rem;
    }

    /* Loading bar */
    .loading-bar {
        height: 4px;
        width: 100%;
        border-radius: 4px;
        overflow: hidden;
        margin-bottom: 2rem;
        position: relative;
    }

        .loading-bar::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 30%;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            border-radius: 4px;
            animation: loading-progress 1.5s infinite ease-in-out;
        }

    /* Circular progress */
    .circular-progress {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: inline-block;
        position: relative;
        background: conic-gradient(var(--primary) 0%, #f0f0f0 0);
        animation: circular-load 2s linear infinite;
    }

        .circular-progress::before {
            content: '';
            position: absolute;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            top: 4px;
            left: 4px;
            background: white;
        }

    /* Hexagon loader */
    .hexagon-loader {
        position: relative;
        width: 60px;
        height: 60px;
        margin: 0 auto;
    }

    .hexagon {
        position: absolute;
        width: 30px;
        height: 52px;
        background-color: var(--primary);
        top: 4px;
        left: 15px;
        opacity: 0.2;
    }

        .hexagon::before,
        .hexagon::after {
            content: '';
            position: absolute;
            width: 0;
            height: 0;
            border-left: 15px solid transparent;
            border-right: 15px solid transparent;
        }

        .hexagon::before {
            top: -15px;
            border-bottom: 15px solid var(--primary);
        }

        .hexagon::after {
            bottom: -15px;
            border-top: 15px solid var(--primary);
        }

        .hexagon:nth-child(1) {
            animation: hexagon-animation 2s infinite ease-in-out;
        }

        .hexagon:nth-child(2) {
            animation: hexagon-animation 2s infinite ease-in-out 0.4s;
            transform: rotate(60deg);
        }

        .hexagon:nth-child(3) {
            animation: hexagon-animation 2s infinite ease-in-out 0.8s;
            transform: rotate(120deg);
        }

    /* Dot loader */
    .dot-loader {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
    }

    .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: var(--primary);
        animation: dot-animation 1.4s infinite ease-in-out both;
    }

        .dot:nth-child(1) {
            animation-delay: -0.32s;
        }

        .dot:nth-child(2) {
            animation-delay: -0.16s;
            background-color: #4682b4;
        }

        .dot:nth-child(3) {
            background-color: var(--secondary);
        }

    /* Animations */
    @@keyframes loading-progress {
        0% {
            left: -30%;
        }

        100% {
            left: 100%;
        }
    }

    @@keyframes circular-load {
        0% {
            background: conic-gradient(var(--primary) 0%, #f0f0f0 0);
        }

        25% {
            background: conic-gradient(var(--primary) 90deg, #f0f0f0 0);
        }

        50% {
            background: conic-gradient(var(--primary) 180deg, #f0f0f0 0);
        }

        75% {
            background: conic-gradient(var(--primary) 270deg, #f0f0f0 0);
        }

        100% {
            background: conic-gradient(var(--primary) 360deg, #f0f0f0 0);
        }
    }

    @@keyframes hexagon-animation {
        0%, 100% {
            opacity: 0.2;
        }

        50% {
            opacity: 1;
        }
    }

    @@keyframes dot-animation {
        0%, 80%, 100% {
            transform: scale(0);
        }

        40% {
            transform: scale(1);
        }
    }

    /* Responsive adjustments */
    @@media (max-width: 480px) {
        .loading-card {
            width: 85%;
            padding: 1.5rem;
        }
    }
</style>
    <div class="loading-screen">
        <div class="loading-card">
