@page "/materials-view-interface-pdr"


@using ITStockM.Models.Constants
<AuthorizeView Roles="@($"{UserRoles.Admin},{UserRoles.Purchasing},{UserRoles.PDR}")">
    <Authorized>
        <PageTitle>Materials View</PageTitle>

        
        <div class="container-fluid py-4">
            <RadzenCard class="mb-4 rz-shadow-2" Style="border-radius: 12px; border: none;">
                <div class="page-container">
                    <div class="page-title">
                        <RadzenText Text="Materials Overview" TextStyle="TextStyle.H3" TagName="TagName.H1"
                                    Style="text-transform: uppercase; font-weight: 600; letter-spacing: 1px;" />
                    </div>

                    <RadzenRow Class="mb-6">

                        <RadzenColumn Size="12" SizeMD="6" Class="mb-4">
                            <div class="dashboard-card card-warning" onclick="@NavToPendingDeliveries">
                                <div class="card-header">
                                    <div>
                                        <div class="card-title">Pending Deliveries</div>
                                        <div class="card-value">@pendingDeliveries</div>
                                        <div class="trend-indicator trend-up"></div>
                                    </div>
                                    <div class="kpi-icon bg-success">

                                        <RadzenIcon Icon="local_shipping" />
                                    </div>
                                </div>
                            </div>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="6" Class="mb-4">
                            <div class="dashboard-card card-stock">
                                <div class="card-header">
                                    <div>
                                        <div class="card-title">Stock Left</div>
                                        <div class="card-value">@stockLeft</div>
                                    </div>
                                    <div class="kpi-icon bg-warning">
                                        <RadzenIcon Icon="Inventory_2" />
                                    </div>
                                </div>
                            </div>
                        </RadzenColumn>


                    </RadzenRow>

                    <div class="search-export-container">
                        <div class="search-container">
                            <span class="search-icon">🔍</span>
                            <RadzenTextBox Placeholder="Search..."
                                           @oninput="@Search"
                                           Class="search-box" />
                        </div>

                        <div class="export-container">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="1rem">

                                <RadzenSplitButton ButtonStyle="ButtonStyle.Light"
                                                   Icon="download"
                                                   Text="Export"
                                                   Click="@ExportClick"
                                                   Style="border-radius: 8px;">
                                    <RadzenSplitButtonItem Text="Excel" Value="xlsx" Icon="table_view" />
                                    <RadzenSplitButtonItem Text="CSV" Value="csv" Icon="description" />
                                </RadzenSplitButton>
                                <RadzenButton Click="AssignToIT" Text="Assign to IT" ButtonStyle="ButtonStyle.Light" Icon="add_circle" Size="ButtonSize.Medium"
                                              Shade="Shade.Lighter" Variant="Variant.Flat" Style="border-radius:8px;">

                                </RadzenButton>
                            </RadzenStack>
                        </div>
                    </div>

                    <div class="datagrid-container">
                        <RadzenDataGrid @ref="grid0"
                                        Data="@materielsList"
                                        TItem="ITStockM.Models.ViewModels.MaterialsListViewModel"
                                        AllowFiltering="true"
                                        AllowSorting="true"
                                        AllowPaging="true"
                                        PageSize="10"
                                        ShowPagingSummary="true"
                                        PageSizeOptions="@(new int[]{5, 10, 20, 30})">
                            <Columns>
                                <RadzenDataGridColumn TItem="ITStockM.Models.ViewModels.MaterialsListViewModel"
                                                      Property="MatName"
                                                      Title="Material Name"
                                                      Width="40%">
                                    <Template Context="data">
                                        <div style="display: flex; align-items: center;">
                                            <span>@data.MatName</span>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="ITStockM.Models.ViewModels.MaterialsListViewModel"
                                                      Property="Qte"
                                                      Title="In Stock"
                                                      Width="20%"
                                                      TextAlign="TextAlign.Center">
                                    <Template Context="data">
                                        @{
                                            string badgeClass = data.Qte <= 5 ? "stock-danger" :
                                            data.Qte <= 10 ? "stock-warning" : "stock-normal";
                                        }
                                        <div class="stock-badge @badgeClass">
                                            @data.Qte
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="ITStockM.Models.ViewModels.MaterialsListViewModel"
                                                      Property="Type"
                                                      Title="Type"
                                                      Width="25%">
                                    <Template Context="data">
                                        <div style="display: flex; align-items: center;">
                                            <span>@data.Type</span>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="ITStockM.Models.ViewModels.MaterialsListViewModel"
                                                      Filterable="false"
                                                      Sortable="false"
                                                      Width="15%"
                                                      TextAlign="TextAlign.Center">
                                    <Template Context="data">
                                        <RadzenButton ButtonStyle="ButtonStyle.Info"
                                                      Icon="info"
                                                      Size="ButtonSize.Medium"
                                                      Style="border-radius: 8px;"
                                                      Shade="Shade.Lighter"
                                                      Variant="Variant.Flat"
                                                      Class="info-button"
                                                      Click="@(() => MaterialsDetails(data.Mats.Select(mat => mat.Id).ToList()))" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                </div>
            </RadzenCard>
        </div>
    </Authorized>
    <NotAuthorized>
        <ITStockM.Components.Pages.auth.RedirectToAccessDenied />
    </NotAuthorized>
</AuthorizeView>

