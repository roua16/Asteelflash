


<RadzenStack Gap="1.5rem" Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween">
    <div class="material-details-container">
        <div class="material-details-header">
            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; font-weight: 600;">Material Details</RadzenText>
            <RadzenIcon Icon="Assignment"></RadzenIcon>
        </div>

        <div class="properties-container">
            <div class="property-column">
                <div class="material-property">
                    <div class="material-property-label">Material Name</div>
                    <div class="material-property-value">@deliveryOrderMateriels.FirstOrDefault().Materiel.MaterielName</div>
                </div>
            </div>

            <div class="property-column">
                <div class="material-property">
                    <div class="material-property-label">Type</div>
                    <div class="material-property-value">@deliveryOrderMateriels.FirstOrDefault().Materiel.Type</div>
                </div>

            </div>
        </div>

        <div class="material-meta">
            <div class="meta-item">
                <div class="meta-label">Total</div>
                <div class="meta-value">@deliveryOrderMateriels.Select(dlom => dlom.Materiel).Distinct().Sum(m => m.QuantityPDRStock + m.QuantityITStock)</div>
            </div>
            <div class="meta-item">
                <div class="meta-label">Orders</div>
                <div class="meta-value">@deliveryOrderMateriels.Select(dlom => dlom.DeliveryOrder).Distinct().Count()</div>
            </div>
            <div class="meta-item">
                <div class="meta-label">Suppliers</div>
                <div class="meta-value">@deliveryOrderMateriels.Select(dlom => dlom.DeliveryOrder.SupplierName).Distinct().Count()</div>
            </div> 
        </div>

    
    </div>
    <div class="material-details-header">
        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; font-weight: 600;">Delivery Order Details</RadzenText>
        <RadzenIcon Icon="notes"></RadzenIcon>
    </div>
    <!-- Data Grid -->
    <div class="datagrid-container">
        <RadzenDataGrid @ref="grid0"
                        AllowFiltering="true"
                        AllowSorting="true"
                        AllowPaging="true"
                        PageSize="10"
                        ShowPagingSummary="true"
                        PageSizeOptions=@(new int[]{5, 10, 20, 30})
                        Data="@deliveryOrderMateriels"
                        TItem="ITStockM.Domain.Entities.DeliveryOrderMateriel">
            <Columns>
                <RadzenDataGridColumn Width="90px" TextAlign="TextAlign.Center" TItem="ITStockM.Domain.Entities.DeliveryOrderMateriel" Property="Qte" Title="QTE">
                    <Template Context="data">
                       
                        <div class="QuantityPDRStockPDRStock-badge QuantityPDRStockPDRStock-high">
                            @data.Qte
                        </div>
                    </Template>
                </RadzenDataGridColumn>
                
                 <RadzenDataGridColumn Title="Supplier">
                    <Template Context="data">
                        
                        <span>@data.DeliveryOrder.SupplierName</span>
                    </Template>
                </RadzenDataGridColumn>
                
                <RadzenDataGridColumn  Title="Delivery Order">
                    <Template Context="data">
                       
                        <span>@data.DeliveryOrderNumber</span>
                    </Template>
                </RadzenDataGridColumn> 
                
                <RadzenDataGridColumn TItem="ITStockM.Domain.Entities.DeliveryOrderMateriel" Property="Materiel.Warranty" Title="Warranty">
                    <Template Context="data">
                        <div style="display: flex; align-items: center;">
                            <span> @data.Materiel.Warranty.ToString("MMM dd, yyyy")</span>
                        </div>
                    </Template>
                </RadzenDataGridColumn>
                
                @if (!string.IsNullOrEmpty(deliveryOrderMateriels.FirstOrDefault().Materiel.SerialNumber))
                {
                    <RadzenDataGridColumn TItem="ITStockM.Domain.Entities.DeliveryOrderMateriel" Property="Materiel.SerialNumber" Title="🏷SN">
                        <Template Context="data">
                            <div style="display: flex; align-items: center;">
                                <span>@data.Materiel.SerialNumber</span>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                }
                
            </Columns>
        </RadzenDataGrid>
    </div>
</RadzenStack>

