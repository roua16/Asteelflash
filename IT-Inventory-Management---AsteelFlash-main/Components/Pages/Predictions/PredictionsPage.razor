@page "/asset-predictions"
@using ITStockM.Domain.Entities
<AuthorizeView Roles="Admin,IT">
    <Authorized>
        <PageTitle>Asset Health Predictions</PageTitle>
        <div class="container-fluid py-4 predictions-page">
            <RadzenCard class="mb-4 rz-shadow-2 prediction-shell-card">
                <div class="p-2">
                    <RadzenText Text="Asset Health Predictions" TextStyle="TextStyle.H4" TagName="TagName.H1" Class="page-heading" />

                    <RadzenRow Class="mb-4">
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="3" Class="mb-4">
                            <div class="dashboard-card card-warning">
                                <div class="card-header">
                                    <div>
                                        <div class="card-title">Good Health</div>
                                        <div class="card-value">@goodCount</div>
                                    </div>
                                    <div class="kpi-icon bg-success">
                                        <RadzenIcon Icon="favorite" />
                                    </div>
                                </div>
                            </div>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="3" Class="mb-4">
                            <div class="dashboard-card card-stock">
                                <div class="card-header">
                                    <div>
                                        <div class="card-title">Fair Health</div>
                                        <div class="card-value">@fairCount</div>
                                    </div>
                                    <div class="kpi-icon bg-warning">
                                        <RadzenIcon Icon="warning" />
                                    </div>
                                </div>
                            </div>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="3" Class="mb-4">
                            <div class="dashboard-card card-alert">
                                <div class="card-header">
                                    <div>
                                        <div class="card-title">Poor / High Risk</div>
                                        <div class="card-value">@poorCount</div>
                                    </div>
                                    <div class="kpi-icon bg-danger">
                                        <RadzenIcon Icon="dangerous" />
                                    </div>
                                </div>
                            </div>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="3" Class="mb-4">
                            <div class="dashboard-card card-primary">
                                <div class="card-header">
                                    <div>
                                        <div class="card-title">Avg Health Score</div>
                                        <div class="card-value">@avgScore.ToString("N1")</div>
                                    </div>
                                    <div class="kpi-icon bg-primary">
                                        <RadzenIcon Icon="analytics" />
                                    </div>
                                </div>
                            </div>
                        </RadzenColumn>
                    </RadzenRow>

                    <div class="search-export-container">
                        <div class="search-container">
                            <span class="search-icon">🔍</span>
                            <RadzenTextBox Placeholder="Search asset…" Value="@search"
                                           ValueChanged="@(async (string s) => await OnSearchChanged(s))"
                                           Class="search-box" />
                        </div>
                        <div class="export-container">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                <RadzenDropDown Data="@healthOptions" Value="@healthFilter"
                                                ValueChanged="@(async (string s) => await OnHealthFilter(s))"
                                                Placeholder="All statuses" AllowClear="true" Class="status-filter" />
                                <RadzenCheckBox @bind-Value="highRiskOnly" TValue="bool"
                                                Change="@(async (bool _) => await LoadPredictions())" />
                                <RadzenLabel Text="High risk only" />
                                <RadzenButton Text="Recalculate" Icon="refresh" ButtonStyle="ButtonStyle.Secondary"
                                              Class="action-button" Click="@RecalculateAll" IsBusy="@calculating" />
                                <RadzenButton Text="CSV" Icon="download" ButtonStyle="ButtonStyle.Light"
                                              Class="action-button"
                                              Click="@(() => NavigationManager.NavigateTo("/export/ITStockManagment/predictions/csv", true))" />
                                <RadzenButton Text="Excel" Icon="table_chart" ButtonStyle="ButtonStyle.Light"
                                              Class="action-button"
                                              Click="@(() => NavigationManager.NavigateTo("/export/ITStockManagment/predictions/excel", true))" />
                            </RadzenStack>
                        </div>
                    </div>

                    <div class="datagrid-container">
                        <RadzenDataGrid Data="@predictions" TItem="AssetPrediction"
                                        AllowPaging="true" PageSize="15"
                                        PageSizeOptions="@(new int[]{10,15,25,50})"
                                        ShowPagingSummary="true" AllowSorting="true" AllowFiltering="true"
                                        @ref="grid">
                            <Columns>
                                <RadzenDataGridColumn TItem="AssetPrediction" Property="Materiel.MaterielName" Title="Asset" />
                                <RadzenDataGridColumn TItem="AssetPrediction" Property="Materiel.SerialNumber" Title="Serial #" />
                                <RadzenDataGridColumn TItem="AssetPrediction" Title="Health Score" Sortable="true" Property="HealthScore">
                                    <Template Context="row">
                                        <div class="score-cell">
                                            <div class="score-bar-bg">
                                                <div class="score-bar dynamic-score-bar" style="width:@((int)row.HealthScore)px;--score-color:@ScoreColor(row.HealthScore)"></div>
                                            </div>
                                            <span>@row.HealthScore.ToString("N1")</span>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AssetPrediction" Property="HealthStatus" Title="Status">
                                    <Template Context="row">
                                        <span class="health-badge @HealthCss(row.HealthStatus)">@row.HealthStatus</span>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AssetPrediction" Property="PredictedFailureDate" Title="Est. Failure" FormatString="{0:dd/MM/yyyy}" />
                                <RadzenDataGridColumn TItem="AssetPrediction" Property="RecommendedReplacementDate" Title="Replace By" FormatString="{0:dd/MM/yyyy}" />
                                <RadzenDataGridColumn TItem="AssetPrediction" Property="EstimatedReplacementCost" Title="Cost (€)" FormatString="{0:N2}" />
                                <RadzenDataGridColumn TItem="AssetPrediction" Property="CalculatedAt" Title="Updated" FormatString="{0:dd/MM/yyyy}" />
                                <RadzenDataGridColumn TItem="AssetPrediction" Title="" Sortable="false" Filterable="false">
                                    <Template Context="row">
                                        <RadzenButton Icon="refresh" Title="Recalculate" ButtonStyle="ButtonStyle.Light"
                                                      Size="ButtonSize.Small" Class="mini-action-button"
                                                      Click="@(async () => await RecalculateSingle(row.MaterielId))" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                </div>
            </RadzenCard>
        </div>
    </Authorized>
    <NotAuthorized>
        <ITStockM.Components.Pages.auth.RedirectToAccessDenied />
    </NotAuthorized>
</AuthorizeView>
