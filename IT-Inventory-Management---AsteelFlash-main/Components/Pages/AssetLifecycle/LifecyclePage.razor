@page "/asset-lifecycle"
@using ITStockM.Domain.Entities
@using ITStockM.Domain.Enums
<AuthorizeView Roles="Admin,IT">
    <Authorized>
        <PageTitle>Asset Lifecycle</PageTitle>
        <div class="container-fluid py-4 lifecycle-page">
            <RadzenCard class="mb-4 rz-shadow-2" Style="border-radius:12px;border:none">
                <div class="p-2">

                    <RadzenText Text="Asset Lifecycle Tracker" TextStyle="TextStyle.H4" TagName="TagName.H1"
                                Style="text-transform:uppercase;font-weight:600;letter-spacing:1px;margin-bottom:1.5rem" />

                    <div class="search-export-container">
                        <div class="search-container">
                            <span class="search-icon">🔍</span>
                            <RadzenTextBox Placeholder="Search asset or serial…"
                                           Value="@search" ValueChanged="@(async (string s) => await OnSearchChanged(s))"
                                           Class="search-box" />
                        </div>
                        <RadzenDropDown Data="@stages" Value="@selectedStage"
                                        ValueChanged="@(async (string s) => await OnStageChanged(s))"
                                        Placeholder="All stages" AllowClear="true"
                                        Style="width:180px;border-radius:8px" />
                        <div class="export-container">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                <RadzenButton Text="CSV" Icon="download" ButtonStyle="ButtonStyle.Light" Style="border-radius:8px"
                                              Click="@(() => NavigationManager.NavigateTo("/export/ITStockManagment/lifecycle/csv", true))" />
                                <RadzenButton Text="Excel" Icon="table_chart" ButtonStyle="ButtonStyle.Light" Style="border-radius:8px"
                                              Click="@(() => NavigationManager.NavigateTo("/export/ITStockManagment/lifecycle/excel", true))" />
                            </RadzenStack>
                        </div>
                    </div>

                    <div class="datagrid-container">
                        <RadzenDataGrid Data="@records" TItem="AssetLifecycleRecord"
                                        AllowPaging="true" PageSize="15" PageSizeOptions="@(new int[]{10,15,25,50})"
                                        ShowPagingSummary="true"
                                        AllowSorting="true" AllowFiltering="true"
                                        @ref="grid">
                            <Columns>
                                <RadzenDataGridColumn TItem="AssetLifecycleRecord" Property="Materiel.MaterielName" Title="Asset Name" Width="25%" />
                                <RadzenDataGridColumn TItem="AssetLifecycleRecord" Property="Materiel.SerialNumber" Title="Serial #" Width="15%" />
                                <RadzenDataGridColumn TItem="AssetLifecycleRecord" Property="Stage" Title="Stage" Width="15%">
                                    <Template Context="row">
                                        <span class="stage-badge @StageCss(row.Stage)">@row.Stage</span>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AssetLifecycleRecord" Property="StartDate" Title="Since" Width="15%" FormatString="{0:dd/MM/yyyy}" />
                                <RadzenDataGridColumn TItem="AssetLifecycleRecord" Property="EndDate" Title="Until" Width="15%">
                                    <Template Context="row">
                                        @(row.EndDate.HasValue ? row.EndDate.Value.ToString("dd/MM/yyyy") : "Current")
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AssetLifecycleRecord" Property="Notes" Title="Notes" Width="15%" />
                            </Columns>
                        </RadzenDataGrid>
                    </div>

                </div>
            </RadzenCard>
        </div>
    </Authorized>
    <NotAuthorized>
        <ITStockM.Components.Pages.auth.RedirectToAccessDenied />
    </NotAuthorized>
</AuthorizeView>
