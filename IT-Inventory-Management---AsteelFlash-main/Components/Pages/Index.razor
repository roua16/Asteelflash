@page "/"
@using System.Collections.Generic
@using System.Linq

<AuthorizeView Roles="Admin,PDR,Purchasing,IT,Infrastructure,Employee">
    <Authorized>
        @if (userRole == "Employee")
        {
            <RadzenCard class="@($"mb-4 dashboard-shell-card {DashboardThemeClass}")">
                <div class="dashboard-container">
                    <div class="dashboard-header reveal-fade">
                        <div>
                            <h1 class="dashboard-title">Employee Dashboard</h1>
                            <p class="dashboard-subtitle">Overview of your assignments and requests</p>
                        </div>
                        <div class="dashboard-date">
                            <RadzenIcon Icon="calendar_today" /> @DateTime.Now.ToString("dddd, MMMM d, yyyy")
                        </div>
                    </div>

                    <StatCard
                        Title="Your Active Assignments"
                        Value="@($"{AssignmentMateriel?.Where(a => a.Assignment?.AssignedTo == userId && a.Assignment?.RestoreDate == null).Sum(a => a.Qte) ?? 0}")"
                        Icon="assignment_turned_in"
                        IconClass="bg-primary-light"
                        SizeClass="kpi-card-sm"
                        CardClass="reveal-fade" />

                    <StatCard
                        Title="Your Pending Requests"
                        Value="@($"{topRequests?.Where(r => r.Employee?.Id == userId && r.Status != "Done").Count() ?? 0}")"
                        Icon="shopping_cart"
                        IconClass="bg-warning-light"
                        SizeClass="kpi-card-sm"
                        CardClass="reveal-fade" />

                    <ChartCard
                        Title="Recent Activity"
                        Icon="history"
                        IconClass="bg-info-light"
                        SizeClass="kpi-card-md"
                        CardClass="reveal-fade stagger-1">
                        <div class="activity-scroll">
                            @foreach (var activity in recentActivity.Where(a =>
                                (a.AnyData is ITStockM.Models.ITStockManagment.Assignment ea && ea.AssignedTo == userId)
                                || (a.AnyData is ITStockM.Models.ITStockManagment.Request er && er.Employee?.Id == userId)))
                            {
                                if (activity.AnyData is ITStockM.Models.ITStockManagment.Assignment ea2)
                                {
                                    <div class="activity-item">
                                        <div class="activity-icon bg-success-light">
                                            <RadzenIcon Icon="assignment_turned_in" />
                                        </div>
                                        <div class="activity-content">
                                            <div class="activity-title">Assignment</div>
                                            <div class="activity-description">@assignmentText(ea2)</div>
                                            <div class="activity-time">
                                                @if (activity.Date.Date == DateTime.Today.Date)
                                                {
                                                    <span>Today at @activity.Date.ToString("h:mm tt")</span>
                                                }
                                                else if (activity.Date.Date == DateTime.Today.AddDays(-1).Date)
                                                {
                                                    <span>Yesterday at @activity.Date.ToString("h:mm tt")</span>
                                                }
                                                else
                                                {
                                                    @activity.Date.ToString("MMM dd, yyyy h:mm tt")
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (activity.AnyData is ITStockM.Models.ITStockManagment.Request er2)
                                {
                                    <div class="activity-item">
                                        <div class="activity-icon bg-info-light">
                                            <RadzenIcon Icon="shopping_cart" />
                                        </div>
                                        <div class="activity-content">
                                            <div class="activity-title">Request: @er2.Title</div>
                                            <div class="activity-description">Status: @er2.Status</div>
                                            <div class="activity-time">
                                                @if (activity.Date.Date == DateTime.Today.Date)
                                                {
                                                    <span>Today at @activity.Date.ToString("h:mm tt")</span>
                                                }
                                                else if (activity.Date.Date == DateTime.Today.AddDays(-1).Date)
                                                {
                                                    <span>Yesterday at @activity.Date.ToString("h:mm tt")</span>
                                                }
                                                else
                                                {
                                                    @activity.Date.ToString("MMM dd, yyyy h:mm tt")
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </ChartCard>

                    <ChartCard
                        Title="Your Recent Requests"
                        Icon="receipt_long"
                        IconClass="bg-primary-light"
                        SizeClass="kpi-card-lg"
                        CardClass="reveal-fade stagger-2">
                        <RadzenDataGrid Data="@(topRequests?.Where(r => r.Employee?.Id == userId) ?? Enumerable.Empty<ITStockM.Models.ITStockManagment.Request>())" TItem="ITStockM.Models.ITStockManagment.Request">
                            <Columns>
                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Title" Title="Title" />
                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="MaterialType" Title="Type" />
                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Date" Title="Date" FormatString="{0:d}" />
                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Status" Title="Status">
                                    <Template Context="data">
                                        <span class="badge @GetStatusBadgeClass(data.Status ?? string.Empty)">@data.Status</span>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </ChartCard>

                    <ChartCard
                        Title="Quick Actions"
                        Icon="bolt"
                        IconClass="bg-accent-light"
                        SizeClass="kpi-card-lg"
                        CardClass="reveal-fade stagger-3">
                        <div class="quick-actions-grid mt-3">
                            <a href="/assignments-interface" class="quick-action">
                                <div class="quick-action-icon bg-success-light">
                                    <RadzenIcon Icon="assignment" />
                                </div>
                                <div class="quick-action-title">My Assignments</div>
                            </a>
                            <a href="/mission-interface" class="quick-action">
                                <div class="quick-action-icon bg-primary-light">
                                    <RadzenIcon Icon="assignment_return" />
                                </div>
                                <div class="quick-action-title">Return Materials</div>
                            </a>
                        </div>
                    </ChartCard>
                </div>
            </RadzenCard>
        }
        else
        {
            <RadzenCard class="@($"mb-4 dashboard-shell-card {DashboardThemeClass}")">
                <div class="dashboard-container">
                    <div class="dashboard-header reveal-fade">
                        <div>
                            <h1 class="dashboard-title">IT Inventory Dashboard</h1>
                            <p class="dashboard-subtitle">Overview of inventory, assignments, and purchasing activity</p>
                        </div>
                        <div class="dashboard-date">
                            <RadzenIcon Icon="calendar_today" /> @DateTime.Now.ToString("dddd, MMMM d, yyyy")
                        </div>
                    </div>

                    <StatCard
                        Title="Total Inventory Items"
                        Value="@($"{totalMaterial}")"
                        Icon="inventory_2"
                        IconClass="bg-primary-light"
                        SizeClass="kpi-card-sm"
                        CardClass="reveal-fade"
                        TrendText="@($"{totalMaterialAugment:F2}% from last month")"
                        PositiveTrend="@(totalMaterialAugment >= 0)" />

                    <StatCard
                        Title="Active Assignments"
                        Value="@($"{totalAssignments}")"
                        Icon="assignment_turned_in"
                        IconClass="bg-success-light"
                        SizeClass="kpi-card-sm"
                        CardClass="reveal-fade"
                        TrendText="@($"{totalAssignmentsAugment:F2}% from last month")"
                        PositiveTrend="@(totalAssignmentsAugment >= 0)" />

                    <StatCard
                        Title="Pending Requests"
                        Value="@($"{pendingRequests}")"
                        Icon="pending_actions"
                        IconClass="bg-warning-light"
                        SizeClass="kpi-card-sm"
                        CardClass="reveal-fade" />

                    <StatCard
                        Title="Pending Deliveries"
                        Value="@($"{pendingDeliveries}")"
                        Icon="local_shipping"
                        IconClass="bg-info-light"
                        SizeClass="kpi-card-sm"
                        CardClass="reveal-fade" />

                    <ChartCard
                        Title="Inventory by Category"
                        Icon="donut_small"
                        IconClass="bg-primary-light"
                        SizeClass="kpi-card-md"
                        CardClass="reveal-fade stagger-1 chart-card-donut">
                        <HeaderActions>
                            <RadzenDropDown
                                Data="@materialConditions"
                                Placeholder="Conditions"
                                Class="field-input dashboard-filter"
                                TValue="string"
                                @bind-Value="@selectedMaterialCondition"
                                Name="Type"
                                Change="MaterialConditionsChange" />
                        </HeaderActions>
                        <ChildContent>
                            <div class="chart-shell donut-chart-shell">
                                <RadzenChart>
                                    <RadzenPieSeries Data="@inventoryByType" Title="Available" CategoryProperty="Category" ValueProperty="Value">
                                        <RadzenSeriesDataLabels Visible="true" />
                                    </RadzenPieSeries>
                                </RadzenChart>
                                <div class="donut-center-stat" aria-hidden="true">
                                    <div class="donut-center-value">@SelectedConditionTotal</div>
                                    <div class="donut-center-label">Items</div>
                                </div>
                            </div>
                            <div class="donut-legend">
                                @foreach (var segment in inventoryByType.Where(i => i.Value > 0).Take(6))
                                {
                                    <div class="legend-item">
                                        <span class="legend-dot"></span>
                                        <span class="legend-text">@segment.Category</span>
                                        <span class="legend-value">@segment.Value</span>
                                    </div>
                                }
                            </div>
                        </ChildContent>
                        <FooterContent>
                            <div class="summary-stat">
                                <div class="summary-stat-value">@inventoryByType.Count</div>
                                <div class="summary-stat-label">Categories</div>
                            </div>
                            <div class="summary-stat">
                                <div class="summary-stat-value">@SelectedConditionTotal</div>
                                <div class="summary-stat-label">Total Items</div>
                            </div>
                        </FooterContent>
                    </ChartCard>

                    <ChartCard
                        Title="Top 3 Most Used Materials"
                        Icon="trending_up"
                        IconClass="bg-warning-light"
                        SizeClass="kpi-card-md"
                        CardClass="reveal-fade stagger-1">
                        <ChildContent>
                            @if (TopUsedMateriels != null && TopUsedMateriels.Any())
                            {
                                <table class="top-used-table">
                                    <thead>
                                        <tr>
                                            <th>Material</th>
                                            <th>Used</th>
                                            <th>Share</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var m in TopUsedMateriels)
                                        {
                                            <tr>
                                                <td>@m.MaterielName</td>
                                                <td>@m.UsageCount</td>
                                                <td>
                                                    <div class="table-share">
                                                        <span>@($"{m.UsageShare * 100:F1}%")</span>
                                                        <div class="mini-progress-track">
                                                            <div class="mini-progress-fill" style="width: @(m.UsageShare * 100)%"></div>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="empty-state-inline">No usage data available yet.</div>
                            }
                        </ChildContent>
                    </ChartCard>

                    <ChartCard
                        Title="Monthly Assignments"
                        Icon="insert_chart"
                        IconClass="bg-success-light"
                        SizeClass="kpi-card-lg"
                        CardClass="reveal-fade stagger-2 full-width-trend-card">
                        <HeaderActions>
                            <RadzenDropDown
                                Data="@materialTypes"
                                Placeholder="Material type"
                                Class="field-input dashboard-filter"
                                TValue="string"
                                @bind-Value="@selectedMaterialType"
                                Name="Type"
                                Change="AssignmentFilter" />
                        </HeaderActions>
                        <ChildContent>
                            <div class="chart-shell bar-chart-shell elevated-chart-shell">
                                <RadzenChart>
                                    <RadzenColumnSeries Data="@monthlyAssignments" CategoryProperty="Month" Title="Assignments" ValueProperty="Count">
                                        <RadzenSeriesDataLabels Visible="true" />
                                    </RadzenColumnSeries>
                                    <RadzenColumnOptions Radius="12" />
                                    <RadzenValueAxis>
                                        <RadzenGridLines Visible="true" />
                                        <RadzenAxisTitle Text="Number of Assignments" />
                                    </RadzenValueAxis>
                                    <RadzenCategoryAxis>
                                        <RadzenGridLines Visible="false" />
                                        <RadzenAxisTitle Text="Month" />
                                    </RadzenCategoryAxis>
                                </RadzenChart>
                            </div>
                        </ChildContent>
                        <FooterContent>
                            <div class="summary-stat">
                                <div class="summary-stat-value">@totalAssignmentsChart</div>
                                <div class="summary-stat-label">Total</div>
                            </div>
                            <div class="summary-stat">
                                <div class="summary-stat-value">@((double)monthlyAssignments.Select(massm => massm.Count).Sum() / 5)</div>
                                <div class="summary-stat-label">Monthly Avg</div>
                            </div>
                            <div class="summary-stat">
                                <div class="summary-stat-value">@($"{growthAssignment:F2}%")</div>
                                <div class="summary-stat-label">Growth</div>
                            </div>
                        </FooterContent>
                    </ChartCard>

                    <ChartCard
                        Title="Recent Activity"
                        Icon="history"
                        IconClass="bg-info-light"
                        SizeClass="kpi-card-md"
                        CardClass="reveal-fade stagger-3 timeline-card">
                        <div class="activity-scroll activity-timeline">
                            @foreach (var activity in recentActivity)
                            {
                                if (activity.AnyData is ITStockM.Models.ITStockManagment.Assignment assm)
                                {
                                    <div class="activity-item timeline-entry">
                                        <div class="activity-icon bg-success-light">
                                            <RadzenIcon Icon="assignment_turned_in" />
                                        </div>
                                        <div class="activity-content">
                                            <div class="activity-title">New Assignment Created</div>
                                            <div class="activity-description">@((assm.Employee?.FullName ?? "Unknown") + " assigned " + assignmentText(assm) + " to " + (assm.AssignedEmployee?.FullName ?? "Unknown"))</div>
                                            <div class="activity-time">
                                                @if (activity.Date.Date == DateTime.Today.Date)
                                                {
                                                    <span>Today at @activity.Date.ToString("h:mm tt")</span>
                                                }
                                                else if (activity.Date.Date == DateTime.Today.AddDays(-1).Date)
                                                {
                                                    <span>Yesterday at @activity.Date.ToString("h:mm tt")</span>
                                                }
                                                else
                                                {
                                                    @activity.Date.ToString("MMM dd, yyyy h:mm tt")
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (activity.AnyData is ITStockM.Models.ITStockManagment.DeliveryOrder delOrd)
                                {
                                    <div class="activity-item timeline-entry">
                                        <div class="activity-icon bg-primary-light">
                                            <RadzenIcon Icon="inventory_2" />
                                        </div>
                                        <div class="activity-content">
                                            <div class="activity-title">Inventory Updated</div>
                                            <div class="activity-description">@deliveryOrderToText(delOrd) added to inventory</div>
                                            <div class="activity-time">
                                                @if (activity.Date.Date == DateTime.Today.Date)
                                                {
                                                    <span>Today at @activity.Date.ToString("h:mm tt")</span>
                                                }
                                                else if (activity.Date.Date == DateTime.Today.AddDays(-1).Date)
                                                {
                                                    <span>Yesterday at @activity.Date.ToString("h:mm tt")</span>
                                                }
                                                else
                                                {
                                                    @activity.Date.ToString("MMM dd, yyyy h:mm tt")
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (activity.AnyData is ITStockM.Models.ITStockManagment.Request req)
                                {
                                    <div class="activity-item timeline-entry">
                                        <div class="activity-icon bg-info-light">
                                            <RadzenIcon Icon="shopping_cart" />
                                        </div>
                                        <div class="activity-content">
                                            <div class="activity-title">Purchase Request Approved</div>
                                            <div class="activity-description">Request for @req.Title approved</div>
                                            <div class="activity-time">
                                                @if (activity.Date.Date == DateTime.Today.Date)
                                                {
                                                    <span>Today at @activity.Date.ToString("h:mm tt")</span>
                                                }
                                                else if (activity.Date.Date == DateTime.Today.AddDays(-1).Date)
                                                {
                                                    <span>Yesterday at @activity.Date.ToString("h:mm tt")</span>
                                                }
                                                else
                                                {
                                                    @activity.Date.ToString("MMM dd, yyyy h:mm tt")
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </ChartCard>

                    <ChartCard
                        Title="Low Stock Items"
                        Icon="warning"
                        IconClass="bg-warning-light"
                        SizeClass="kpi-card-md"
                        CardClass="reveal-fade stagger-3 low-stock-card">
                        <div class="activity-scroll">
                            @foreach (var mat in materielsList)
                            {
                                <div class="inventory-status @(mat.Qte < 6 ? "inventory-status-danger" : "inventory-status-warning")">
                                    <div class="inventory-status-icon @(mat.Qte < 6 ? "bg-danger-light" : "bg-warning-light")">
                                        <RadzenIcon Icon="warning" />
                                    </div>
                                    <div class="inventory-status-content">
                                        <div class="inventory-status-title">@mat.MatName</div>
                                        <div class="inventory-status-subtitle">@mat.Type</div>
                                        <div class="progress-container">
                                            <div class="progress-bar @(mat.Qte < 6 ? "progress-danger" : "progress-warning")" style="width: @(Math.Min(mat.Qte * 10, 100))%"></div>
                                        </div>
                                    </div>
                                    <div class="inventory-status-value">
                                        <span class="badge @(mat.Qte < 6 ? "badge-danger" : "badge-warning")">@mat.Qte left</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </ChartCard>

                    <ChartCard
                        Title="Quick Actions"
                        Icon="bolt"
                        IconClass="bg-accent-light"
                        SizeClass="kpi-card-lg"
                        CardClass="reveal-fade stagger-4 quick-actions-panel">
                        <div class="quick-actions-strip mt-3">
                            <a href="/delivery-order" class="quick-action quick-action-pill">
                                <div class="quick-action-icon bg-primary-light">
                                    <RadzenIcon Icon="add_shopping_cart" />
                                </div>
                                <div class="quick-action-title">Add Delivery Order</div>
                            </a>

                            @if (userRole == "Purchasing")
                            {
                                <a href="/pending-deliveries" class="quick-action quick-action-pill">
                                    <div class="quick-action-icon bg-success-light">
                                        <RadzenIcon Icon="local_shipping" />
                                    </div>
                                    <div class="quick-action-title">Pending Deliveries</div>
                                </a>
                            }
                            else
                            {
                                <a href="/assignments-interface" class="quick-action quick-action-pill">
                                    <div class="quick-action-icon bg-success-light">
                                        <RadzenIcon Icon="assignment" />
                                    </div>
                                    <div class="quick-action-title">Manage Assignments</div>
                                </a>
                            }

                            <a href="/materials-view-interface" class="quick-action quick-action-pill">
                                <div class="quick-action-icon bg-warning-light">
                                    <RadzenIcon Icon="build" />
                                </div>
                                <div class="quick-action-title">View Materials</div>
                            </a>

                            @if (userRole == "Admin" || userRole == "Infrastructure")
                            {
                                <a href="/infra-interface" class="quick-action quick-action-pill">
                                    <div class="quick-action-icon bg-info-light">
                                        <RadzenIcon Icon="memory" />
                                    </div>
                                    <div class="quick-action-title">Infrastructure</div>
                                </a>
                            }
                            else
                            {
                                <a href="/purchase-page" class="quick-action quick-action-pill">
                                    <div class="quick-action-icon bg-info-light">
                                        <RadzenIcon Icon="shopping_cart" />
                                    </div>
                                    <div class="quick-action-title">Purchase Requests</div>
                                </a>
                            }

                            <a href="/delivery-order-history" class="quick-action quick-action-pill">
                                <div class="quick-action-icon bg-accent-light">
                                    <RadzenIcon Icon="history" />
                                </div>
                                <div class="quick-action-title">Delivery History</div>
                            </a>
                        </div>
                    </ChartCard>

                    <ChartCard
                        Title="Recent Requests"
                        Icon="description"
                        IconClass="bg-primary-light"
                        SizeClass="kpi-card-lg"
                        CardClass="reveal-fade stagger-4 requests-table-card">
                        <RadzenDataGrid Data="@topRequests" TItem="ITStockM.Models.ITStockManagment.Request">
                            <Columns>
                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Title" Title="Title" />
                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="MaterialType" Title="Type" />
                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Employee.FullName" Title="Requested By" />
                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Date" Title="Date" FormatString="{0:d}" />
                                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Status" Title="Status">
                                    <Template Context="data">
                                        <span class="badge @GetStatusBadgeClass(data.Status)">@data.Status</span>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </ChartCard>
                </div>
            </RadzenCard>
        }
    </Authorized>
    <NotAuthorized>
        @{
            RedirectPDR();
        }
    </NotAuthorized>
</AuthorizeView>