@page "/requests-super-admin"

<AuthorizeView Roles="SuperAdmin">
    <Authorized>
<PageTitle>Requests</PageTitle>
<RadzenStack>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText Text="Requests" TextStyle="TextStyle.H3" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenSplitButton Icon="get_app" Text="Export" Click="@ExportClick" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenSplitButtonItem Text="Excel" Value="xlsx" />
                    <RadzenSplitButtonItem Text="CSV" Value="csv" />
                </RadzenSplitButton>
                <RadzenButton Icon="add_circle_outline" Text="Add" Click="@AddButtonClick" Variant="Variant.Flat" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenTextBox Placeholder="Search ..." style="display: block; width: 100%" @oninput="@Search" aria-label="Search by all string columns" />
    <RadzenRow>
      <RadzenColumn SizeMD=12>
        <RadzenDataGrid @ref="grid0" ColumnWidth="200px"   AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowPaging="true" AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@(new int[]{5, 10, 20, 30})
            Data="@(requests)" TItem="ITStockM.Models.ITStockManagment.Request" RowDoubleClick="@EditRow">
            <Columns>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Id" Title="Id">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Employee.FullName" Title="Employee">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Title" Title="Title">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Type" Title="Type">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="ProjectName" Title="Project Name">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Description" Title="Description">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="MaterialType" Title="Material Type">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Date" Title="Date">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="Status" Title="Status">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="FileExtension" Title="File Extension">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="FileName" Title="File Name">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Property="ApprovedAt" Title="Approved At">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Request" Filterable="false" Sortable="false" Width="70px" TextAlign="TextAlign.Center">
                    <Template Context="request">

                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Medium"
                            Shade="Shade.Lighter" Variant="Variant.Flat"
                            Click=@(args => GridDeleteButtonClick(args, request)) @onclick:stopPropagation="true" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>

        </RadzenDataGrid>

    </RadzenColumn>
  </RadzenRow>
</RadzenStack>

    </Authorized>
    <NotAuthorized>
        <ITStockM.Components.Pages.auth.RedirectToAccessDenied />
    </NotAuthorized>
</AuthorizeView>