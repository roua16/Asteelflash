@page "/assignments-super-admin"

<AuthorizeView Roles="SuperAdmin">
    <Authorized >
<PageTitle>Assignments</PageTitle>
<RadzenStack>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText Text="Assignments" TextStyle="TextStyle.H3" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenSplitButton Icon="get_app" Text="Export" Click="@ExportClick" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenSplitButtonItem Text="Excel" Value="xlsx" />
                    <RadzenSplitButtonItem Text="CSV" Value="csv" />
                </RadzenSplitButton>
                <RadzenButton Icon="add_circle_outline" Text="Add" Click="@AddButtonClick" Variant="Variant.Flat" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenTextBox Placeholder="Search ..." style="display: block; width: 100%" @oninput="@Search" aria-label="Search by all string columns" />
    <RadzenRow>
      <RadzenColumn SizeMD=12>
        <RadzenDataGrid @ref="grid0" ColumnWidth="200px"   AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowPaging="true" AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@(new int[]{5, 10, 20, 30})
            Data="@(assignments)" TItem="ITStockM.Models.ITStockManagment.Assignment" RowDoubleClick="@EditRow">
            <Columns>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Assignment" Property="Id" Title="Id">
                </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Assignment" Property="AssignedEmployee.FullName" Title="AssignedEmployee">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Assignment" Property="Employee.FullName" Title="Employee">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Assignment" Property="Project.ProjectName" Title="Project">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Assignment" Property="Date" Title="Date">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Assignment" Property="Descipriton" Title="Descipriton">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Assignment" Property="OnMission" Title="On Mission">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Assignment" Property="RestoreDateLimit" Title="Restore Date Limit">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Assignment" Property="RestoreDate" Title="Restore Date">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Models.ITStockManagment.Assignment" Filterable="false" Sortable="false" Width="70px" TextAlign="TextAlign.Center">
                    <Template Context="assignment">

                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Medium"
                            Shade="Shade.Lighter" Variant="Variant.Flat"
                            Click=@(args => GridDeleteButtonClick(args, assignment)) @onclick:stopPropagation="true" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>

        </RadzenDataGrid>

    </RadzenColumn>
  </RadzenRow>
</RadzenStack>
    </Authorized>
    <NotAuthorized>
        <ITStockM.Components.Pages.auth.RedirectToAccessDenied />
    </NotAuthorized>
</AuthorizeView>