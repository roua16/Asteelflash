@page "/delivery-orders-super-admin"

@using ITStockM.Models.Constants
<AuthorizeView Roles="@UserRoles.Admin">
    <Authorized >
<PageTitle>DeliveryOrders</PageTitle>
<RadzenStack>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText Text="DeliveryOrders" TextStyle="TextStyle.H3" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenSplitButton Icon="get_app" Text="Export" Click="@ExportClick" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenSplitButtonItem Text="Excel" Value="xlsx" />
                    <RadzenSplitButtonItem Text="CSV" Value="csv" />
                </RadzenSplitButton>
                <RadzenButton Icon="add_circle_outline" Text="Add" Click="@AddButtonClick" Variant="Variant.Flat" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenTextBox Placeholder="Search ..." style="display: block; width: 100%" @oninput="@Search" aria-label="Search by all string columns" />
    <RadzenRow>
      <RadzenColumn SizeMD=12>
        <RadzenDataGrid @ref="grid0" ColumnWidth="200px"   AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowPaging="true" AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@(new int[]{5, 10, 20, 30})
            Data="@(deliveryOrders)" TItem="ITStockM.Domain.Entities.DeliveryOrder" RowDoubleClick="@EditRow">
            <Columns>
                <RadzenDataGridColumn TItem="ITStockM.Domain.Entities.DeliveryOrder" Property="DeliveryOrderNumber" Title="Delevery Order Number">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Domain.Entities.DeliveryOrder" Property="OrderNumber" Title="Order Number">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Domain.Entities.DeliveryOrder" Property="Descriptoin" Title="Descriptoin">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Domain.Entities.DeliveryOrder" Property="Supplier.SupplierName" Title="Supplier">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Domain.Entities.DeliveryOrder" Property="Date" Title="Date">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Domain.Entities.DeliveryOrder" Property="DeliveryDate" Title="Delivery Date">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Domain.Entities.DeliveryOrder" Property="Employee.FullName" Title="Employee">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Domain.Entities.DeliveryOrder" Property="HasDelayedM" Title="Has DelayedM">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ITStockM.Domain.Entities.DeliveryOrder" Filterable="false" Sortable="false" Width="70px" TextAlign="TextAlign.Center">
                    <Template Context="deliveryOrder">

                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Medium"
                            Shade="Shade.Lighter" Variant="Variant.Flat"
                            Click=@(args => GridDeleteButtonClick(args, deliveryOrder)) @onclick:stopPropagation="true" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>

        </RadzenDataGrid>

    </RadzenColumn>
  </RadzenRow>
</RadzenStack>

    </Authorized>
    <NotAuthorized>
        <ITStockM.Components.Pages.auth.RedirectToAccessDenied />
    </NotAuthorized>
</AuthorizeView>