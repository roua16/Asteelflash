
<PageTitle>Edit AssignmentMateriel</PageTitle>

    <RadzenColumn SizeMD=12>
        <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@errorVisible">Cannot save AssignmentMateriel</RadzenAlert>
        <RadzenTemplateForm TItem="ITStockM.Models.ITStockManagment.AssignmentMateriel" Data="@(assignmentMateriel)" Visible="@(assignmentMateriel != null)" Submit="@FormSubmit">
            <RadzenRow style="margin-bottom: 1rem">
                <RadzenColumn SizeMD="3">
                    <RadzenLabel Text="Materiel" Component="Materiel" style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn SizeMD="9">
                    <RadzenDropDownDataGrid Data="@(materielsForMaterielId)" TextProperty="MaterielName" ValueProperty="Id" AllowClear=true
                         Placeholder="Choose Materiel" style="display: block; width: 100%" @bind-Value="@(assignmentMateriel.MaterielId)" Name="MaterielId"
                           />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow style="margin-bottom: 1rem">
                <RadzenColumn SizeMD="3">
                    <RadzenLabel Text="Assignment" Component="Assignment" style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn SizeMD="9">
                    <RadzenDropDownDataGrid Data="@(assignmentsForAssignmentId)" TextProperty="Descipriton" ValueProperty="Id" AllowClear=true
                         Placeholder="Choose Assignment" style="display: block; width: 100%" @bind-Value="@(assignmentMateriel.AssignmentId)" Name="AssignmentId"
                           />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow style="margin-bottom: 1rem">
                <RadzenColumn SizeMD="3">
                    <RadzenLabel Text="Qte" Component="Qte" style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn SizeMD="9">
                    <RadzenNumeric style="display: block; width: 100%" @bind-Value="@(assignmentMateriel.Qte)" Name="Qte" />
                    <RadzenRequiredValidator Component="Qte" Text="Qte is required" />
                </RadzenColumn>
            </RadzenRow>
          <RadzenStack  Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Icon="save" Text="Save" Variant="Variant.Flat" />
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Variant="Variant.Flat" Click="@CancelButtonClick"  />
          </RadzenStack>
        </RadzenTemplateForm>
    </RadzenColumn>

