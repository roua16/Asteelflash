
<PageTitle>Add DeliveryOrderMateriel</PageTitle>
    <RadzenColumn SizeMD=12>
        <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@errorVisible">Cannot save DeliveryOrderMateriel</RadzenAlert>
        <RadzenTemplateForm TItem="ITStockM.Domain.Entities.DeliveryOrderMateriel" Data="@(deliveryOrderMateriel)" Visible="@(deliveryOrderMateriel != null)" Submit="@FormSubmit">
            <RadzenRow style="margin-bottom: 1rem">
                <RadzenColumn SizeMD="3">
                    <RadzenLabel Text="Materiel" Component="Materiel" style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn SizeMD="9">
                    <RadzenDropDownDataGrid Data="@(materielsForMaterielId)" TextProperty="MaterielName" ValueProperty="Id" AllowClear=true
                         Placeholder="Choose Materiel" style="display: block; width: 100%" @bind-Value="@(deliveryOrderMateriel.MaterielId)" Name="MaterielId"
                           />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow style="margin-bottom: 1rem">
                <RadzenColumn SizeMD="3">
                    <RadzenLabel Text="Delivery Order" Component="DeliveryOrder" style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn SizeMD="9">
                    <RadzenDropDownDataGrid Data="@(deliveryOrdersForDeliveryOrderNumber)" TextProperty="DeliveryOrderNumber" ValueProperty="DeliveryOrderNumber" AllowClear=true
                         Placeholder="Choose DeliveryOrder" style="display: block; width: 100%" @bind-Value="@(deliveryOrderMateriel.DeliveryOrderNumber)" Name="DeliveryOrderNumber"
                           />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow style="margin-bottom: 1rem">
                <RadzenColumn SizeMD="3">
                    <RadzenLabel Text="Qte" Component="Qte" style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn SizeMD="9">
                    <RadzenNumeric style="display: block; width: 100%" @bind-Value="@(deliveryOrderMateriel.Qte)" Name="Qte" />
                    <RadzenRequiredValidator Component="Qte" Text="Qte is required" />
                </RadzenColumn>
            </RadzenRow>
          <RadzenStack  Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Icon="save" Text="Save" Variant="Variant.Flat" />
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Variant="Variant.Flat" Click="@CancelButtonClick"  />
          </RadzenStack>
        </RadzenTemplateForm>
    </RadzenColumn>

