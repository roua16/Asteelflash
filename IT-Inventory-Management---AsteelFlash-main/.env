# SQL Server (required)
# Must be at least 8 chars, include upper/lower, digit, and symbol for SQL Server policy.
SA_PASSWORD=w8>m=0oGB3E%D5I~z

# SMTP - Using smtp4dev for local Docker development
# Access inbox at http://localhost:5080
SMTP_SERVER=smtpdev
SMTP_PORT=25
SMTP_FROM_EMAIL=system@asteelflash.com
SMTP_PASSWORD=
SMTP_ADMIN_EMAIL=admin@asteelflash.com

# Run the app in Development inside Docker by default
ASPNETCORE_ENVIRONMENT=Development
# Allow the dev-only test email endpoint (can be set to false in CI/Prod)
DEV_ALLOW_TEST_EMAIL=true

# SMTP health check on startup (dev-only; set to true to run a connectivity check at app start)
SMTP_HEALTH_CHECK_ON_STARTUP=true
# If true, a real test email will also be sent on startup (be careful!)
SMTP_HEALTH_CHECK_SEND=false
