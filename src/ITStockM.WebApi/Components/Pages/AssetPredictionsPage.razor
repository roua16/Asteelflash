@page "/asset-predictions"
@using ITStockM.Domain.Entities
@using ITStockM.Domain.Enums
@using ITStockM.Services.Interfaces
@using ITStockM.Services.Materiels
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,IT,Infrastructure")]
@inject IPredictionService PredictionService
@inject IMaterielService MaterielService
@inject NotificationService NotificationService

<PageTitle>Asset Health Predictions - IT Stock Management</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div class="flex-between page-header-wrap">
            <div>
                <h1>Asset Health Predictions</h1>
                <p class="page-subtitle">Monitor risk levels, forecast failures, and trigger recalculations.</p>
            </div>
            <div class="table-actions">
                <RadzenButton Icon="refresh"
                              Text="Recalculate All"
                              ButtonStyle="ButtonStyle.Primary"
                              Shade="Shade.Lighter"
                              Click="@RecalculateAllAsync" />
                <RadzenButton Icon="sync"
                              Text="Refresh"
                              ButtonStyle="ButtonStyle.Light"
                              Shade="Shade.Lighter"
                              Click="@ReloadAsync" />
            </div>
        </div>
    </div>

    <div class="grid-3">
        <div class="content-section metric-card">
            <span class="metric-label">Assets with Prediction</span>
            <span class="metric-value">@filteredRows.Count</span>
        </div>
        <div class="content-section metric-card">
            <span class="metric-label">Average Health</span>
            <span class="metric-value text-primary">@averageHealth.ToString("0.0")</span>
        </div>
        <div class="content-section metric-card">
            <span class="metric-label">High Risk (≤ @riskThreshold.ToString("0"))</span>
            <span class="metric-value text-danger">@highRiskMaterielIds.Count</span>
        </div>
    </div>

    <div class="page-content">
        <div class="content-section">
            <div class="page-toolbar">
                <div class="toolbar-group">
                    <span class="toolbar-label">Search</span>
                    <div class="search-box">
                        <input type="text"
                               placeholder="Search by asset, type, recommendation..."
                               value="@searchText"
                               @oninput="OnSearchChanged" />
                    </div>
                </div>

                <div class="toolbar-group">
                    <span class="toolbar-label">Health Status</span>
                    <select class="filter-select" value="@statusFilter" @onchange="OnStatusChanged">
                        <option value="">All</option>
                        <option value="@HealthStatus.Good">@HealthStatus.Good</option>
                        <option value="@HealthStatus.Fair">@HealthStatus.Fair</option>
                        <option value="@HealthStatus.Poor">@HealthStatus.Poor</option>
                    </select>
                </div>

                <div class="toolbar-group">
                    <span class="toolbar-label">Risk Threshold</span>
                    <select class="filter-select" value="@riskThreshold.ToString("0")" @onchange="OnRiskThresholdChanged">
                        <option value="40">40</option>
                        <option value="50">50</option>
                        <option value="60">60</option>
                        <option value="70">70</option>
                    </select>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(loadError))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger"
                             Variant="Variant.Flat"
                             Shade="Shade.Lighter"
                             Text="@loadError" />
            }

            @if (isLoading)
            {
                <div class="content-placeholder loading">
                    <RadzenIcon Icon="monitoring" Style="font-size: 42px;" />
                    <h2>Loading predictions...</h2>
                </div>
            }
            else if (filteredRows.Count == 0)
            {
                <div class="content-placeholder">
                    <RadzenIcon Icon="search_off" Style="font-size: 42px;" />
                    <h2>No predictions found</h2>
                    <p>Run recalculation or adjust filters.</p>
                </div>
            }
            else
            {
                <RadzenDataGrid Data="@filteredRows"
                                TItem="PredictionRow"
                                AllowPaging="true"
                                AllowSorting="true"
                                PageSize="10"
                                Responsive="true"
                                Class="inventory-grid">
                    <Columns>
                        <RadzenDataGridColumn TItem="PredictionRow" Title="Asset">
                            <Template Context="row">@row.MaterielName</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PredictionRow" Title="Type">
                            <Template Context="row">@row.MaterielType</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PredictionRow" Title="Calculated At">
                            <Template Context="row">@row.Prediction.CalculatedAt.ToString("yyyy-MM-dd HH:mm")</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PredictionRow" Title="Score">
                            <Template Context="row">
                                <strong class="@HealthScoreClass(row.Prediction.HealthScore)">@row.Prediction.HealthScore.ToString("0.##")</strong>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PredictionRow" Title="Status">
                            <Template Context="row">
                                <span class="badge @HealthBadge(row.Prediction.HealthStatus)">@row.Prediction.HealthStatus</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PredictionRow" Title="Predicted Failure">
                            <Template Context="row">@DisplayDate(row.Prediction.PredictedFailureDate)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PredictionRow" Title="Recommended Replace">
                            <Template Context="row">@DisplayDate(row.Prediction.RecommendedReplacementDate)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PredictionRow" Title="Actions" Filterable="false" Sortable="false" Width="210px">
                            <Template Context="row">
                                <div class="table-actions">
                                    <RadzenButton Icon="info"
                                                  Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  Shade="Shade.Lighter"
                                                  Click="@(() => OpenDetailsModal(row))" />
                                    <RadzenButton Icon="refresh"
                                                  Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Primary"
                                                  Shade="Shade.Lighter"
                                                  Click="@(() => RecalculateSingleAsync(row.Prediction.MaterielId))" />
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </div>
    </div>
</div>

@if (showDetailsModal && detailsTarget is not null)
{
    <div class="modal-overlay" @onclick="CloseDetailsModal">
        <div class="modal-content modal-content-wide" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Prediction Details</h2>
                <button type="button" class="modal-close" @onclick="CloseDetailsModal">×</button>
            </div>

            <div class="grid-2">
                <div class="info-box">
                    <strong>Asset</strong><br />
                    @detailsTarget.MaterielName (@detailsTarget.MaterielType)
                </div>
                <div class="info-box">
                    <strong>Health Score</strong><br />
                    <span class="@HealthScoreClass(detailsTarget.Prediction.HealthScore)">
                        @detailsTarget.Prediction.HealthScore.ToString("0.##") - @detailsTarget.Prediction.HealthStatus
                    </span>
                </div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label>Predicted Failure Date</label>
                    <input value="@DisplayDate(detailsTarget.Prediction.PredictedFailureDate)" readonly />
                </div>
                <div class="form-group">
                    <label>Recommended Replacement Date</label>
                    <input value="@DisplayDate(detailsTarget.Prediction.RecommendedReplacementDate)" readonly />
                </div>
            </div>

            <div class="form-group">
                <label>Recommendation Reason</label>
                <textarea readonly>@(string.IsNullOrWhiteSpace(detailsTarget.Prediction.RecommendationReason) ? "No recommendation reason recorded." : detailsTarget.Prediction.RecommendationReason)</textarea>
            </div>

            <div class="form-group">
                <label>Estimated Replacement Cost</label>
                <input value="@((detailsTarget.Prediction.EstimatedReplacementCost ?? 0m).ToString("0.00"))" readonly />
            </div>

            <div class="form-actions">
                <RadzenButton Icon="refresh"
                              Text="Recalculate This Asset"
                              ButtonStyle="ButtonStyle.Primary"
                              Shade="Shade.Lighter"
                              Click="@(() => RecalculateSingleFromDetailsAsync(detailsTarget.Prediction.MaterielId))" />
                <RadzenButton Icon="cancel"
                              Text="Close"
                              ButtonStyle="ButtonStyle.Light"
                              Shade="Shade.Lighter"
                              Click="@(_ => CloseDetailsModal())" />
            </div>
        </div>
    </div>
}

@code {
    private readonly List<PredictionRow> rows = [];
    private readonly List<PredictionRow> filteredRows = [];
    private readonly HashSet<int> highRiskMaterielIds = [];

    private bool isLoading = true;
    private bool showDetailsModal;

    private string searchText = string.Empty;
    private string statusFilter = string.Empty;
    private string? loadError;
    private decimal riskThreshold = 50m;
    private decimal averageHealth;

    private PredictionRow? detailsTarget;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            var predictions = (await PredictionService.GetLatestPredictionsAsync()).ToList();
            var materielQuery = await MaterielService.GetMateriels();
            var materiels = materielQuery.ToList();

            rows.Clear();
            rows.AddRange(predictions.Select(prediction =>
            {
                var materiel = prediction.Materiel ?? materiels.FirstOrDefault(m => m.Id == prediction.MaterielId);
                return new PredictionRow(
                    prediction,
                    materiel?.MaterielName ?? $"Asset #{prediction.MaterielId}",
                    materiel?.Type ?? "-");
            }));

            await RefreshHighRiskSetAsync();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            loadError = $"Unable to load predictions: {ex.Message}";
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Prediction load failed",
                Detail = loadError,
                Duration = 5000
            });
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshHighRiskSetAsync()
    {
        highRiskMaterielIds.Clear();
        var highRisk = await PredictionService.GetHighRiskAssetsAsync(riskThreshold);
        foreach (var id in highRisk.Select(h => h.MaterielId).Distinct())
        {
            highRiskMaterielIds.Add(id);
        }
    }

    private void OnSearchChanged(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? string.Empty;
        ApplyFilters();
    }

    private void OnStatusChanged(ChangeEventArgs args)
    {
        statusFilter = args.Value?.ToString() ?? string.Empty;
        ApplyFilters();
    }

    private async Task OnRiskThresholdChanged(ChangeEventArgs args)
    {
        if (decimal.TryParse(args.Value?.ToString(), out var parsed) && parsed > 0)
        {
            riskThreshold = parsed;
            await RefreshHighRiskSetAsync();
            ApplyFilters();
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<PredictionRow> query = rows;
        var term = searchText.Trim();

        if (!string.IsNullOrWhiteSpace(term))
        {
            query = query.Where(r =>
                Contains(r.MaterielName, term) ||
                Contains(r.MaterielType, term) ||
                Contains(r.Prediction.RecommendationReason, term) ||
                Contains(r.Prediction.HealthStatus, term));
        }

        if (!string.IsNullOrWhiteSpace(statusFilter))
        {
            query = query.Where(r => string.Equals(r.Prediction.HealthStatus, statusFilter, StringComparison.OrdinalIgnoreCase));
        }

        filteredRows.Clear();
        filteredRows.AddRange(query.OrderBy(r => r.Prediction.HealthScore));

        averageHealth = filteredRows.Count == 0
            ? 0
            : filteredRows.Average(r => r.Prediction.HealthScore);
    }

    private async Task RecalculateAllAsync()
    {
        try
        {
            var results = (await PredictionService.RecalculateAllPredictionsAsync()).Count();
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Recalculation complete",
                Detail = $"Recalculated predictions for {results} asset(s).",
                Duration = 3500
            });
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Recalculation failed",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }

    private async Task RecalculateSingleAsync(int materielId)
    {
        try
        {
            await PredictionService.CalculateAndSavePredictionAsync(materielId);
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Asset recalculated",
                Detail = $"Prediction refreshed for asset #{materielId}.",
                Duration = 2500
            });
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Asset recalculation failed",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }

    private void OpenDetailsModal(PredictionRow row)
    {
        detailsTarget = row;
        showDetailsModal = true;
    }

    private async Task RecalculateSingleFromDetailsAsync(int materielId)
    {
        await RecalculateSingleAsync(materielId);
        detailsTarget = filteredRows.FirstOrDefault(r => r.Prediction.MaterielId == materielId);
    }

    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        detailsTarget = null;
    }

    private static string DisplayDate(DateTime? value) => value?.ToString("yyyy-MM-dd") ?? "-";

    private static bool Contains(string? source, string term) =>
        !string.IsNullOrWhiteSpace(source) &&
        source.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string HealthBadge(string status) => status switch
    {
        HealthStatus.Good => "badge-success",
        HealthStatus.Fair => "badge-warning",
        HealthStatus.Poor => "badge-danger",
        _ => "badge-primary"
    };

    private static string HealthScoreClass(decimal score) => score switch
    {
        >= 75 => "text-success",
        >= 45 => "text-warning",
        _ => "text-danger"
    };

    private sealed record PredictionRow(AssetPrediction Prediction, string MaterielName, string MaterielType);
}
