@code {
    private DashboardStatsDto? DashboardStats;
    private List<DashboardMaterialItemDto>? Inventory;
    private List<MonthlyAssignmentDto>? MonthlyData;

    private List<DashboardMaterialItemDto> TopInventory = [];
    private List<ChartSlice> InventoryByType = [];
    private List<ChartSlice> StockHealthBreakdown = [];
    private List<CategoryBreakdownItem> CategoryBreakdown = [];
    private List<MonthlyTrendPoint> MonthlyTrendPoints = [];

    private bool IsLoading = true;
    private string? ErrorMessage;
    private string CurrentUserRole = "Employee";

    private int HealthyStockCount;
    private int LowStockCount;
    private int CriticalStockCount;
    private int TotalInventoryUnits;
    private int CurrentMonthAssignments;
    private int PeakMonthAssignments;
    private string PeakMonthLabel = "N/A";
    private double AverageMonthlyAssignments;

    private string MaterialsTrendText = "Live inventory status";
    private string MaterialsTrendClass = "positive";
    private string AssignmentsTrendText = "Trend unavailable";
    private string AssignmentsTrendClass = "warning";
    private string CriticalStockTrendText = "No critical stock";
    private string CriticalStockTrendClass = "positive";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            CurrentUserRole = authState.User.FindFirst(ClaimTypes.Role)?.Value ?? "Employee";

            var materialsQuery = await MaterielService.GetMateriels();
            var assignmentsQuery = await AssignmentService.GetAssignments();

            var inventory = materialsQuery
                .Where(m => !m.IsDeleted)
                .Select(m => new DashboardMaterialItemDto
                {
                    Id = m.Id,
                    MaterielName = m.MaterielName ?? "N/A",
                    Type = m.Type ?? "N/A",
                    QuantityITStock = m.QuantityITStock,
                    QuantityPDRStock = m.QuantityPDRStock
                })
                .ToList();

            var assignments = assignmentsQuery
                .Where(a => !a.IsDeleted)
                .OrderBy(a => a.CreatedAt)
                .ToList();

            DashboardStats = new DashboardStatsDto(
                TotalMaterials: inventory.Count,
                TotalAssignments: assignments.Count,
                PendingRequests: assignments.Count(a => a.RestoreDate == null));

            Inventory = inventory;
            TopInventory = inventory
                .OrderByDescending(m => m.Total)
                .Take(6)
                .ToList();

            var now = DateTime.UtcNow;
            var startOfCurrentMonth = new DateTime(now.Year, now.Month, 1);
            var last12Months = Enumerable.Range(0, 12)
                .Select(i => startOfCurrentMonth.AddMonths(-i))
                .OrderBy(d => d)
                .ToList();

            MonthlyData = last12Months
                .Select(month => new MonthlyAssignmentDto
                {
                    Month = month.ToString("MMM"),
                    Value = assignments.Count(a =>
                        a.CreatedAt.Year == month.Year &&
                        a.CreatedAt.Month == month.Month)
                })
                .ToList();

            BuildDashboardShapes();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to load dashboard data: {ex.Message}";
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Dashboard Error",
                Detail = ErrorMessage,
                Duration = 5000
            });
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void BuildDashboardShapes()
    {
        var inventory = Inventory ?? [];
        TotalInventoryUnits = inventory.Sum(i => i.Total);

        InventoryByType = inventory
            .GroupBy(item => string.IsNullOrWhiteSpace(item.Type) ? "Unknown" : item.Type)
            .Select(group => new ChartSlice
            {
                Category = group.Key,
                Value = group.Sum(item => item.Total)
            })
            .OrderByDescending(item => item.Value)
            .ToList();

        HealthyStockCount = inventory.Count(i => string.Equals(i.StatusBadge, "OK", StringComparison.OrdinalIgnoreCase));
        LowStockCount = inventory.Count(i => string.Equals(i.StatusBadge, "LOW", StringComparison.OrdinalIgnoreCase));
        CriticalStockCount = inventory.Count(i => string.Equals(i.StatusBadge, "CRITICAL", StringComparison.OrdinalIgnoreCase));
        StockHealthBreakdown = new List<ChartSlice>
        {
            new ChartSlice { Category = "Healthy", Value = HealthyStockCount },
            new ChartSlice { Category = "Low", Value = LowStockCount },
            new ChartSlice { Category = "Critical", Value = CriticalStockCount }
        }
            .Where(slice => slice.Value > 0)
            .ToList();

        var palette = new[] { "#6366f1", "#22d3ee", "#10b981", "#f59e0b", "#fb7185", "#8b5cf6", "#14b8a6", "#38bdf8" };
        CategoryBreakdown = InventoryByType
            .Take(6)
            .Select((item, index) => new CategoryBreakdownItem
            {
                Category = item.Category,
                Value = item.Value,
                Percentage = TotalInventoryUnits == 0 ? 0 : (item.Value * 100d) / TotalInventoryUnits,
                Color = palette[index % palette.Length]
            })
            .ToList();

        CriticalStockTrendText = CriticalStockCount == 0
            ? "No critical stock"
            : $"{CriticalStockCount} item(s) require replenishment";
        CriticalStockTrendClass = CriticalStockCount == 0 ? "positive" : "danger";

        if (MonthlyData is not { Count: >= 2 })
        {
            AssignmentsTrendText = "Trend unavailable";
            AssignmentsTrendClass = "warning";
            CurrentMonthAssignments = 0;
            PeakMonthAssignments = 0;
            PeakMonthLabel = "N/A";
            AverageMonthlyAssignments = 0;
            MonthlyTrendPoints = [];
            return;
        }

        var latestValue = MonthlyData[^1].Value;
        var previousValue = MonthlyData[^2].Value;
        MonthlyTrendPoints = MonthlyData
            .Select((point, index) => new MonthlyTrendPoint
            {
                Month = point.Month,
                Assignments = point.Value,
                Trend = Math.Round(MonthDataWindowAverage(index), 1)
            })
            .ToList();

        CurrentMonthAssignments = latestValue;
        var peakMonth = MonthlyData.OrderByDescending(item => item.Value).First();
        PeakMonthAssignments = peakMonth.Value;
        PeakMonthLabel = peakMonth.Month;
        AverageMonthlyAssignments = MonthlyData.Average(item => item.Value);

        if (previousValue == 0)
        {
            AssignmentsTrendText = latestValue == 0 ? "No movement this month" : "New monthly activity";
            AssignmentsTrendClass = latestValue == 0 ? "warning" : "positive";
            return;
        }

        var deltaPercent = ((double)(latestValue - previousValue) / previousValue) * 100;
        AssignmentsTrendText = $"{deltaPercent:+0.##;-0.##;0}% vs previous month";
        AssignmentsTrendClass = deltaPercent >= 0 ? "positive" : "danger";
    }

    private double MonthDataWindowAverage(int index)
    {
        if (MonthlyData is null || MonthlyData.Count == 0)
        {
            return 0;
        }

        var start = Math.Max(0, index - 2);
        var window = MonthlyData.Skip(start).Take(index - start + 1);
        return window.Average(point => point.Value);
    }

    private static string GetStatusClass(string statusBadge)
    {
        return statusBadge.ToUpperInvariant() switch
        {
            "OK" => "status-ok",
            "LOW" => "status-low",
            "CRITICAL" => "status-critical",
            _ => "status-neutral"
        };
    }

    private bool IsRole(params string[] roles)
    {
        return roles.Any(role => string.Equals(role, CurrentUserRole, StringComparison.OrdinalIgnoreCase));
    }

    private double GetMaterialShare(DashboardMaterialItemDto material)
    {
        return TotalInventoryUnits == 0 ? 0 : (material.Total * 100d) / TotalInventoryUnits;
    }

    private string GetMaterialShareStyle(DashboardMaterialItemDto material)
    {
        var width = GetMaterialShare(material).ToString("0.#", CultureInfo.InvariantCulture);
        return $"width:{width}%";
    }

    private double GetHealthPercentage(int count)
    {
        var trackedTotal = HealthyStockCount + LowStockCount + CriticalStockCount;
        return trackedTotal == 0 ? 0 : (count * 100d) / trackedTotal;
    }

    private string GetHealthWidthStyle(int count)
    {
        var width = GetHealthPercentage(count).ToString("0.#", CultureInfo.InvariantCulture);
        return $"width:{width}%";
    }

    private sealed class ChartSlice
    {
        public string Category { get; set; } = string.Empty;
        public int Value { get; set; }
    }

    private sealed class CategoryBreakdownItem
    {
        public string Category { get; set; } = string.Empty;
        public int Value { get; set; }
        public double Percentage { get; set; }
        public string Color { get; set; } = "#6366f1";
    }

    private sealed class MonthlyTrendPoint
    {
        public string Month { get; set; } = string.Empty;
        public int Assignments { get; set; }
        public double Trend { get; set; }
    }
}